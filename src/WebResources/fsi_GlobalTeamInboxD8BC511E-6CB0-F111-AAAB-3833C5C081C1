      me = w.UserId;
      return Promise.all([
        G.DV.retrieve("systemusers", me, "?$select=fullname"),
        G.DV.retrieveMultiple("teammemberships", "?$select=teamid&$filter=systemuserid eq " + me)
      ]);
    }).then(function(res){
      myName = (res[0] && res[0].fullname) || "You";
      (res[1] || []).forEach(function(t){ if (t.teamid) myTeamIds[t.teamid.toLowerCase()] = true; });

      /* Only surface the named global coverage/product teams, never access teams. */
      var wanted = {};
      Object.keys(G.TEAM_FOR_TYPE).forEach(function(k){ wanted[G.TEAM_FOR_TYPE[k]] = true; });
      return G.DV.retrieveMultiple("teams", "?$select=teamid,name&$filter=teamtype eq 0")
        .then(function(all){
          myTeams = (all || []).filter(function(t){
            return wanted[t.name] && myTeamIds[String(t.teamid).toLowerCase()];
          });
        })
        .catch(function(){ myTeams = []; });
    });
  }

  function paintWho(){
    var initials = myName.split(/\s+/).map(function(s){ return s[0]; }).slice(0,2).join("").toUpperCase();
    var tnames = myTeams.map(function(t){ return t.name; }).sort();
    var shown = tnames.slice(0, 4).join(" · ");
    if (tnames.length > 4) shown += " +" + (tnames.length - 4) + " more";
    $("#who").innerHTML =
      '<div class="av">' + esc(initials || "?") + '</div>' +
      '<div><div style="font-weight:600">' + esc(myName) + '</div>' +
      '<div class="tm" title="' + esc(tnames.join(", ")) + '">' + (tnames.length
        ? esc(shown)
        : '<span style="opacity:.75">Not a member of any global team</span>') + '</div></div>';
  }

  /* ---------------- data ---------------- */
  function loadRequests(){
    /* Match client-side: a user can belong to many teams, so an OR-filter would blow the URL length. */
    var sel = "?$select=fsi_name,fsi_requesttype,fsi_status,fsi_duedate,fsi_submittedon,fsi_aisummary,"
            + "fsi_requestdescription,fsi_requestingteam,createdon,_createdby_value,"
            + "_fsi_account_value,_fsi_accountplan_value,_fsi_requestedfromuser_value,_fsi_requestedfromteam_value"
            + "&$filter=fsi_status ne 10200"
            + "&$orderby=fsi_duedate asc,createdon desc";
    return G.DV.retrieveMultiple("fsi_informationrequests", sel)
      .then(function(r){
        rows = (r || []).filter(function(x){
          var u = x["_fsi_requestedfromuser_value"], t = x["_fsi_requestedfromteam_value"];
          if (u && String(u).toLowerCase() === String(me).toLowerCase()) return true;
          return !!(t && myTeamIds[String(t).toLowerCase()]);
        });
      })
      .catch(function(){ rows = []; });
  }

  function isOpen(r){ return r.fsi_status === 10201 || r.fsi_status === 10202; }
  function overdue(r){
    var d = G.daysUntil(r.fsi_duedate);
    return d !== null && d < 0 && isOpen(r);
  }

  /* ---------------- KPIs ---------------- */
  function kpis(){
    var awaiting = rows.filter(function(r){ return r.fsi_status === 10201; }).length;
    var prog     = rows.filter(function(r){ return r.fsi_status === 10202; }).length;
    var over     = rows.filter(overdue).length;
    var done     = rows.filter(function(r){ return r.fsi_status === 10203 || r.fsi_status === 10204; }).length;
    var soon     = rows.filter(function(r){
      var d = G.daysUntil(r.fsi_duedate); return d !== null && d >= 0 && d <= 3 && isOpen(r);
    }).length;

    var defs = [
      { l:"Awaiting My Input", v:awaiting, s:awaiting ? "Not yet started" : "Nothing new", c:"var(--brand2)" },
      { l:"In Progress",       v:prog,     s:prog ? "Draft saved" : "None started",       c:"var(--warn)" },
      { l:"Due Soon",          v:soon,     s:"Within 3 days",                              c:"var(--purple)" },
      { l:"Overdue",           v:over,     s:over ? "Needs attention now" : "All on track",
        c: over ? "var(--danger)" : "var(--ok)" },
      { l:"Completed",         v:done,     s:"Submitted by my teams",                      c:"var(--ok)" }
    ];
    $("#kpis").innerHTML = defs.map(function(d){
      return '<div class="kpi" style="--accent:' + d.c + '">' +
        '<div class="k-lbl">' + esc(d.l) + '</div>' +
        '<div class="k-val" style="color:' + d.c + '">' + d.v + '</div>' +
        '<div class="k-sub">' + esc(d.s) + '</div></div>';
    }).join("");
  }

  /* ---------------- type cards ---------------- */
  function types(){
    var map = {};
    rows.forEach(function(r){
      var k = r.fsi_requesttype == null ? 10009 : r.fsi_requesttype;
      if (!map[k]) map[k] = { open:0, prog:0, over:0, done:0, total:0 };
      var m = map[k];
      m.total++;
      if (r.fsi_status === 10201) m.open++;
      if (r.fsi_status === 10202) m.prog++;
      if (overdue(r)) m.over++;
      if (r.fsi_status === 10203 || r.fsi_status === 10204) m.done++;
    });

    var keys = Object.keys(map).sort(function(a,b){
      var A = map[a], B = map[b];
      return (B.open + B.prog) - (A.open + A.prog) || B.total - A.total;
    });

    if (!keys.length){
      $("#types").innerHTML = '<div class="empty" style="grid-column:1/-1">' +
        '<div class="e-ico">' + G.icon("inbox", 40, 1.4) + '</div>' +
        '<div class="e-t">No requests assigned to you</div>' +
        '<div class="e-s">When an account plan owner asks your team for input, it will appear here.</div></div>';
      return;
    }

    var h = '<div class="typecard' + (typeFilter === "all" ? " on" : "") + '" data-t="all" style="--accent:#0b2d4d">' +
      '<div class="tc-h"><div class="tc-i">' + G.icon("inbox", 16) + '</div>' +
      '<div class="tc-n">All Requests</div></div>' +
      '<div class="tc-v">' + rows.filter(isOpen).length + '</div>' +
      '<div class="tc-s"><span class="pip">open of <b>' + rows.length + '</b> total</span></div></div>';

    keys.forEach(function(k){
      var m = map[k], ic = TYPE_ICON[k] || ["target","#5a6b7c"];
      var openCount = m.open + m.prog;
      h += '<div class="typecard' + (typeFilter === k ? " on" : "") + '" data-t="' + k + '" style="--accent:' + ic[1] + '">' +
        '<div class="tc-h"><div class="tc-i">' + G.icon(ic[0], 16) + '</div>' +
        '<div class="tc-n">' + esc(G.CATEGORY[k] || "Other") + '</div></div>' +
        '<div class="tc-v">' + openCount + '</div>' +
        '<div class="tc-s">' +
          (m.over ? '<span class="pip urgent">' + m.over + ' overdue</span>' : '') +
          (m.prog ? '<span class="pip"><b>' + m.prog + '</b> in progress</span>' : '') +
          (m.done ? '<span class="pip"><b>' + m.done + '</b> done</span>' : '') +
          (!m.over && !m.prog && !m.done ? '<span class="pip">awaiting input</span>' : '') +
        '</div></div>';
    });

    $("#types").innerHTML = h;
    G.$$("#types .typecard").forEach(function(c){
      c.addEventListener("click", function(){
        var v = c.getAttribute("data-t");
        typeFilter = (typeFilter === v && v !== "all") ? "all" : v;
        types(); filters(); grid();
      });
    });
  }

  /* ---------------- status chips ---------------- */
  function filters(){
    var base = typeFilter === "all" ? rows : rows.filter(function(r){
      return String(r.fsi_requesttype == null ? 10009 : r.fsi_requesttype) === String(typeFilter);
    });
    var defs = [
      ["open",  "Needs my input", base.filter(isOpen).length],
      ["10201", "New",            base.filter(function(r){ return r.fsi_status === 10201; }).length],
      ["10202", "In Progress",    base.filter(function(r){ return r.fsi_status === 10202; }).length],
      ["10203", "Submitted",      base.filter(function(r){ return r.fsi_status === 10203; }).length],
      ["10204", "Closed",         base.filter(function(r){ return r.fsi_status === 10204; }).length],
      ["all",   "All",            base.length]
    ];
    $("#filters").innerHTML = defs.map(function(d){
      if (!d[2] && d[0] !== "open" && d[0] !== "all") return "";
      return '<span class="chip' + (statusFilter === d[0] ? " on" : "") + '" data-f="' + d[0] + '">' +
        esc(d[1]) + ' <b style="opacity:.7">' + d[2] + '</b></span>';
    }).join("");
    G.$$("#filters .chip").forEach(function(c){
      c.addEventListener("click", function(){ statusFilter = c.getAttribute("data-f"); filters(); grid(); });
    });
    $("#listTitle").textContent = typeFilter === "all"
      ? "My queue" : (G.CATEGORY[typeFilter] || "Other") + " requests";
  }

  /* ---------------- list ---------------- */
  function visible(){
    var list = typeFilter === "all" ? rows.slice() : rows.filter(function(r){
      return String(r.fsi_requesttype == null ? 10009 : r.fsi_requesttype) === String(typeFilter);
    });
    if (statusFilter === "open") list = list.filter(isOpen);
    else if (statusFilter !== "all") list = list.filter(function(r){ return String(r.fsi_status) === statusFilter; });
    return list.sort(function(a,b){
      var ao = overdue(a) ? 0 : 1, bo = overdue(b) ? 0 : 1;
      if (ao !== bo) return ao - bo;
      var ad = a.fsi_duedate || "9999", bd = b.fsi_duedate || "9999";
      return ad < bd ? -1 : ad > bd ? 1 : 0;
    });
  }

  function grid(){
    var list = visible();
    if (!list.length){
      $("#gridHost").innerHTML = '<div class="empty"><div class="e-ico">' + G.icon("check", 40, 1.4) + '</div>' +
        '<div class="e-t">' + (rows.length ? "Nothing in this view" : "Your queue is clear") + '</div>' +
        '<div class="e-s">' + (rows.length
          ? "Try a different filter or select <b>All Requests</b>."
          : "You have no outstanding information requests.") + '</div></div>';
      return;
    }
    var h = '<table class="tbl"><thead><tr>' +
      '<th style="min-width:260px">Request</th><th>Type</th><th>Requested By</th>' +
      '<th>Status</th><th>Due</th><th style="width:120px"></th>' +
      '</tr></thead><tbody>';

    list.forEach(function(r){
      var acct = r["_fsi_account_value@OData.Community.Display.V1.FormattedValue"] || "";
      var plan = r["_fsi_accountplan_value@OData.Community.Display.V1.FormattedValue"] || "";
      var by   = r["_createdby_value@OData.Community.Display.V1.FormattedValue"]
              || r["createdby@OData.Community.Display.V1.FormattedValue"] || "—";
      var team = r["_fsi_requestedfromteam_value@OData.Community.Display.V1.FormattedValue"];
      var d    = G.daysUntil(r.fsi_duedate);
      var due  = r.fsi_duedate ? G.fmtDate(r.fsi_duedate) : '<span class="muted">No due date</span>';
      if (r.fsi_duedate && isOpen(r)){
        if (d < 0)       due = '<span class="badge b-over"><span class="bdot"></span>' + G.fmtDate(r.fsi_duedate) + ' · ' + Math.abs(d) + 'd late</span>';
        else if (d <= 3) due = '<span class="badge b-prog"><span class="bdot"></span>' + G.fmtDate(r.fsi_duedate) + ' · ' + d + 'd left</span>';
      }
      var cta = isOpen(r)
        ? '<button class="btn btn-sm btn-primary" data-open="' + r.fsi_informationrequestid + '">' +
            (r.fsi_status === 10202 ? "Continue" : "Provide input") + '</button>'
        : '<button class="btn btn-sm" data-open="' + r.fsi_informationrequestid + '">View</button>';

      h += '<tr data-id="' + r.fsi_informationrequestid + '">' +
        '<td><span class="t-title">' + esc(r.fsi_name || "(untitled)") + '</span>' +
          (r.fsi_aisummary ? ' <span class="badge b-soft" style="margin-left:6px">AI Summary</span>' : '') +
          '<div class="t-acct">' + esc(acct || "—") + (plan ? ' · ' + esc(plan) : '') + '</div></td>' +
        '<td>' + esc(G.CATEGORY[r.fsi_requesttype] || "—") +
          (team ? '<div class="t-acct">' + esc(team) + '</div>' : '') + '</td>' +
        '<td>' + esc(by) + (r.fsi_requestingteam ? '<div class="t-acct">' + esc(r.fsi_requestingteam) + '</div>' : '') + '</td>' +
        '<td>' + G.statusBadge(r.fsi_status) + '</td>' +
        '<td>' + due + '</td>' +
        '<td style="text-align:right">' + cta + '</td></tr>';
    });
    h += "</tbody></table>";
    $("#gridHost").innerHTML = h;

    G.$$("#gridHost [data-open]").forEach(function(b){
      b.addEventListener("click", function(ev){
        ev.stopPropagation();
        G.openRequest(b.getAttribute("data-open"));
      });
    });
    G.$$("#gridHost tbody tr").forEach(function(tr){
      tr.addEventListener("click", function(){ G.openRequest(tr.getAttribute("data-id")); });
    });
  }

  /* ---------------- boot ---------------- */
  function refresh(){
    return loadRequests().then(function(){ kpis(); types(); filters(); grid(); });
  }

  function boot(){
    $("#btnRefresh").addEventListener("click", function(){
      G.toast("Refreshing…"); refresh();
    });
    whoAmI()
      .then(function(){ paintWho(); return refresh(); })
      .catch(function(e){
        $("#gridHost").innerHTML = '<div class="empty"><div class="e-t">Could not load your requests</div>' +
          '<div class="e-s">' + esc(e && e.message ? e.message : String(e)) + '</div></div>';
      });
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
  else boot();
})();
</script>
</body>
</html>
