          <div class="section">
            <div class="section-label">FAB Persona</div>
            <div class="form-grid">
              <div class="form-field">
                <label>Name</label>
                <input id="cv_name" value="${escapeHtml(item.name || '')}" readonly placeholder="Select a Dynamics user" aria-label="Select FAB user" style="cursor:pointer" />
              </div>
              <div class="form-field">
                <label>Role</label>
                <input id="cv_role" value="${escapeHtml(item.role || '')}" />
              </div>
              <div class="form-field">
                <label>Team</label>
                <input id="cv_team" value="${escapeHtml(item.team || '')}" />
              </div>
              <div class="form-field">
                <label>Coverage Type</label>
                <select id="cv_type">
                  <option value="primary" ${item.type==='primary'?'selected':''}>Primary</option>
                  <option value="secondary" ${item.type==='secondary'?'selected':''}>Secondary</option>
                </select>
              </div>
              <div class="form-field">
                <label>Source Type</label>
                <select id="cv_sourceType">
                  <option value="facility" ${item.sourceType==='facility'?'selected':''}>Facility</option>
                  <option value="opportunity" ${item.sourceType==='opportunity'?'selected':''}>Opportunity</option>
                  <option value="exec" ${item.sourceType==='exec'?'selected':''}>Executive</option>
                  <option value="trade" ${item.sourceType==='trade'?'selected':''}>Trade</option>
                  <option value="treasury" ${item.sourceType==='treasury'?'selected':''}>Treasury</option>
                  <option value="prior" ${item.sourceType==='prior'?'selected':''}>Prior Relationship</option>
                </select>
              </div>
              <div class="form-field">
                <label>Source Label</label>
                <input id="cv_sourceLabel" value="${escapeHtml(item.sourceLabel || '')}" />
              </div>
              <div class="form-field">
                <label>Relationship Strength</label>
                <select id="cv_strength">
                  <option value="strong" ${item.relationshipStrength==='strong'?'selected':''}>Strong</option>
                  <option value="medium" ${item.relationshipStrength==='medium'?'selected':''}>Medium</option>
                  <option value="weak" ${item.relationshipStrength==='weak'?'selected':''}>Weak</option>
                </select>
              </div>
              <div class="form-field full">
                <label>Coverage Basis</label>
                <textarea id="cv_basis">${escapeHtml(item.basis || '')}</textarea>
              </div>
              <div class="form-field full">
                <label>Last Touch</label>
                <textarea id="cv_lastTouch">${escapeHtml(item.lastTouch || '')}</textarea>
              </div>
              <div class="form-field full">
                <label>Next Step</label>
                <textarea id="cv_nextStep">${escapeHtml(item.nextStep || '')}</textarea>
              </div>
              <div class="form-field full">
                <label>Additional Notes</label>
                <textarea id="cv_notes">${escapeHtml(item.personNotes || '')}</textarea>
              </div>
            </div>
          </div>

          <div class="section">
            <div class="modal-footer">
              <div class="small-muted">Saved as a contact-to-user assignment in Dataverse.</div>
              <div class="sub-actions">
                <button class="btn" type="button" id="editorCancelCoverage">Cancel</button>
                <button class="btn primary" type="button" id="editorSaveCoverage">${isNew ? 'Add Persona' : 'Save Persona'}</button>
              </div>
            </div>
          </div>
        `);


        $('cv_name').addEventListener('click', async () => {
          if(saving || !api) return;
          const nameInput=$('cv_name'), expected=version;
          try{
            const user=await api.selectUser();
            if(!user || expected !== version || !nameInput.isConnected) return;
            item.userId=user.systemuserid; item.name=user.fullname; nameInput.value=user.fullname;
            if(!$('cv_role').value) $('cv_role').value=user.jobtitle || '';
          }catch(error){if(expected === version)showError(error.message);}
        });
        $('cv_name').addEventListener('keydown', event => {
          if(event.key==='Enter' || event.key===' '){event.preventDefault();$('cv_name').click();}
        });
        $('editorCancelCoverage').addEventListener('click', closeFlyouts);

        $('editorSaveCoverage').addEventListener('click', event => {
          const next={
            userId:item.userId, name:$('cv_name').value.trim(), role:$('cv_role').value.trim(),
            team:$('cv_team').value.trim(), type:$('cv_type').value, sourceType:$('cv_sourceType').value,
            sourceLabel:$('cv_sourceLabel').value.trim(), relationshipStrength:$('cv_strength').value,
            basis:$('cv_basis').value.trim(), lastTouch:$('cv_lastTouch').value.trim(),
            nextStep:$('cv_nextStep').value.trim(), personNotes:$('cv_notes').value.trim()
          };
          if(!next.userId){showError('Select a Dynamics user from the Name field.');return;}
          persist(event.currentTarget,()=>api.saveCoverage(stakeholderId,next,coverageId),
            isNew?'FAB persona saved to Dataverse':'FAB persona updated in Dataverse');
        });
      }

      function normalizeCoverageTypes(stakeholder){
        if(!stakeholder || !Array.isArray(stakeholder.coverage)) return;
        stakeholder.coverage = stakeholder.coverage.slice(0,2);

        const primaryIndex = stakeholder.coverage.findIndex(c => c.type === 'primary');
        if(primaryIndex === -1 && stakeholder.coverage[0]){
          stakeholder.coverage[0].type = 'primary';
          if(stakeholder.coverage[1]) stakeholder.coverage[1].type = 'secondary';
          return;
        }

        stakeholder.coverage.forEach((c, i) => {
          c.type = i === primaryIndex ? 'primary' : 'secondary';
        });

        stakeholder.coverage.sort((a,b) => a.type === 'primary' ? -1 : b.type === 'primary' ? 1 : 0);
      }

      function deleteCoverage(stakeholderId, coverageId){
        const s = findStakeholder(stakeholderId);
        if(!s) return;
        const item = findCoverage(stakeholderId, coverageId);
        if(!item) return;

        if(!confirm(`Delete FAB persona "${item.name}"?`)) return;


        persist(null,()=>api.deleteCoverage(stakeholderId,coverageId),'FAB coverage assignment deleted');
      }

      function exportJson(){
        const blob = new Blob([JSON.stringify(state, null, 2)], {type:'application/json'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'fab_stakeholder_coverage_map.json';
        a.click();
        URL.revokeObjectURL(url);
      }

      function bindGlobal(){
        $('sessionId').textContent = getSessionId();

        $('backdrop').addEventListener('click', closeFlyouts);
        $('closeStakeholder').addEventListener('click', closeFlyouts);
        $('closeCoverage').addEventListener('click', closeFlyouts);
        $('closeEditor').addEventListener('click', closeFlyouts);


        $('btnReset').addEventListener('click', () => {
          if(saving || !api) return;
          if(!confirm('Reload saved Dataverse data and discard unsaved editor changes?')) return;
          load();
        });

        $('btnExport').addEventListener('click', exportJson);

        window.addEventListener('resize', drawConnectors);

        document.addEventListener('keydown', (e) => {
          if(e.key === 'Escape'){
            closeFlyouts();
          }
        });
      }

      window.__fabEditStakeholder = openStakeholderEditor;
      window.__fabEditCoverage = openCoverageEditor;
      window.__fabDeleteCoverage = deleteCoverage;

      bindGlobal();
      renderChart();

      function preparePrint(){
        document.getElementById('stakeholderPrintSurface')?.remove();
        if(!state.stakeholders.length) return;
        const surface=document.createElement('div');
        surface.id='stakeholderPrintSurface';
        surface.setAttribute('aria-hidden','true');
        surface.appendChild($('chartWrap').cloneNode(true));
        const maxColumns=Math.max(...buildLevels().map(level=>level.length));
        surface.style.width=(maxColumns*320+Math.max(0,maxColumns-1)*34+48)+'px';
        document.body.appendChild(surface);
        surface.querySelectorAll('.stakeholder-card').forEach(card=>{
          const stakeholder=state.stakeholders.find(s=>s.id===card.dataset.stakeholderId);
          const names=document.createElement('div');
          names.className='print-coverage';
          names.textContent=(stakeholder.coverage || []).map(c=>c.name+' - '+c.role).join('; ');
          card.appendChild(names);
        });
        drawScopedConnectors(surface);
        const width=surface.scrollWidth, height=surface.scrollHeight;
        surface.style.setProperty('--print-scale',Math.min(1,1040/width,680/height));
      }
      $('btnPrint').addEventListener('click',()=>window.print());
      window.addEventListener('beforeprint',preparePrint);
      window.addEventListener('afterprint',()=>document.getElementById('stakeholderPrintSurface')?.remove());
      setStatus('Connecting to Account Plan...');

    })();
  </script>
</body>
</html>