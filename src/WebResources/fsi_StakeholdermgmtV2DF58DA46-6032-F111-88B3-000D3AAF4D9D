      function influenceDots(n){
        let html = '<div class="influence">';
        for(let i=1;i<=5;i++) html += '<span class="'+(i<=Number(n||0)?'on':'')+'"></span>';
        html += '</div>';
        return html;
      }

      function buildLevels(){
        const roots = state.stakeholders.filter(s => !s.parentId);
        const levels = [];
        let current = roots.slice();
        const seen = new Set();
        while(current.length){
          levels.push(current);
          const next = [];
          current.forEach(item => {
            if(seen.has(item.id)) return;
            seen.add(item.id);
            childrenOf(item.id).forEach(ch => next.push(ch));
          });
          current = next;
        }
        return levels;
      }

