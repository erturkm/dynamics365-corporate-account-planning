      function sentimentBadge(tag){
        const cls = tag === 'supporter' ? 'supporter' : tag === 'detractor' ? 'detractor' : 'neutral';
        const text = tag === 'supporter' ? 'Supporter' : tag === 'detractor' ? 'Detractor' : tag === 'neutral' ? 'Neutral' : 'Not assessed';
        return '<span class="sentiment-badge '+cls+'">'+text+'</span>';
