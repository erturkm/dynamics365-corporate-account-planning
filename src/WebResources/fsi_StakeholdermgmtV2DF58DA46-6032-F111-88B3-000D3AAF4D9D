<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FAB Stakeholder Coverage Map</title>
  <style>
    :root{
      --bg:#f8fafc;
      --card:#ffffff;
      --line:#e5e7eb;
      --muted:#64748b;
      --text:#0f172a;
      --blue:#2563eb;
      --blue-soft:#eff6ff;
      --green:#16a34a;
      --green-soft:#f0fdf4;
      --amber:#d97706;
      --amber-soft:#fffbeb;
      --red:#dc2626;
      --red-soft:#fef2f2;
      --shadow:0 14px 34px rgba(15,23,42,.08);
      --shadow-soft:0 8px 18px rgba(15,23,42,.06);
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family:"Segoe UI", Arial, sans-serif;
      background:linear-gradient(180deg,#f8fafc 0%,#ffffff 100%);
      color:var(--text);
    }

    .page{
      height:100vh;
      display:flex;
      flex-direction:column;
      overflow:hidden;
    }

    .topbar{
      flex:0 0 auto;
      display:flex;
      justify-content:space-between;
      gap:16px;
      align-items:flex-start;
      flex-wrap:wrap;
      padding:14px 18px 10px;
      border-bottom:1px solid #eef2f7;
      background:#fff;
    }

    .title-wrap{min-width:280px}
    .eyebrow{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:900;color:var(--text)}
    .eyebrow-dot{width:10px;height:10px;border-radius:999px;background:var(--blue)}
    .subtitle{margin-top:6px;font-size:12px;color:var(--muted);line-height:1.45}

    .actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:flex-end}
    .pill,.btn{
      border:1px solid var(--line);
      background:#fff;
      border-radius:14px;
      padding:10px 12px;
      box-shadow:var(--shadow-soft);
      font-size:12px;
      font-weight:800;
    }
    .pill span:last-child{font-weight:900;color:var(--text);margin-left:8px}
    .btn{cursor:pointer;transition:.15s ease}
    .btn:hover{transform:translateY(-1px)}
    .btn.primary{background:var(--blue-soft);border-color:#dbeafe;color:#1d4ed8}
    .btn.danger{background:#fff1f2;border-color:#fecdd3;color:#b91c1c}

    .panel{
      flex:1 1 auto;
      background:var(--card);
      overflow:auto;
      position:relative;
    }

    .panel-head{
      position:sticky;
      top:0;
      z-index:10;
      padding:14px 16px;
      border-bottom:1px solid #eef2f7;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
      background:rgba(255,255,255,.92);
      backdrop-filter: blur(8px);
    }

    .panel-title{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:900}
    .status{font-size:12px;color:var(--muted)}
    .legend{display:flex;gap:8px;flex-wrap:wrap}
    .legend-chip{
      display:inline-flex;align-items:center;gap:6px;
      border-radius:999px;padding:6px 10px;font-size:11px;font-weight:800;
      border:1px solid var(--line);background:#fff;
    }
    .legend-dot{width:8px;height:8px;border-radius:999px}

    .chart-area{
      padding:18px 18px 40px;
      min-height:calc(100vh - 88px);
    }

    #chartWrap{
      position:relative;
      min-height:100%;
      padding-right:260px;
    }

    #linesSvg{
      position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible
    }

    #levels{
      position:relative;
      display:flex;
      flex-direction:column;
      gap:34px;
      padding-bottom:80px;
    }

    .level-row{
      display:flex;
      justify-content:center;
      gap:34px;
      align-items:flex-start;
      flex-wrap:nowrap;
      position:relative;
    }

    .stakeholder-card-wrap{position:relative;width:320px;min-width:320px}
    .stakeholder-card{
      border:1px solid var(--line);
      border-radius:28px;
      background:#fff;
      box-shadow:var(--shadow);
      padding:16px 18px 16px;
      cursor:pointer;
      position:relative;
      transition:.16s ease;
      min-height:250px;
    }
    .stakeholder-card:hover{transform:translateY(-2px)}
    .stakeholder-card.selected{outline:2px dashed var(--blue);outline-offset:2px}
    .stakeholder-card.health-strong{box-shadow:0 0 0 1px rgba(22,163,74,.12), 0 16px 34px rgba(22,163,74,.08)}
    .stakeholder-card.health-medium{box-shadow:0 0 0 1px rgba(217,119,6,.12), 0 16px 34px rgba(217,119,6,.08)}
    .stakeholder-card.health-weak{box-shadow:0 0 0 1px rgba(220,38,38,.12), 0 16px 34px rgba(220,38,38,.08)}

    .top-badges{
      display:flex;
      justify-content:space-between;
      gap:8px;
      align-items:flex-start;
    }

    .left-badges{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
    .right-actions{display:flex;gap:8px;align-items:center}

    .sentiment-badge,.health-badge{
      display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:11px;font-weight:900;border:1px solid
    }
    .supporter{background:var(--green-soft);color:#166534;border-color:#dcfce7}
    .neutral{background:#f8fafc;color:#334155;border-color:#e2e8f0}
    .detractor{background:#fff1f2;color:#991b1b;border-color:#fee2e2}
    .health-strong-b{background:var(--green-soft);color:#166534;border-color:#dcfce7}
    .health-medium-b{background:var(--amber-soft);color:#92400e;border-color:#fde68a}
    .health-weak-b{background:var(--red-soft);color:#991b1b;border-color:#fee2e2}

    .icon-btn{
      border:1px solid #e5e7eb;
      background:#fff;
      color:#475569;
      border-radius:12px;
      padding:7px 9px;
      font-size:12px;
      font-weight:900;
      cursor:pointer;
      box-shadow:var(--shadow-soft);
    }

    .stakeholder-main{
      display:flex;gap:12px;margin-top:14px;align-items:center;padding-right:28px
    }
    .avatar{
      width:54px;height:54px;border-radius:999px;background:#e2e8f0;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;flex:0 0 auto
    }
    .stakeholder-name{font-size:15px;font-weight:900;line-height:1.2}
    .stakeholder-title{font-size:12px;color:var(--muted);margin-top:4px;line-height:1.35}

    .influence{display:flex;gap:5px;margin-top:12px}
    .influence span{width:8px;height:8px;border-radius:999px;border:1px solid #cbd5e1;background:#fff}
    .influence span.on{background:var(--blue);border-color:var(--blue)}

    .stakeholder-notes{
      margin-top:14px;
      font-size:12px;
      line-height:1.5;
      color:#475569;
      background:#fafcff;
      border:1px solid #eef2f7;
      border-radius:14px;
      padding:10px 12px;
      min-height:62px;
    }

    .fab-rail-label{
      margin-top:18px;
      padding-top:12px;
      border-top:1px solid #eef2f7;
      font-size:11px;
      font-weight:900;
      letter-spacing:.04em;
      text-transform:uppercase;
      color:#475569;
      display:flex;
      justify-content:space-between;
      align-items:center
    }
    .fab-rail-hint{font-size:11px;color:var(--muted);font-weight:800}

    .fab-rail{
      position:absolute;
      right:-34px;
      top:70px;
      display:flex;
      flex-direction:column;
      gap:10px;
      z-index:3
    }

    .fab-pill{
      position:relative;
      width:56px;height:56px;
      border-radius:999px;
      border:1px solid #cbd5e1;
      background:#fff;
      box-shadow:0 10px 20px rgba(15,23,42,.10);
      display:flex;
      align-items:center;
      justify-content:center;
      cursor:pointer;
      transition:.16s ease
    }
    .fab-pill:hover{transform:translateX(2px)}
    .fab-pill.active{border-color:#93c5fd;background:#eff6ff;box-shadow:0 12px 24px rgba(37,99,235,.18)}
    .fab-pill-empty{border-style:dashed;color:#94a3b8;background:#f8fafc}
    .fab-pill-avatar{
      width:40px;height:40px;border-radius:999px;background:#dbeafe;color:#1e3a8a;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:13px;position:relative
    }
    .fab-pill.secondary .fab-pill-avatar{background:#ede9fe;color:#5b21b6}
    .fab-pill-icon{
      position:absolute;right:-1px;bottom:-1px;width:16px;height:16px;border-radius:999px;background:#fff;border:1px solid #dbeafe;display:flex;align-items:center;justify-content:center;font-size:10px;line-height:1
    }

    .coverage-drawer{
      position:absolute;
      top:58px;
      left:calc(100% + 14px);
      width:250px;
      background:#fff;
      border:1px solid #dbeafe;
      border-radius:22px;
      box-shadow:0 20px 40px rgba(15,23,42,.14);
      padding:12px;
      opacity:0;
      pointer-events:none;
      transform:translateX(-12px) scale(.98);
      transition:.18s ease;
      z-index:5
    }
    .coverage-drawer.open{opacity:1;pointer-events:auto;transform:translateX(0) scale(1)}
    .coverage-drawer::before{
      content:"";
      position:absolute;
      left:-8px;
      top:30px;
      width:16px;height:16px;
      background:#fff;
      border-left:1px solid #dbeafe;
      border-bottom:1px solid #dbeafe;
      transform:rotate(45deg)
    }

    .drawer-top{display:flex;gap:10px;align-items:center}
    .drawer-avatar{
      width:46px;height:46px;border-radius:999px;background:#dbeafe;color:#1e3a8a;display:flex;align-items:center;justify-content:center;font-weight:900
    }
    .drawer-avatar.secondary{background:#ede9fe;color:#5b21b6}
    .drawer-name{font-size:13px;font-weight:900;line-height:1.2}
    .drawer-role{font-size:11px;color:var(--muted);margin-top:3px;line-height:1.3}
    .drawer-meta{margin-top:10px;display:grid;gap:8px}
    .mini-field{padding:9px 10px;border:1px solid #eef2f7;border-radius:12px;background:#fafcff}
    .mini-field .k{font-size:10px;color:var(--muted);font-weight:900;text-transform:uppercase;letter-spacing:.04em}
    .mini-field .v{font-size:12px;font-weight:800;margin-top:4px;line-height:1.35;color:var(--text)}
    .drawer-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
    .drawer-btn{
      border:1px solid #dbeafe;background:#eff6ff;color:#1d4ed8;border-radius:12px;padding:9px 10px;font-size:12px;font-weight:900;cursor:pointer
    }
    .drawer-btn.secondary{
      border:1px solid #e5e7eb;background:#fff;color:#334155;
    }
    .drawer-btn.danger{
      border:1px solid #fecdd3;background:#fff1f2;color:#b91c1c;
    }

    .source-badge{
      display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:999px;font-size:10px;font-weight:900;border:1px solid;white-space:nowrap
    }
    .src-facility{background:#eff6ff;border-color:#bfdbfe;color:#1d4ed8}
    .src-opportunity{background:#eefcf4;border-color:#bbf7d0;color:#166534}
    .src-exec{background:#fff7ed;border-color:#fed7aa;color:#9a3412}
    .src-trade{background:#f5f3ff;border-color:#ddd6fe;color:#6d28d9}
    .src-treasury{background:#fefce8;border-color:#fde68a;color:#854d0e}
    .src-prior{background:#f8fafc;border-color:#e2e8f0;color:#475569}

    #backdrop{
      position:fixed;inset:0;background:rgba(15,23,42,.42);backdrop-filter:blur(2px);display:none;z-index:9998
    }

    #stakeholderFlyout,#coverageFlyout,#editorModal{
      position:fixed;
      top:0;right:0;
      height:100vh;
      width:min(500px,95vw);
      background:#fff;
      border-left:1px solid var(--line);
      box-shadow:-18px 0 42px rgba(15,23,42,.18);
      transform:translateX(110%);
      transition:transform .22s ease;
      z-index:10000;
      display:flex;
      flex-direction:column
    }

    #editorModal{
      width:min(620px,96vw);
      z-index:10001;
    }

    .flyout-head{
      padding:14px 16px;border-bottom:1px solid #eef2f7;display:flex;justify-content:space-between;align-items:center;gap:10px
    }
    .flyout-title{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:900}
    .close-btn{
      width:32px;height:32px;border-radius:10px;border:1px solid var(--line);background:#fff;cursor:pointer;font-size:18px;font-weight:900;color:#64748b
    }
    .flyout-body{
      padding:16px;overflow:auto;display:flex;flex-direction:column;gap:14px
    }

    .section{
      border:1px solid #eef2f7;border-radius:16px;background:#fff;padding:14px;box-shadow:var(--shadow-soft)
    }
    .section-label{
      font-size:11px;font-weight:900;color:#64748b;text-transform:uppercase;letter-spacing:.04em;margin-bottom:10px
    }
    .detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .field{padding:10px;border:1px solid #eef2f7;border-radius:12px;background:#fafcff}
    .field .k{font-size:11px;color:var(--muted);font-weight:800}
    .field .v{font-size:12px;font-weight:900;color:var(--text);margin-top:4px;line-height:1.35}
    .narrative{font-size:12px;color:#334155;line-height:1.6}

    .person-hero{display:flex;gap:12px;align-items:center}
    .person-hero .hero-avatar{
      width:56px;height:56px;border-radius:999px;background:#dbeafe;color:#1e3a8a;display:flex;align-items:center;justify-content:center;font-weight:900
    }
    .person-hero .hero-name{font-size:15px;font-weight:900}
    .person-hero .hero-role{font-size:12px;color:var(--muted);margin-top:4px}

    .assignment-card{
      border:1px solid #e5e7eb;border-radius:14px;background:#fbfdff;padding:12px
    }
    .assignment-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
    .assignment-name{font-size:12px;font-weight:900}
    .assignment-role{font-size:11px;color:var(--muted);margin-top:3px}

    .form-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:12px;
    }
    .form-field{
      display:flex;
      flex-direction:column;
      gap:6px;
    }
    .form-field.full{grid-column:1 / -1}
    .form-field label{
      font-size:12px;
      font-weight:900;
      color:#475569;
    }
    .form-field input,.form-field select,.form-field textarea{
      width:100%;
      border:1px solid #dbe2ea;
      border-radius:12px;
      padding:10px 12px;
      font-size:12px;
      font-family:inherit;
      background:#fff;
      color:#0f172a;
      outline:none;
    }
    .form-field textarea{
      resize:vertical;
      min-height:90px;
    }

    .modal-footer{
      display:flex;
      justify-content:space-between;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
    }

    .small-muted{font-size:12px;color:#64748b}
    .sub-actions{display:flex;gap:8px;flex-wrap:wrap}

    @media (max-width:1200px){
      #chartWrap{padding-right:290px}
      .stakeholder-card-wrap{width:300px;min-width:300px}
      .coverage-drawer{width:230px}
    }
    @media (max-width:760px){
      .topbar{padding:12px}
      .panel-head{padding:12px}
      .chart-area{padding:14px}
      .stakeholder-card-wrap{width:280px;min-width:280px}
      .level-row{gap:24px}
      .fab-rail{right:-28px}
      .coverage-drawer{left:calc(100% + 8px);width:210px}
      .form-grid,.detail-grid{grid-template-columns:1fr}
    }
  </style>
<style id="stakeholder-print-styles">
  #btnPrint{position:fixed;top:12px;right:18px;z-index:20}
  #btnNewStakeholder{position:fixed;top:12px;right:146px;z-index:20}
  .stakeholder-add-zone{position:absolute;top:calc(100% - 3px);left:calc(50% - 32px);width:64px;height:34px;z-index:3;display:flex;justify-content:center;align-items:center}
  .stakeholder-add-btn{width:26px;height:26px;display:flex;align-items:center;justify-content:center;padding:0;border:1px solid var(--blue);border-radius:50%;background:var(--card);color:var(--blue);font-family:inherit;font-size:20px;line-height:1;cursor:pointer;opacity:0;transition:opacity .12s ease}
  .stakeholder-add-zone:hover .stakeholder-add-btn,.stakeholder-add-zone:focus-within .stakeholder-add-btn{opacity:1}
  .stakeholder-add-btn:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
  @media(hover:none){.stakeholder-add-btn{opacity:1}}
  #btnCollapseHeader{position:fixed;top:12px;right:100px;z-index:20;width:36px;height:36px;padding:8px;display:flex;align-items:center;justify-content:center}
  #btnCollapseHeader svg{width:16px;height:16px;transition:transform .15s ease}
  #btnCollapseHeader[aria-expanded="false"] svg{transform:rotate(180deg)}
  #stakeholderFlyout,#coverageFlyout{width:min(560px,95vw)}
  .flyout-head{padding:8px 12px}
  .flyout-body{padding:10px 12px;gap:8px;min-height:0}
  .section{padding:10px;border-radius:12px;box-shadow:none}
  .section-label{margin-bottom:6px;font-size:10px}
  .detail-grid{gap:6px}
  #stakeholderBody .detail-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
  .field{padding:7px 8px;border-radius:8px}
  .field .k{font-size:10px}
  .field .v{margin-top:3px}
  .narrative{line-height:1.4}
  .person-hero{gap:10px}
  .person-hero .hero-avatar{width:40px;height:40px;flex:0 0 40px}
  .person-hero .hero-name{font-size:14px}
  .person-hero .hero-role{margin-top:2px}
  .assignment-card{padding:8px 10px;border-radius:8px;margin-bottom:6px!important}
  #stakeholderBody .section:last-child>div:last-child,
  #coverageBody .section:last-child>div:last-child{margin-top:8px!important}
  .flyout-body .btn{padding:8px 10px}
  .form-grid{gap:8px}
  .form-field{gap:4px}
  .form-field input,.form-field select,.form-field textarea{padding:8px 10px;border-radius:8px}
  .form-field textarea{min-height:64px}
  @media(max-width:520px){
    #stakeholderBody .detail-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  #stakeholderPrintSurface{position:fixed;left:-100000px;top:0;background:var(--card);pointer-events:none}
  #stakeholderPrintSurface #chartWrap{padding-right:48px;min-height:0}
  #stakeholderPrintSurface #levels{padding-bottom:0}
  #stakeholderPrintSurface .stakeholder-card-wrap{width:320px;min-width:320px}
  #stakeholderPrintSurface .right-actions,
  #stakeholderPrintSurface .stakeholder-add-zone,
  #stakeholderPrintSurface .fab-pill-empty,
  #stakeholderPrintSurface .coverage-drawer{display:none}
  #stakeholderPrintSurface .stakeholder-card{box-shadow:none;outline:none}
  #stakeholderPrintSurface .print-coverage{font-size:11px;color:var(--muted);margin-top:8px}
  @page{size:A4 landscape;margin:10mm}
  @media print{
    html,body{height:auto!important;overflow:visible!important;background:var(--card)!important}
    body>.page,#btnPrint,#btnNewStakeholder,#btnCollapseHeader,#backdrop,#stakeholderFlyout,#coverageFlyout,#editorModal{display:none!important}
    #stakeholderPrintSurface{position:static;left:auto;zoom:var(--print-scale);print-color-adjust:exact;-webkit-print-color-adjust:exact}
  }
</style></head>
<body>
  <button type="button" class="btn" id="btnPrint" title="Print stakeholder hierarchy" disabled>Print</button>
  <button type="button" class="btn" id="btnCollapseHeader" aria-label="Collapse form header" aria-expanded="true" title="Collapse form header" disabled>
  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 10 4-4 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button><button type="button" class="btn primary" id="btnNewStakeholder" disabled>+ New Stakeholder</button><div class="page">
    <div class="topbar" hidden style="display:none">
      <div class="title-wrap">
        <div class="eyebrow"><div class="eyebrow-dot"></div><div>FAB Stakeholder Coverage Map</div></div>
        <div class="subtitle">Customer hierarchy with FAB coverage collapsed on the right edge of each stakeholder card. Edit stakeholders, win-back strategies, and FAB covering personas. Changes are saved to Dataverse for the selected account.</div>
      </div>

      <div class="actions">
        <div class="pill"><span>Account</span><span id="accountName">Loading...</span></div>
        <div class="pill"><span>Session</span><span id="sessionId">—</span></div>
        <button class="btn" id="btnExport">Export JSON</button>
        <button class="btn primary" id="btnReset">Reset</button>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head" hidden style="display:none">
        <div class="panel-title"><div class="eyebrow-dot"></div><div>Customer Hierarchy with FAB Edge Coverage</div></div>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end">
          <div class="legend">
            <div class="legend-chip"><span class="legend-dot" style="background:#16a34a"></span> Strong coverage</div>
            <div class="legend-chip"><span class="legend-dot" style="background:#d97706"></span> Medium coverage</div>
            <div class="legend-chip"><span class="legend-dot" style="background:#dc2626"></span> Weak / gap</div>
          </div>
          <div class="status" id="statusText">Loaded</div>
        </div>
      </div>

      <div class="chart-area">
        <div id="chartWrap">
          <svg id="linesSvg"></svg>
          <div id="levels"></div>
        </div>
      </div>
    </div>
