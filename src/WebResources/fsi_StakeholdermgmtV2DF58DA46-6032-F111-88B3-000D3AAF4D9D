      function drawConnectors(){ drawScopedConnectors(document); }
      function drawScopedConnectors(scope){
        const svg = scope.querySelector('#linesSvg');
        const wrap = scope.querySelector('#chartWrap');
        const levelsEl = scope.querySelector('#levels');
        svg.innerHTML = '';

        const wrapRect = wrap.getBoundingClientRect();
        const width = wrap.scrollWidth;
        const height = wrap.scrollHeight;

        svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
        svg.style.height = height + 'px';
        svg.style.width = width + 'px';

        const getCenterBottom = (el) => {
          const r = el.getBoundingClientRect();
          return { x:(r.left - wrapRect.left) + r.width/2, y:(r.top - wrapRect.top) + r.height };
        };
        const getCenterTop = (el) => {
          const r = el.getBoundingClientRect();
          return { x:(r.left - wrapRect.left) + r.width/2, y:(r.top - wrapRect.top) };
        };

        state.stakeholders.forEach(child => {
          if(!child.parentId) return;

          const parentCard = levelsEl.querySelector(`.stakeholder-card[data-stakeholder-id="${child.parentId}"]`);
          const childCard = levelsEl.querySelector(`.stakeholder-card[data-stakeholder-id="${child.id}"]`);
          if(!parentCard || !childCard) return;

          const p = getCenterBottom(parentCard);
          const c = getCenterTop(childCard);
          const midY = (p.y + c.y) / 2;

          const path = document.createElementNS('http://www.w3.org/2000/svg','path');
          path.setAttribute('d', `M ${p.x} ${p.y} C ${p.x} ${midY}, ${c.x} ${midY}, ${c.x} ${c.y}`);
          path.setAttribute('fill','none');
          path.setAttribute('stroke','#94a3b8');
          path.setAttribute('stroke-width','2');
          path.setAttribute('opacity','.9');
          svg.appendChild(path);
        });
      }

