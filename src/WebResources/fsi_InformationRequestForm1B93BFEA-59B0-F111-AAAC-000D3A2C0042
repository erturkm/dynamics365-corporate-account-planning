        '<div>' + G.statusBadge(st) + '</div>' +
      '</div>' +
      '<div class="hmeta">' +
        hm("Account", acc) + hm("Account Plan", plan) + hm("Requested From", from) +
        hm("Requested By", by) + hm("Due Date", dueTxt) +
        (rec.fsi_submittedon ? hm("Submitted On", G.fmtDateTime(rec.fsi_submittedon)) : "") +
      '</div></div>';

    if (rec.fsi_requestdescription) {
      h += '<div class="card card-pad" style="margin-bottom:14px">' +
        '<div class="section-title" style="font-size:13px;margin-bottom:7px"><span class="dot"></span>Request Description</div>' +
        '<div style="font-size:12.5px;color:var(--ink2);line-height:1.6;white-space:pre-wrap">' + esc(rec.fsi_requestdescription) + '</div></div>';
    }

    if (rec.fsi_aisummary) {
      h += '<div class="card card-pad" style="margin-bottom:14px">' +
        '<div class="section-head" style="margin-bottom:10px"><div class="section-title" style="font-size:13px">' +
        '<span class="dot" style="background:var(--purple)"></span>AI Summary' +
        '<span class="badge b-soft" style="margin-left:6px">For the account plan owner</span></div></div>' +
        '<div class="ai-sum">' + esc(rec.fsi_aisummary) + '</div></div>';
    }

    if (st === 10203 || st === 10204) {
      h += '<div class="lockbar">' + G.icon("check",16) +
        'This response has been submitted and is read-only.' +
        (isOwner ? ' <span class="grow"></span><button class="btn btn-sm" id="btnReopen">Reopen for editing</button>' : '') + '</div>';
    }

    h += '<div class="section-head"><div class="section-title" style="font-size:14px"><span class="dot"></span>' +
      esc(form.title || "Questionnaire") +
      '<span class="badge b-draft">' + G.countFields(form) + ' questions</span></div>' +
      '<span class="mini muted" id="saveStamp"></span></div>';
    if (form.description) h += '<div class="section-sub" style="margin:-8px 0 12px">' + esc(form.description) + '</div>';
    h += '<div id="qHost"></div>';

    $("#root").innerHTML = h;
    renderer = new G.Renderer({ form: form, values: values, container: $("#qHost"), readOnly: !canEdit });

    if ($("#btnReopen")) $("#btnReopen").addEventListener("click", reopen);
    paintBar();
  }
  function hm(l,v){ return '<div class="hm"><div class="hm-l">' + esc(l) + '</div><div class="hm-v">' + esc(v) + '</div></div>'; }

  function paintBar(){
    var b = $("#bar"); b.classList.remove("hidden");
    var st = rec.fsi_status;
    var left = '<span class="mini muted">' + (canEdit ? "Your answers are saved to this request." : "Read-only") + '</span>';
    var right = "";
    if (canEdit) {
      right = '<button class="btn" id="btnDraft">' + G.icon("save",14) + ' Save Draft</button>' +
              '<button class="btn btn-ok btn-lg" id="btnSubmit">' + G.icon("check",15) + ' Submit</button>';
    }
    if (isOwner) {
      right = '<button class="btn" id="btnTpl">' + G.icon("copy",14) + ' Save as Template</button>' + right;
    }
    b.innerHTML = left + '<span class="grow"></span>' + right;
    if ($("#btnDraft"))  $("#btnDraft").addEventListener("click", function(){ saveDraft(this); });
    if ($("#btnSubmit")) $("#btnSubmit").addEventListener("click", function(){ submit(this); });
    if ($("#btnTpl"))    $("#btnTpl").addEventListener("click", saveAsTemplate);
  }

  /* ---------------- save draft ---------------- */
  function saveDraft(btn){
    var vals = renderer.getValues();
    var patch = { "fsi_responsejson": JSON.stringify(vals) };
    if (rec.fsi_status === 10201) patch["fsi_status"] = 10202;   /* Sent -> In Progress */
    var old = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spin dark"></span> Saving…';
    G.DV.update("fsi_informationrequests", reqId, patch)
      .then(function(){
        values = vals;
        if (patch.fsi_status) rec.fsi_status = patch.fsi_status;
        $("#saveStamp").textContent = "Draft saved " + G.fmtDateTime(new Date());
        G.toast("Draft saved", "ok");
        refreshHeaderBadge();
      })
      .catch(function(e){ G.toast(e.message || "Could not save the draft.", "err", 6000); })
      .then(function(){ btn.disabled = false; btn.innerHTML = old; });
  }
  function refreshHeaderBadge(){
    var b = $("#root .hero .badge");
    if (b) b.outerHTML = G.statusBadge(rec.fsi_status);
  }

  /* ---------------- submit ---------------- */
  function submit(btn){
    var v = renderer.validate();
    if (!v.ok) {
      G.toast(v.missing.length + " required question" + (v.missing.length===1?"":"s") + " still need an answer.", "err", 5000);
      return;
    }
    var old = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Submitting…';
    var patch = {
      "fsi_responsejson": JSON.stringify(v.values),
      "fsi_status": 10203,
      "fsi_submittedon": new Date().toISOString(),
      "fsi_SubmittedBy@odata.bind": "/systemusers(" + me.UserId + ")"
    };
    G.DV.update("fsi_informationrequests", reqId, patch)
      .then(function(){
        values = v.values; rec.fsi_status = 10203; rec.fsi_submittedon = patch.fsi_submittedon;
        canEdit = false;
        G.toast("Response submitted", "ok");
        btn.innerHTML = '<span class="spin"></span> Generating AI summary…';
        return generateSummary(v.values);
      })
      .then(function(){ return load(); })
      .then(function(){ paint(); notifyOwner(); })
      .catch(function(e){ G.toast(e.message || "Could not submit the response.", "err", 6000); })
      .then(function(){ btn.disabled = false; btn.innerHTML = old; });
  }

  /* ---------------- AI summary ---------------- */
  function generateSummary(vals){
    var text = G.responseToText(form, vals);
    return G.aiCall("summarize", {
      form: form, responseText: text, response: vals,
      requestTitle: rec.fsi_name || "",
      requestType: G.CATEGORY[rec.fsi_requesttype] || "",
      account: rec["_fsi_account_value@OData.Community.Display.V1.FormattedValue"] || "",
      accountPlan: rec["_fsi_accountplan_value@OData.Community.Display.V1.FormattedValue"] || ""
    }).then(function(res){
      var s = res;
      if (res && typeof res === "object") s = res.summary || res.result || res.output || res.text || "";
      if (typeof s === "object") s = s.summary || JSON.stringify(s);
      s = String(s || "").trim();
      if (!s) return;
      return G.DV.update("fsi_informationrequests", reqId, { "fsi_aisummary": s.slice(0, 7900) });
    }).catch(function(e){
      if (e.code === "NO_AI") {
        /* deterministic fallback so the demo flow always produces a summary */
        var s = fallbackSummary(vals);
        return G.DV.update("fsi_informationrequests", reqId, { "fsi_aisummary": s.slice(0, 7900) }).catch(function(){});
      }
      G.toast("Response saved, but the AI summary could not be generated.", "", 5000);
    });
  }

  function fallbackSummary(vals){
    var acc = rec["_fsi_account_value@OData.Community.Display.V1.FormattedValue"] || "The client";
    var lines = [], money = [], actions = [];
    form.sections.forEach(function(s){
      s.fields.forEach(function(f){
        var v = vals[f.id];
        if (v === null || v === undefined || v === "" || (Array.isArray(v) && !v.length)) return;
        if (Array.isArray(v)) v = v.join(", ");
        if (f.type === "currency") { money.push(f.label + " of AED " + Number(v).toLocaleString()); return; }
        if (f.type === "boolean") v = v ? "Yes" : "No";
        if (f.type === "date") v = G.fmtDate(v);
        if (/action|next step|recommend/i.test(f.label)) { actions.push(String(v)); return; }
        if (String(v).length > 25) lines.push(f.label + ": " + v);
      });
    });
    var out = acc + " — " + (G.CATEGORY[rec.fsi_requesttype] || "assessment") + " response.\n\n";
    if (lines.length) out += lines.slice(0,4).join("\n") + "\n\n";
    if (money.length) out += "Quantified: " + money.slice(0,4).join("; ") + ".\n\n";
    if (actions.length) out += "Recommended actions: " + actions.join(" ") + "";
    return out.trim();
  }

  /* ---------------- reopen ---------------- */
  function reopen(){
    G.DV.update("fsi_informationrequests", reqId, { "fsi_status": 10202 })
      .then(load).then(paint)
      .then(function(){ G.toast("Request reopened for editing", "ok"); })
      .catch(function(e){ G.toast(e.message || "Could not reopen the request.", "err"); });
  }

  /* ---------------- notify owner ---------------- */
  function notifyOwner(){
    var owner = rec["_createdby_value"];
    if (!owner || owner === me.UserId) return;
    var url = G.clientUrl() + "/main.aspx?etn=fsi_informationrequest&id=" + reqId + "&pagetype=entityrecord";
    G.DV.create("appnotifications", {
      "title": "Response submitted: " + (rec.fsi_name || "Information Request"),
      "body": (rec["_fsi_requestedfromteam_value@OData.Community.Display.V1.FormattedValue"]
             || rec["_fsi_requestedfromuser_value@OData.Community.Display.V1.FormattedValue"] || "A team")
             + " has submitted a response for "
             + (rec["_fsi_account_value@OData.Community.Display.V1.FormattedValue"] || "your account plan") + ".\n\n"
             + "Open the request: " + url,
      "ttlinseconds": 60 * 60 * 24 * 30,
      "icontype": 100000000,
      "ownerid@odata.bind": "/systemusers(" + owner + ")",
      "data": JSON.stringify({ actions:[{ title:"Open request", data:{ url:url, navigationTarget:"newWindow" } }] })
    }).catch(function(){});
  }

  /* ---------------- save as template ---------------- */
  function saveAsTemplate(){
    var cats = Object.keys(G.CATEGORY).map(function(k){
      return '<option value="' + k + '">' + esc(G.CATEGORY[k]) + '</option>'; }).join("");
    var m = G.el('<div class="modal"><div class="mbox">' +
      '<div class="section-title" style="font-size:15px;margin-bottom:4px"><span class="dot"></span>Save as Template</div>' +
      '<div class="section-sub" style="margin-bottom:16px">Make this questionnaire reusable for future information requests.</div>' +
      '<div class="fgrid">' +
        '<div class="fld f-full"><label class="flbl">Template Name<span class="req-star">*</span></label>' +
          '<input type="text" id="tplName" value="' + esc(rec.fsi_name || form.title || "") + '" maxlength="200"></div>' +
        '<div class="fld f-full"><label class="flbl">Description</label>' +
          '<textarea id="tplDesc" rows="2">' + esc(form.description || rec.fsi_requestdescription || "") + '</textarea></div>' +
        '<div class="fld"><label class="flbl">Category</label><select id="tplCat">' + cats + '</select></div>' +
        '<div class="fld"><label class="flbl">Target Team Type</label><select id="tplTeam">' + cats + '</select></div>' +
      '</div><div class="divider"></div>' +
      '<div class="row"><span class="grow"></span><button class="btn" id="tplCancel">Cancel</button>' +
      '<button class="btn btn-primary" id="tplSave">Save Template</button></div></div></div>');
    document.body.appendChild(m);
    var t = String(rec.fsi_requesttype || 10009);
    $("#tplCat", m).value = t; $("#tplTeam", m).value = t;
    $("#tplCancel", m).addEventListener("click", function(){ m.remove(); });
    m.addEventListener("click", function(e){ if (e.target === m) m.remove(); });
    $("#tplSave", m).addEventListener("click", function(){
      var name = $("#tplName", m).value.trim();
      if (!name) { G.toast("Enter a template name.", "err"); return; }
      var btn = this, old = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Saving…';
      var f = JSON.parse(JSON.stringify(form)); f.title = name;
      G.DV.create("fsi_informationrequesttemplates", {
        "fsi_name": name,
        "fsi_description": $("#tplDesc", m).value.trim() || null,
        "fsi_category": Number($("#tplCat", m).value),
        "fsi_targetteamtype": Number($("#tplTeam", m).value) + 100,
        "fsi_formjson": JSON.stringify(f),
        "fsi_active": true, "fsi_version": "1.0",
        "fsi_icon": "blank", "fsi_accentcolor": "#2563eb"
      }).then(function(){ m.remove(); G.toast("Saved to the template gallery", "ok"); })
        .catch(function(e){ G.toast(e.message || "Could not save the template.", "err", 6000);
                            btn.disabled = false; btn.innerHTML = old; });
    });
  }

  /* ---------------- boot ---------------- */
  reqId = resolveId();
  if (!reqId) {
    $("#root").innerHTML = '<div class="empty"><div class="e-ico">' + G.icon("alert",38,1.4) +
      '</div><div class="e-t">Save this request to continue</div>' +
      '<div class="e-s">The questionnaire appears once the information request record has been saved.</div></div>';
  } else {
    load().then(paint).catch(function(e){
      $("#root").innerHTML = '<div class="empty"><div class="e-ico">' + G.icon("alert",38,1.4) +
        '</div><div class="e-t">Could not load this request</div><div class="e-s">' + esc(e.message || "") + '</div></div>';
    });
  }
})();
</script>
</body>
</html>
