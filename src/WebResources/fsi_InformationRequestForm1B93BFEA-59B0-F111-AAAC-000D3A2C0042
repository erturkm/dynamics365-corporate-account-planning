<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Information Request</title>
<style>/* FAB Global Team Requests — shared design system */
*, *::before, *::after { box-sizing: border-box; }
:root{
  --ink:#0f172a; --ink2:#334155; --muted:#64748b; --muted2:#94a3b8;
  --line:#e2e8f0; --line2:#cbd5e1; --bg:#f8fafc; --card:#ffffff;
  --brand:#1e40af; --brand2:#2563eb; --brand-soft:#eff6ff;
  --ok:#059669; --ok-soft:#ecfdf5; --warn:#d97706; --warn-soft:#fffbeb;
  --danger:#dc2626; --danger-soft:#fef2f2; --info:#0891b2; --info-soft:#ecfeff;
  --purple:#7c3aed; --purple-soft:#f5f3ff;
  --r:14px; --r-sm:10px; --r-lg:18px;
  --sh:0 1px 2px rgba(15,23,42,.06), 0 8px 24px rgba(15,23,42,.06);
  --sh-lg:0 10px 40px rgba(15,23,42,.14);
}
body{ margin:0; font-family:"Segoe UI Variable Text","Segoe UI",system-ui,-apple-system,sans-serif;
      color:var(--ink); background:var(--bg); font-size:13px; line-height:1.5; }
.wrap{ padding:18px 20px 28px; max-width:1500px; margin:0 auto; }
h1,h2,h3,h4{ margin:0; font-weight:650; letter-spacing:-.01em; }

/* ---------- surface ---------- */
.card{ background:var(--card); border:1px solid var(--line); border-radius:var(--r); box-shadow:var(--sh); }
.card-pad{ padding:18px 20px; }
.section-head{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
.section-title{ font-size:15px; font-weight:700; display:flex; align-items:center; gap:9px; }
.section-title .dot{ width:8px; height:8px; border-radius:99px; background:var(--brand2); flex:none; }
.section-sub{ font-size:12px; color:var(--muted); margin-top:3px; }

/* ---------- KPI ---------- */
.kpis{ display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:12px; margin-bottom:18px; }
.kpi{ background:var(--card); border:1px solid var(--line); border-radius:var(--r); padding:14px 16px;
      box-shadow:var(--sh); position:relative; overflow:hidden; }
.kpi::after{ content:""; position:absolute; left:0; top:0; bottom:0; width:4px; background:var(--accent,var(--brand2)); }
.kpi .k-lbl{ font-size:11px; font-weight:650; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
.kpi .k-val{ font-size:28px; font-weight:700; line-height:1.15; margin-top:6px; letter-spacing:-.02em; }
.kpi .k-sub{ font-size:11px; color:var(--muted2); margin-top:2px; }

/* ---------- badges ---------- */
.badge{ display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:650;
        padding:3px 9px; border-radius:99px; border:1px solid transparent; white-space:nowrap; }
.badge .bdot{ width:6px; height:6px; border-radius:99px; background:currentColor; flex:none; }
.b-draft{ background:#f1f5f9; color:#475569; border-color:#e2e8f0; }
.b-sent{ background:var(--brand-soft); color:var(--brand); border-color:#bfdbfe; }
.b-prog{ background:var(--warn-soft); color:#b45309; border-color:#fde68a; }
.b-subm{ background:var(--ok-soft); color:#047857; border-color:#a7f3d0; }
.b-closed{ background:#f1f5f9; color:#64748b; border-color:#e2e8f0; }
.b-over{ background:var(--danger-soft); color:var(--danger); border-color:#fecaca; }
.b-soft{ background:var(--info-soft); color:#0e7490; border-color:#a5f3fc; }
.b-req{ background:var(--danger-soft); color:var(--danger); border-color:#fecaca; }

/* ---------- buttons ---------- */
.btn{ display:inline-flex; align-items:center; justify-content:center; gap:7px; font-family:inherit;
      font-size:12.5px; font-weight:650; padding:8px 15px; border-radius:var(--r-sm); cursor:pointer;
      border:1px solid var(--line2); background:#fff; color:var(--ink2); transition:.14s; white-space:nowrap; }
.btn:hover{ background:#f8fafc; border-color:var(--muted2); }
.btn:active{ transform:translateY(1px); }
.btn:disabled{ opacity:.5; cursor:not-allowed; }
.btn-primary{ background:var(--brand); border-color:var(--brand); color:#fff; box-shadow:0 1px 2px rgba(30,64,175,.3); }
.btn-primary:hover{ background:#1d4ed8; border-color:#1d4ed8; }
.btn-ok{ background:var(--ok); border-color:var(--ok); color:#fff; }
.btn-ok:hover{ background:#047857; border-color:#047857; }
.btn-ghost{ background:transparent; border-color:transparent; color:var(--brand); }
.btn-ghost:hover{ background:var(--brand-soft); border-color:transparent; }
.btn-danger{ background:#fff; border-color:#fecaca; color:var(--danger); }
.btn-danger:hover{ background:var(--danger-soft); }
.btn-sm{ font-size:11.5px; padding:5px 11px; }
.btn-lg{ font-size:13.5px; padding:11px 22px; }
.btn-ai{ background:linear-gradient(135deg,#7c3aed,#2563eb); border-color:transparent; color:#fff;
         box-shadow:0 2px 10px rgba(124,58,237,.34); }
.btn-ai:hover{ filter:brightness(1.07); }

/* ---------- table ---------- */
.tbl{ width:100%; border-collapse:separate; border-spacing:0; font-size:12.5px; }
.tbl th{ text-align:left; font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.06em;
         color:var(--muted); padding:9px 12px; border-bottom:1px solid var(--line); background:#fbfcfe; white-space:nowrap; }
.tbl td{ padding:11px 12px; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
.tbl tbody tr:hover{ background:#f8fbff; }
.tbl tbody tr{ cursor:pointer; }
.tbl .t-title{ font-weight:650; color:var(--brand); }
.tbl .t-title:hover{ text-decoration:underline; }

/* ---------- gallery cards ---------- */
.gallery{ display:grid; grid-template-columns:repeat(auto-fill,minmax(268px,1fr)); gap:14px; }
.tcard{ background:var(--card); border:1px solid var(--line); border-radius:var(--r); padding:16px;
        cursor:pointer; transition:.16s; position:relative; overflow:hidden; display:flex; flex-direction:column; gap:9px; }
.tcard::before{ content:""; position:absolute; left:0; right:0; top:0; height:3px; background:var(--accent,var(--brand2)); }
.tcard:hover{ transform:translateY(-3px); box-shadow:var(--sh-lg); border-color:var(--line2); }
.tcard.sel{ border-color:var(--brand2); box-shadow:0 0 0 3px var(--brand-soft); }
.tcard .ticon{ width:38px; height:38px; border-radius:11px; display:grid; place-items:center;
               background:var(--accent-soft,#eff6ff); color:var(--accent,var(--brand2)); flex:none; }
.tcard .tname{ font-size:13.5px; font-weight:700; line-height:1.3; }
.tcard .tdesc{ font-size:11.5px; color:var(--muted); line-height:1.45; flex:1; }
.tcard .tmeta{ display:flex; gap:6px; flex-wrap:wrap; align-items:center; font-size:10.5px; color:var(--muted2); }

/* choice chips */
.chips{ display:flex; gap:7px; flex-wrap:wrap; }
.chip{ font-size:11.5px; font-weight:600; padding:5px 12px; border-radius:99px; border:1px solid var(--line2);
       background:#fff; color:var(--ink2); cursor:pointer; transition:.14s; }
.chip:hover{ border-color:var(--brand2); color:var(--brand); }
.chip.on{ background:var(--brand); border-color:var(--brand); color:#fff; }

/* ---------- forms ---------- */
.fgrid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px 18px; }
.f-full{ grid-column:1/-1; }
.fld label.flbl{ display:block; font-size:12px; font-weight:650; color:var(--ink2); margin-bottom:5px; }
.fld .fhelp{ font-size:11px; color:var(--muted); margin-top:4px; line-height:1.4; }
.fld .ferr{ font-size:11px; color:var(--danger); margin-top:4px; font-weight:600; display:none; }
.fld.invalid .ferr{ display:block; }
.fld.invalid input,.fld.invalid textarea,.fld.invalid select{ border-color:#fca5a5; background:#fffbfb; }
.req-star{ color:var(--danger); margin-left:3px; }
input[type=text],input[type=number],input[type=date],textarea,select{
  width:100%; font-family:inherit; font-size:12.5px; color:var(--ink); background:#fff;
  border:1px solid var(--line2); border-radius:var(--r-sm); padding:8px 11px; transition:.14s; }
input:focus,textarea:focus,select:focus{ outline:none; border-color:var(--brand2); box-shadow:0 0 0 3px var(--brand-soft); }
input:disabled,textarea:disabled,select:disabled{ background:#f8fafc; color:var(--ink2); cursor:default; }
textarea{ resize:vertical; min-height:74px; line-height:1.55; }
.inp-affix{ position:relative; }
.inp-affix .affix{ position:absolute; top:50%; transform:translateY(-50%); font-size:11.5px;
                   font-weight:650; color:var(--muted); pointer-events:none; }
.inp-affix.pre .affix{ left:11px; } .inp-affix.pre input{ padding-left:42px; }
.inp-affix.post .affix{ right:11px; } .inp-affix.post input{ padding-right:30px; }

/* toggle */
.tgl{ display:inline-flex; align-items:center; gap:9px; cursor:pointer; user-select:none; }
.tgl input{ display:none; }
.tgl .track{ width:40px; height:22px; border-radius:99px; background:#cbd5e1; position:relative; transition:.18s; flex:none; }
.tgl .track::after{ content:""; position:absolute; top:2px; left:2px; width:18px; height:18px;
                    border-radius:99px; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.25); transition:.18s; }
.tgl input:checked + .track{ background:var(--ok); }
.tgl input:checked + .track::after{ transform:translateX(18px); }
.tgl .tlbl{ font-size:12.5px; font-weight:600; color:var(--ink2); }

/* multiselect */
.msel{ display:flex; flex-wrap:wrap; gap:7px; }
.msel .ms{ font-size:11.5px; font-weight:600; padding:6px 12px; border-radius:99px;
           border:1px solid var(--line2); background:#fff; color:var(--ink2); cursor:pointer; transition:.14s; }
.msel .ms:hover{ border-color:var(--brand2); }
.msel .ms.on{ background:var(--brand-soft); border-color:var(--brand2); color:var(--brand); }
.msel .ms.on::before{ content:"✓ "; font-weight:800; }

/* questionnaire section */
.qsec{ border:1px solid var(--line); border-radius:var(--r); margin-bottom:14px; background:#fff; overflow:hidden; }
.qsec > .qhead{ display:flex; align-items:center; justify-content:space-between; gap:10px;
                padding:12px 16px; background:linear-gradient(180deg,#fbfcfe,#f6f8fc); border-bottom:1px solid var(--line); }
.qsec .qnum{ width:22px; height:22px; border-radius:7px; background:var(--brand); color:#fff;
             font-size:11px; font-weight:700; display:grid; place-items:center; flex:none; }
.qsec .qtitle{ font-size:13px; font-weight:700; display:flex; align-items:center; gap:9px; }
.qsec .qbody{ padding:16px; }
.qsec .qdesc{ font-size:11.5px; color:var(--muted); padding:0 16px 0; margin-top:10px; }

/* ---------- header / hero ---------- */
.hero{ background:linear-gradient(135deg,#0f2a6b 0%,#1e40af 55%,#2563eb 100%); color:#fff;
       border-radius:var(--r-lg); padding:20px 24px; margin-bottom:18px; box-shadow:var(--sh); }
.hero h1{ font-size:19px; font-weight:700; letter-spacing:-.02em; }
.hero .hsub{ font-size:12.5px; opacity:.85; margin-top:5px; }
.hero .hmeta{ display:flex; gap:22px; flex-wrap:wrap; margin-top:16px; }
.hero .hm .hm-l{ font-size:10.5px; text-transform:uppercase; letter-spacing:.06em; opacity:.7; font-weight:650; }
.hero .hm .hm-v{ font-size:13px; font-weight:650; margin-top:3px; }

/* ---------- misc ---------- */
.empty{ text-align:center; padding:46px 20px; color:var(--muted); }
.empty .e-ico{ font-size:34px; opacity:.35; margin-bottom:10px; }
.empty .e-t{ font-size:13.5px; font-weight:650; color:var(--ink2); }
.empty .e-s{ font-size:12px; margin-top:5px; }
.spin{ width:16px; height:16px; border:2px solid rgba(255,255,255,.35); border-top-color:#fff;
       border-radius:99px; animation:sp .7s linear infinite; display:inline-block; }
.spin.dark{ border-color:rgba(37,99,235,.25); border-top-color:var(--brand2); }
@keyframes sp{ to{ transform:rotate(360deg);} }
.toast{ position:fixed; bottom:22px; left:50%; transform:translateX(-50%) translateY(90px);
        background:var(--ink); color:#fff; font-size:12.5px; font-weight:600; padding:11px 20px;
        border-radius:99px; box-shadow:var(--sh-lg); z-index:9999; transition:.28s; opacity:0; }
.toast.on{ transform:translateX(-50%) translateY(0); opacity:1; }
.toast.err{ background:var(--danger); }
.toast.ok{ background:var(--ok); }
.divider{ height:1px; background:var(--line); margin:16px 0; }
.row{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.grow{ flex:1; }
.muted{ color:var(--muted); }
.mini{ font-size:11px; }
.ai-note{ background:linear-gradient(135deg,var(--purple-soft),var(--brand-soft)); border:1px solid #ddd6fe;
          border-radius:var(--r); padding:14px 16px; }
.ai-note .ai-h{ font-size:12px; font-weight:700; color:var(--purple); display:flex; align-items:center; gap:7px; }
.ai-sum{ background:linear-gradient(135deg,#faf5ff,#eff6ff); border:1px solid #e9d5ff; border-radius:var(--r);
         padding:16px 18px; font-size:13px; line-height:1.65; color:var(--ink2); white-space:pre-wrap; }
.scroll{ overflow:auto; }
.sr{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }

  .wrap{ padding:16px 20px 88px; max-width:1200px; }
  .bar{ position:fixed; left:0; right:0; bottom:0; background:rgba(255,255,255,.94); backdrop-filter:blur(8px);
        border-top:1px solid var(--line); padding:11px 22px; display:flex; align-items:center; gap:10px; z-index:50; }
  .hidden{ display:none !important; }
  .lockbar{ background:var(--ok-soft); border:1px solid #a7f3d0; color:#047857; border-radius:var(--r);
            padding:11px 15px; font-size:12.5px; font-weight:600; display:flex; align-items:center; gap:9px; margin-bottom:14px; }
  .modal{ position:fixed; inset:0; background:rgba(15,23,42,.45); display:grid; place-items:center; z-index:200; padding:20px; }
  .modal .mbox{ background:#fff; border-radius:var(--r-lg); box-shadow:var(--sh-lg); width:100%; max-width:520px; padding:22px; }
</style>
</head>
<body>
<div class="wrap" id="root">
  <div class="empty"><div class="e-ico"><span class="spin dark"></span></div><div class="e-t">Loading request…</div></div>
</div>
<div class="bar hidden" id="bar"></div>

<script>/* FAB Global Team Requests — shared runtime (Dataverse access + questionnaire renderer) */
(function (G) {
  "use strict";

  /* ============================ Xrm / Dataverse ============================ */
  function xrm() {
    try { if (window.Xrm && window.Xrm.Utility) return window.Xrm; } catch (e) {}
    try { if (parent && parent.Xrm && parent.Xrm.Utility) return parent.Xrm; } catch (e) {}
    try { if (parent && parent.parent && parent.parent.Xrm) return parent.parent.Xrm; } catch (e) {}
    return null;
  }
  function clientUrl() {
    var X = xrm();
    try { return X.Utility.getGlobalContext().getClientUrl(); } catch (e) {}
    return window.location.origin;
  }
  var API = function () { return clientUrl() + "/api/data/v9.2/"; };

  function dvFetch(path, opts) {
    opts = opts || {};
    var url = /^https?:/i.test(path) ? path : API() + path;
    var h = {
      "Accept": "application/json",
      "OData-MaxVersion": "4.0",
      "OData-Version": "4.0",
      "Content-Type": "application/json; charset=utf-8"
    };
    var method = opts.method || "GET";
    if (opts.prefer) h["Prefer"] = opts.prefer;
    else if (method === "GET") h["Prefer"] = 'odata.include-annotations="*"';
    if (opts.headers) for (var k in opts.headers) h[k] = opts.headers[k];
    return fetch(url, {
      method: method,
      headers: h,
      credentials: "same-origin",
      body: opts.body ? JSON.stringify(opts.body) : undefined
    }).then(function (r) {
      if (!r.ok) {
        return r.text().then(function (t) {
          var msg = t;
          try { msg = (JSON.parse(t).error || {}).message || t; } catch (e) {}
          var err = new Error(msg || ("HTTP " + r.status));
          err.status = r.status;
          throw err;
        });
      }
      var id = r.headers.get("OData-EntityId") || "";
      if (r.status === 204) return { _entityId: idFrom(id) };
      return r.text().then(function (t) {
        var j = t ? JSON.parse(t) : {};
        if (id) j._entityId = idFrom(id);
        return j;
      });
    });
  }
  function idFrom(h) { var m = /\(([0-9a-f-]{36})\)/i.exec(h || ""); return m ? m[1] : null; }

  var DV = {
    fetch: dvFetch,
    retrieveMultiple: function (set, query) {
      return dvFetch(set + (query || "")).then(function (r) { return r.value || []; });
    },
    retrieve: function (set, id, query) { return dvFetch(set + "(" + id + ")" + (query || "")); },
    create: function (set, data) {
      return dvFetch(set, { method: "POST", body: data }).then(function (r) { return r._entityId; });
    },
    update: function (set, id, data) {
      return dvFetch(set + "(" + id + ")", { method: "PATCH", body: data });
    },
    whoAmI: function () { return dvFetch("WhoAmI"); },
    esc: function (s) { return String(s == null ? "" : s).replace(/'/g, "''"); }
  };

  /* ============================ utils ============================ */
  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }
  function el(html) { var d = document.createElement("div"); d.innerHTML = html.trim(); return d.firstElementChild; }
  function $(s, r) { return (r || document).querySelector(s); }
  function $$(s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); }

  function fmtDate(v) {
    if (!v) return "—";
    var d = new Date(v); if (isNaN(d)) return "—";
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
  }
  function fmtDateTime(v) {
    if (!v) return "—";
    var d = new Date(v); if (isNaN(d)) return "—";
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }) +
      " " + d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
  }
  function toISODate(v) {
    if (!v) return null;
    var d = new Date(v); if (isNaN(d)) return null;
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
  }
  function fmtMoney(n) {
    if (n === null || n === undefined || n === "" || isNaN(n)) return "—";
    var v = Number(n);
    if (Math.abs(v) >= 1e9) return (v / 1e9).toFixed(2).replace(/\.00$/, "") + "bn";
    if (Math.abs(v) >= 1e6) return (v / 1e6).toFixed(2).replace(/\.00$/, "") + "m";
    if (Math.abs(v) >= 1e3) return (v / 1e3).toFixed(1).replace(/\.0$/, "") + "k";
    return String(v);
  }
  function daysUntil(v) {
    if (!v) return null;
    var d = new Date(v); if (isNaN(d)) return null;
    var t = new Date(); t.setHours(0, 0, 0, 0); d.setHours(0, 0, 0, 0);
    return Math.round((d - t) / 86400000);
  }
  function uid(p) { return (p || "f") + "_" + Math.random().toString(36).slice(2, 9); }

  function toast(msg, kind, ms) {
    var t = $("#gtiToast");
    if (!t) { t = el('<div id="gtiToast" class="toast"></div>'); document.body.appendChild(t); }
    t.className = "toast " + (kind || "");
    t.textContent = msg;
    requestAnimationFrame(function () { t.classList.add("on"); });
    clearTimeout(t._h);
    t._h = setTimeout(function () { t.classList.remove("on"); }, ms || 3200);
  }

  /* ============================ choice maps ============================ */
  var CATEGORY = {
    10000: "Country Coverage", 10001: "Sector Coverage", 10002: "Global Markets",
    10003: "Transaction Banking", 10004: "Lending", 10005: "Credit / Risk",
    10006: "Trade Finance", 10007: "DCM / ECM", 10008: "Relationship Management", 10009: "Other"
  };
  var TEAMTYPE = {};
  Object.keys(CATEGORY).forEach(function (k) { TEAMTYPE[Number(k) + 100] = CATEGORY[k]; });

  var STATUS = { 10200: "Draft", 10201: "Sent", 10202: "In Progress", 10203: "Submitted", 10204: "Closed" };
  var STATUS_V = { Draft: 10200, Sent: 10201, "In Progress": 10202, Submitted: 10203, Closed: 10204 };
  var STATUS_CLS = { 10200: "b-draft", 10201: "b-sent", 10202: "b-prog", 10203: "b-subm", 10204: "b-closed" };

  /* team name -> Dataverse team record name (created in this environment) */
  var TEAM_FOR_TYPE = {
    "Country Coverage": "Country Coverage",
    "Sector Coverage": "Sector Coverage",
    "Global Markets": "Global Markets",
    "Transaction Banking": "Transaction Banking",
    "Lending": "Country Coverage",
    "Credit / Risk": "Credit & Risk",
    "Trade Finance": "Trade Finance",
    "DCM / ECM": "DCM / ECM",
    "Relationship Management": "Sector Coverage",
    "Other": "Sector Coverage"
  };

  function statusBadge(v) {
    var lbl = STATUS[v] || "Draft";
    return '<span class="badge ' + (STATUS_CLS[v] || "b-draft") + '"><span class="bdot"></span>' + esc(lbl) + "</span>";
  }

  /* ============================ icons ============================ */
  var ICONS = {
    globe: '<path d="M12 2a10 10 0 100 20 10 10 0 000-20zM2 12h20M12 2c3 3.5 3 16.5 0 20M12 2c-3 3.5-3 16.5 0 20"/>',
