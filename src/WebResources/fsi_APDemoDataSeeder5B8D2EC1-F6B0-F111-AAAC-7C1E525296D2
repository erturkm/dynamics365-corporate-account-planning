    if (_retried || !e.transient || method === "POST") throw e;
    return req(method, path, body, true);
  });
}

function rawReq(method, path, body) {
  return new Promise(function (resolve, reject) {
    var x = new XMLHttpRequest();
    x.timeout = REQ_TIMEOUT;
    x.open(method, /^http/.test(path) ? path : API + path, true);
    x.setRequestHeader("Accept", "application/json");
    x.setRequestHeader("OData-MaxVersion", "4.0");
    x.setRequestHeader("OData-Version", "4.0");
    if (body) {
      x.setRequestHeader("Content-Type", "application/json; charset=utf-8");
      x.setRequestHeader("Prefer", "return=representation");
    }
    x.onload = function () {
      if (x.status >= 200 && x.status < 300) {
        var id = null, loc = x.getResponseHeader("OData-EntityId");
        if (loc) { var m = /\(([0-9a-f-]{36})\)/i.exec(loc); if (m) id = m[1]; }
        var d = null;
        try { d = x.responseText ? JSON.parse(x.responseText) : null; } catch (e) { }
