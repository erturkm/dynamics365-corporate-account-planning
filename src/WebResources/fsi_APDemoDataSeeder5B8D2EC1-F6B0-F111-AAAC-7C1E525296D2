           accept a value that is actually a GUID. A bare /id$/ match is unsafe:
           lseg_analysisrunv2 carries lseg_permid ("5083831795"), which would
           otherwise be handed back as the record id and poison every
           @odata.bind built from it. */
        if (!id && d) {
          Object.keys(d).some(function (k) {
            if (!/id$/i.test(k)) return false;
            if (!GUID.test(String(d[k]))) return false;
            id = d[k];
            return true;
