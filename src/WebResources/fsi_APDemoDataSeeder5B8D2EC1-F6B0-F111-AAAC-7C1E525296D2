        }
        resolve({ data: d, id: id });
      } else {
        var msg = x.responseText;
        try { msg = JSON.parse(x.responseText).error.message; } catch (e) { }
        reject(new Error(x.status + " " + method + " " + path + " :: " + String(msg).slice(0, 220)));
      }
