/* Seeding issues well over a hundred sequential calls, so a single stalled
   socket must not hang the whole run: every request is bounded by a timeout,
   and idempotent verbs get one bounded retry. POST is never retried -- a
   request that actually succeeded before timing out would duplicate a row. */
var REQ_TIMEOUT = 60000;
var GUID = /^\{?[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\}?$/i;

