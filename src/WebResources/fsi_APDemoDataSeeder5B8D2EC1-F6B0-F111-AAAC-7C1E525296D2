    var v = row[k];
    if (k === "__links" || k === "__name" || k === "__state") return;  // control keys
    if (v === "@account" || v === "@plan") {
      var target = v === "@plan"
        ? "/fsi_accountplannings(" + ctx.plan + ")"
        : "/accounts(" + ctx.account + ")";
      out[(nav[k] || k) + "@odata.bind"] = target;
    } else {
      out[k] = v;
    }
  });
  return out;
}

/* ---------- find existing ---------- */
function findAccount() {
  return req("GET", "accounts?$select=accountid&$filter=name eq '" + esc(SEED.account.name) + "'&$top=1")
    .then(function (r) { return r.data.value.length ? r.data.value[0].accountid : null; });
}
function findPlan() {
  return req("GET", "fsi_accountplannings?$select=fsi_accountplanningid&$filter=fsi_title eq '"
                    + esc(SEED.plan.fsi_title) + "'&$top=1")
    .then(function (r) { return r.data.value.length ? r.data.value[0].fsi_accountplanningid : null; });
}


/* ---------- relink pass -------------------------------------------------
   Some lookups point at other rows inside this very dataset: the group
   hierarchy's parent entity, a stakeholder's contact, a request's source
   template. Those targets may not exist yet while a row is being created, so
   they are deferred to a second pass that runs once every row is in place.

   Targets are resolved by NAME rather than by the original GUID. Records are
   created with their original ids, so the two normally agree -- but resolving
   by name keeps the pass correct even when a row already existed in the target
   org under a different id.                                                */
function buildIndex(sets, ctx) {
  var index = {};
  return sets.reduce(function (chain, set) {
    return chain.then(function () {
      return req("GET", scoped(set, ctx, primary(set) + "," + idfield(set)))
        .then(function (r) {
          var m = {};
          r.data.value.forEach(function (x) {
            m[String(x[primary(set)]).toLowerCase()] = x[idfield(set)];
          });
          index[set] = m;
        }).catch(function () { index[set] = {}; });
    });
  }, Promise.resolve()).then(function () { return index; });
}

/* original GUID -> primary name, per set, taken from the seed payload */
function seedNames() {
  var map = {};
  Object.keys(SEED.tables).forEach(function (set) {
    var idf = idfield(set), nmf = primary(set), m = {};
    SEED.tables[set].forEach(function (row) {
      if (row[idf]) m[String(row[idf]).toLowerCase()] = nameOf(row, set);
    });
    map[set] = m;
  });
  return map;
}

function relink(ctx) {
  var pending = [];
  Object.keys(SEED.tables).forEach(function (set) {
    SEED.tables[set].forEach(function (row) {
      if (row.__links) pending.push({ set: set, row: row });
    });
  });
  if (!pending.length) return Promise.resolve(0);

  var needed = {};
  pending.forEach(function (p) {
    needed[p.set] = 1;
    Object.keys(p.row.__links).forEach(function (nav) {
      var l = p.row.__links[nav];
      if (l.set) needed[l.set] = 1;
    });
  });

  var names = seedNames(), patched = 0, misses = 0;
  /* Resolve an original seed id to the live record id. Prefer the map built
     while creating rows this run; fall back to matching on the primary name,
     which also covers rows that already existed before seeding. */
  function live(set, origId, index) {
    if (!origId) return null;
    var byId = (ctx.ids && ctx.ids[set]) || {};
    var hit = byId[String(origId).toLowerCase()];
    if (hit) return GUID.test(String(hit)) ? hit : null;
    var nm = (names[set] || {})[String(origId).toLowerCase()];
    var found = nm ? index[set][String(nm).toLowerCase()] || null : null;
    return found && GUID.test(String(found)) ? found : null;
  }
  return buildIndex(Object.keys(needed), ctx).then(function (index) {
    return pending.reduce(function (chain, p) {
      return chain.then(function () {
        var body = {},
            self = live(p.set, p.row[idfield(p.set)], index)
                || index[p.set][String(nameOf(p.row, p.set)).toLowerCase()];
        if (!self) { misses++; return; }
        Object.keys(p.row.__links).forEach(function (nav) {
          var l = p.row.__links[nav];
          var prop = (meta(p.set).nav || {})[nav] || nav;
          if (l.me) {
            if (ctx.me) body[prop + "@odata.bind"] = "/systemusers(" + ctx.me + ")";
            return;
          }
          var tid = live(l.set, l.id, index);
          /* Cross-check against the freshly read index: an id that is not in
             the live index cannot be bound, and attempting it yields a 404
             that aborts the whole PATCH (losing the other links in the body). */
          if (tid && index[l.set]) {
            var known = false;
            for (var nk in index[l.set]) {
              if (String(index[l.set][nk]).toLowerCase() === String(tid).toLowerCase()) {
                known = true; break;
              }
            }
            if (!known) tid = null;
          }
          if (tid) body[prop + "@odata.bind"] = "/" + l.set + "(" + tid + ")";
          else misses++;
        });
        if (!Object.keys(body).length) return;
        return req("PATCH", p.set + "(" + self + ")", body).then(function () {
          patched++;
        }).catch(function (e) {
          misses++; log("! relink " + p.set + ": " + e.message, "er");
        });
      });
    }, Promise.resolve()).then(function () {
      log(patched + " records relinked"
          + (misses ? " (" + misses + " reference(s) unresolved)" : ""),
          misses ? "er" : "mu");
      return patched;
    });
  });
}

function whoAmI() {
  return req("GET", "WhoAmI()").then(function (r) { return r.data.UserId; })
    .catch(function () { return null; });
}

/* Resolve a case, tolerating a timeout that actually succeeded server-side. */
function closeCase(id, status) {
  return req("POST", "CloseIncident", {
    IncidentResolution: {
      "@odata.type": "Microsoft.Dynamics.CRM.incidentresolution",
      subject: "Resolved",
      "incidentid@odata.bind": "/incidents(" + id + ")"
    },
    Status: status
  }).catch(function (e) {
    return req("GET", "incidents(" + id + ")?$select=statecode")
      .then(function (r) {
        if (r.data && r.data.statecode === 1) return;   // it did land
        throw e;
      }, function () { throw e; });
  });
}

/* Replay recorded record state.

   Dataverse rejects statecode on create, and a case cannot simply be PATCHed
   to Resolved -- it requires the CloseIncident action with a resolution
   record. Anything else is a plain PATCH. Runs after seeding so the rows and
   their links already exist. */
function applyState(ctx) {
  var pending = [];
  Object.keys(SEED.tables).forEach(function (set) {
    SEED.tables[set].forEach(function (row) {
      if (row.__state && row.__state.statecode) pending.push({ set: set, row: row });
    });
  });
  if (!pending.length) return Promise.resolve(0);

  var sets = {};
  pending.forEach(function (p) { sets[p.set] = 1; });
  var applied = 0, failed = 0;
  return buildIndex(Object.keys(sets), ctx).then(function (index) {
    return pending.reduce(function (chain, p) {
      return chain.then(function () {
        var id = (ctx.ids && ctx.ids[p.set]
                  && ctx.ids[p.set][String(p.row[idfield(p.set)]).toLowerCase()])
              || index[p.set][String(nameOf(p.row, p.set)).toLowerCase()];
        if (!id) return;
        var st = p.row.__state;
        if (p.set === "incidents") {
          /* CloseIncident is slow enough on a cold org that it sometimes
             returns "operation has timed out" AFTER the case was resolved.
             Re-read the state before deciding, so a spurious timeout is not
             reported as a failure and the action is never applied twice. */
          return closeCase(id, st.statuscode || 5)
            .then(function () { applied++; })
            .catch(function (e) {
              failed++; log("! close case: " + e.message, "er");
            });
        }
        return req("PATCH", p.set + "(" + id + ")", st)
          .then(function () { applied++; })
          .catch(function () { failed++; });
      });
    }, Promise.resolve()).then(function () {
      if (applied || failed) {
        log(applied + " record state(s) applied"
            + (failed ? " (" + failed + " failed)" : ""), failed ? "er" : "mu");
      }
      return applied;
    });
  });
}

/* ---------- seed ---------- */
function seed() {
  busy(true); logEl.innerHTML = ""; noteEl.className = "note";
  var ctx = {}, created = 0, skipped = 0, failed = 0;
  var sets = Object.keys(SEED.tables).filter(function (t) { return SEED.tables[t].length; });
  var total = 2; sets.forEach(function (t) { total += SEED.tables[t].length; });
  var done = 0;
  function step() { done++; progress(done, total); }

  log("Target: " + API, "mu");

  return findAccount().then(function (id) {
    if (id) { ctx.account = id; skipped++; log("= account '" + SEED.account.name + "' already exists", "mu"); step(); return; }
    return req("POST", "accounts", SEED.account).then(function (r) {
    /* The account is created under its source GUID (see SEED.account.accountid)
       because approved web resources resolve the LSEG issuer identity from it. */
    ctx.account = SEED.account.accountid || r.id;
    created++; log("+ account " + SEED.account.name, "ok"); step();
  });
  }).then(findPlan).then(function (id) {
    if (id) { ctx.plan = id; skipped++; log("= plan already exists", "mu"); step(); return; }
    return req("POST", "fsi_accountplannings", bind(SEED.plan, ctx, "fsi_accountplannings")).then(function (r) {
      ctx.plan = r.id; created++; log("+ plan " + SEED.plan.fsi_title, "ok"); step();
    });
  }).then(function () {
    return sets.reduce(function (chain, set) {
      return chain.then(function () {
        var rows = SEED.tables[set];
        return req("GET", scoped(set, ctx, primary(set))).then(function (r) {
          var have = {};
          r.data.value.forEach(function (x) { have[String(x[primary(set)]).toLowerCase()] = 1; });
          return rows.reduce(function (c2, row) {
            return c2.then(function () {
              var key = String(nameOf(row, set) || "").toLowerCase();
              if (key && have[key]) { skipped++; step(); return; }
              return req("POST", set, bind(row, ctx, set)).then(function (r) {
                /* Remember original-id -> live-id so the relink pass can
                   resolve references without relying on name matching. */
                var orig = row[idfield(set)];
                /* Take the id from the entity's OWN primary key whenever the
                   response carries it. The generic fallback in rawReq matches
                   any GUID-valued key ending in "id", which on contact rows
                   can hit addressN_addressid and hand back an address GUID. */
                var newId = (r && r.data && GUID.test(String(r.data[idfield(set)] || "")))
                          ? r.data[idfield(set)] : (r && r.id);
                if (orig && newId && GUID.test(String(newId))) {
                  if (!ctx.ids) ctx.ids = {};
                  if (!ctx.ids[set]) ctx.ids[set] = {};
                  ctx.ids[set][String(orig).toLowerCase()] = newId;
                }
                created++; step();
              }).catch(function (e) {
                failed++; step(); log("! " + set + ": " + e.message, "er");
              });
            });
          }, Promise.resolve()).then(function () {
            log((rows.length) + " x " + label(set), "mu");
          });
        }).catch(function (e) {
          failed += rows.length; done += rows.length; progress(done, total);
          log("! " + set + " unavailable: " + e.message, "er");
        });
      });
    }, Promise.resolve());
  }).then(function () {
    // only the relink pass needs the current user, and it is optional there
    return whoAmI().then(function (me) { ctx.me = me; return relink(ctx); });
  }).then(function () {
    return applyState(ctx);
  }).then(function () {
    progress(total, total);
    var msg = "<b>Done.</b> " + created + " created, " + skipped + " already present"
            + (failed ? ", <b>" + failed + " failed</b>" : "") + ".";
    note(msg + "<br />Open <b>" + SEED.plan.fsi_title + "</b> to view the plan.",
         failed ? "w" : "s");
    busy(false);
  }).catch(function (e) {
    note("<b>Seeding stopped.</b> " + e.message, "e");
    log(e.message, "er"); busy(false);
  });
}

function meta(set) { return SEED.meta.sets[set] || {}; }

/* De-duplication key for a seed row. Some primary names are calculated and
   therefore absent from the writable payload (contacts' fullname), in which
   case s11 preserves the value under __name. */
function nameOf(row, set) {
  return row.__name !== undefined ? row.__name : row[primary(set)];
}
function primary(set) { return meta(set).name || "fsi_name"; }
function idfield(set) { return meta(set).id; }

/* Scope dedupe queries to this account so identically-named rows belonging to
   other customers are never mistaken for already-seeded data. */
function scoped(set, ctx, select) {
  var q = set + "?$select=" + select + "&$top=1000";
  var lk = meta(set).link;
  if (lk && ctx.account) q += "&$filter=_" + lk + "_value eq " + ctx.account;
  return q;
}

/* ---------- status ---------- */
function check() {
  busy(true); logEl.innerHTML = ""; noteEl.className = "note";
  var sets = Object.keys(SEED.tables).filter(function (t) { return SEED.tables[t].length; });
  var ctx = {};
  return findAccount().then(function (a) {
    ctx.account = a;
    log(a ? "= account present" : "- account missing", a ? "ok" : "mu");
    return findPlan();
  }).then(function (p) {
    log(p ? "= plan present" : "- plan missing", p ? "ok" : "mu");
    return sets.reduce(function (chain, set) {
      return chain.then(function () {
        return req("GET", scoped(set, ctx, primary(set))).then(function (r) {
          log((r.data.value.length + " / " + SEED.tables[set].length + "  " + label(set)),
              r.data.value.length >= SEED.tables[set].length ? "ok" : "mu");
        }).catch(function () { log("? " + set + " not available in this environment", "er"); });
      });
    }, Promise.resolve());
  }).then(function () { note("Status check complete.", "s"); busy(false); });
}

/* ---------- wipe ---------- */
function wipe() {
  if (!window.confirm("Delete the demo records created by this seeder?\n\n"
                    + "This removes the seeded child records, the account plan and the account.")) return;
  busy(true); logEl.innerHTML = ""; noteEl.className = "note";
  var sets = Object.keys(SEED.tables).filter(function (t) { return SEED.tables[t].length; }).reverse();
  var removed = 0, ctx = {};
  return findAccount().then(function (a) { ctx.account = a; }).then(function () {
  return sets.reduce(function (chain, set) {
    return chain.then(function () {
      return req("GET", scoped(set, ctx, idfield(set))).then(function (r) {
        return r.data.value.reduce(function (c2, row) {
          return c2.then(function () {
            return req("DELETE", set + "(" + row[idfield(set)] + ")")
              .then(function () { removed++; })
              .catch(function () { });
          });
        }, Promise.resolve());
      }).then(function () { log("cleared " + label(set), "mu"); })
        .catch(function () { });
    });
  }, Promise.resolve()); }).then(findPlan).then(function (p) {
    if (p) return req("DELETE", "fsi_accountplannings(" + p + ")").then(function () { removed++; });
  }).then(findAccount).then(function (a) {
    if (a) return req("DELETE", "accounts(" + a + ")").then(function () { removed++; }).catch(function () { });
  }).then(function () {
    note("<b>Removed " + removed + " records.</b>", "s"); busy(false);
  }).catch(function (e) { note("Cleanup error: " + e.message, "e"); busy(false); });
}

document.getElementById("run").addEventListener("click", seed);
document.getElementById("check").addEventListener("click", check);
document.getElementById("wipe").addEventListener("click", wipe);
</script>
</body>
