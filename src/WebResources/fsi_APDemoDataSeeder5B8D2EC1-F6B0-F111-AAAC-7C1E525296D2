  }
  *{box-sizing:border-box}
  body{margin:0;padding:24px;background:var(--bg);color:var(--ink);
       font-family:"Segoe UI",system-ui,-apple-system,sans-serif;font-size:14px}
  .wrap{max-width:940px;margin:0 auto}
  .card{background:#fff;border:1px solid var(--line);border-radius:10px;
        box-shadow:0 1px 3px rgba(11,31,51,.06);margin-bottom:16px}
  .card-h{padding:16px 20px;border-bottom:1px solid var(--line)}
  .card-b{padding:20px}
  h1{margin:0;font-size:20px;font-weight:650;letter-spacing:-.2px}
  h2{margin:0 0 10px;font-size:14px;font-weight:650}
  .sub{margin:4px 0 0;color:var(--muted);font-size:13px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}
  .item{border:1px solid var(--line);border-radius:7px;padding:10px 12px;background:#fbfdff}
  .item .n{font-weight:600}
  .item .c{color:var(--muted);font-size:12px;margin-top:2px}
  .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  button{font:inherit;font-weight:600;border-radius:7px;padding:10px 18px;cursor:pointer;
         border:1px solid transparent;transition:.15s}
  .primary{background:var(--brand);color:#fff}
  .primary:hover:not(:disabled){background:var(--brand2)}
  .ghost{background:#fff;color:var(--ink);border-color:var(--line)}
  .ghost:hover:not(:disabled){background:#f0f5fa}
  .danger{background:#fff;color:var(--err);border-color:#eccccf}
  .danger:hover:not(:disabled){background:var(--errbg)}
  button:disabled{opacity:.5;cursor:not-allowed}
  .bar{height:7px;background:#e9eff6;border-radius:4px;overflow:hidden;margin:14px 0 8px;display:none}
  .bar.on{display:block}
  .bar > i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--brand),var(--brand2));
           transition:width .25s}
  .log{display:none;margin-top:12px;max-height:300px;overflow:auto;border:1px solid var(--line);
       border-radius:7px;background:#fbfdff;padding:10px 12px;
       font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;line-height:1.7}
  .log.on{display:block}
  .log .ok{color:var(--ok)} .log .er{color:var(--err)} .log .mu{color:var(--muted)}
  .note{border-radius:7px;padding:12px 14px;font-size:13px;margin-top:14px;display:none}
  .note.on{display:block}
  .note.s{background:var(--okbg);color:var(--ok)}
  .note.w{background:var(--warnbg);color:var(--warn)}
  .note.e{background:var(--errbg);color:var(--err)}
  code{background:#eef3f9;padding:1px 5px;border-radius:4px;font-size:12px}
</style>
</head>
<body>
<div class="wrap">

  <div class="card">
    <div class="card-h">
      <h1>Account Plan &mdash; Demo Data Seeder</h1>
      <p class="sub">Creates a complete, ready-to-demo corporate account plan with 177 related
         records across 18 tables. Safe to run more than once &mdash; existing
         records are detected and left alone.</p>
    </div>
    <div class="card-b">
      <h2>What gets created</h2>
      <div class="grid" id="manifest"></div>

      <div class="row" style="margin-top:18px">
        <button class="primary" id="run">Seed demo data</button>
        <button class="ghost"   id="check">Check status</button>
        <button class="danger"  id="wipe">Remove demo data</button>
      </div>

      <div class="bar" id="bar"><i id="fill"></i></div>
      <div class="note" id="note"></div>
      <div class="log"  id="log"></div>
    </div>
  </div>

  <div class="card">
    <div class="card-b">
      <h2>After seeding</h2>
      <p class="sub" style="margin:0">
        Open <b>Account Planning</b> &rarr; <b>Account Plans</b> and select
        <b>FY27 Account Plan | ADNOC</b>.<br />
        To enable AI summaries on the Global Team Inputs tab, paste your flow's HTTP
        trigger URL into the <code>aiEndpoint</code> key of the <code>__CONFIG__</code> row
        in <code>fsi_informationrequesttemplate</code>. Everything else works without it.
      </p>
    </div>
  </div>

</div>

