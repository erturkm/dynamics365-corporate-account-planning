<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Relationship Economics</title>
  <style>
/* Shared chrome for the new Account Plan tabs.
 * Tokens mirror webresources/account-plan-summary-live/styles.css so the new screens
 * read as part of the same application. */
:root {
  color-scheme: light;
  --cp-bg: #ffffff;
  --cp-bg-elevated: #f6f9fd;
  --cp-surface: #ffffff;
  --cp-surface-soft: #f2f7fc;
  --cp-border: #dbe5f0;
  --cp-border-strong: #8ba3bf;
  --cp-text: #172033;
  --cp-text-muted: #55657d;
  --cp-text-soft: #6c7d95;
  --cp-accent: #1e3a8a;
  --cp-accent-soft: rgba(30, 58, 138, 0.07);
  --cp-success: #16a34a;
  --cp-danger: #dc2626;
  --cp-warning: #d97706;
  --cp-link: #1d4ed8;
  --cp-series-1: #1e3a8a;
  --cp-series-2: #2f6fb5;
  --cp-series-3: #5aa0dd;
  --cp-series-4: #0e7490;
  --cp-series-5: #7c3aed;
  --cp-series-6: #64748b;
  --cp-shadow: 0 10px 30px rgba(23, 32, 51, 0.08);
}
html[data-theme="dark"] {
  color-scheme: dark;
  --cp-bg: #0f172a;
  --cp-bg-elevated: #131f38;
  --cp-surface: #16233d;
  --cp-surface-soft: #1c2b47;
  --cp-border: #2b3b58;
  --cp-border-strong: #44577a;
  --cp-text: #e2e8f0;
  --cp-text-muted: #94a3b8;
  --cp-text-soft: #b0bccd;
  --cp-accent: #7ea6e0;
  --cp-accent-soft: rgba(126, 166, 224, 0.15);
  --cp-success: #4ade80;
  --cp-danger: #f87171;
  --cp-warning: #fbbf24;
  --cp-link: #93c5fd;
  --cp-series-1: #7ea6e0;
  --cp-series-2: #4f9bd8;
  --cp-series-3: #93c5fd;
  --cp-series-4: #5eead4;
  --cp-series-5: #c4a2f0;
  --cp-series-6: #a5b4c8;
  --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
}

*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }

body {
  margin: 0;
  background: var(--cp-bg);
  color: var(--cp-text);
  font: 13px/1.45 "Segoe UI", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif;
  -webkit-font-smoothing: antialiased;
}
main { max-width: 1440px; margin: 0 auto; padding: 14px 18px 28px; }

/* ---- page header --------------------------------------------------------- */
.page-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 18px; flex-wrap: wrap; margin-bottom: 14px;
}
.page-title { font-size: 17px; font-weight: 700; letter-spacing: -0.01em; }
.page-sub { margin-top: 3px; font-size: 12px; color: var(--cp-text-muted); }
.source-note {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 6px 11px; border-radius: 999px;
  background: var(--cp-surface); border: 1px solid var(--cp-border);
  font-size: 11px; font-weight: 600; color: var(--cp-text-muted);
}
.source-note .dot {
  width: 7px; height: 7px; border-radius: 50%; background: var(--cp-success);
}
.demo-note {
  margin-bottom: 12px; padding: 8px 12px; border-radius: 10px;
  background: var(--cp-accent-soft); border: 1px solid var(--cp-border);
  font-size: 11px; font-weight: 600; color: var(--cp-text-muted);
}

/* ---- layout primitives --------------------------------------------------- */
.grid { display: grid; gap: 12px; }
.grid.k2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid.k3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid.k4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.grid.k5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.grid.k6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.span2 { grid-column: span 2; }
.stack { display: flex; flex-direction: column; gap: 12px; }
.row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.spacer { flex: 1; }

.card {
  background: var(--cp-surface);
  border: 1px solid var(--cp-border);
  border-radius: 14px;
  padding: 14px 16px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.03);
}
.card-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 10px; margin-bottom: 10px;
}
.card-title { font-size: 13px; font-weight: 700; }
.card-sub { font-size: 11px; color: var(--cp-text-muted); font-weight: 600; }

/* ---- KPI ----------------------------------------------------------------- */
.kpi { position: relative; overflow: hidden; }
.kpi::after {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: var(--cp-accent); opacity: .85;
}
.kpi-label {
  font-size: 10px; font-weight: 700; letter-spacing: .07em;
  text-transform: uppercase; color: var(--cp-text-soft);
}
.kpi-value { font-size: 22px; font-weight: 700; margin-top: 5px; letter-spacing: -0.02em; }
.kpi-value.sm { font-size: 17px; }
.kpi-meta { margin-top: 5px; font-size: 11px; color: var(--cp-text-muted); font-weight: 600; }
.kpi.good::after { background: var(--cp-success); }
.kpi.warn::after { background: var(--cp-warning); }
.kpi.bad::after { background: var(--cp-danger); }

.delta { font-weight: 700; }
.delta.up { color: var(--cp-success); }
.delta.down { color: var(--cp-danger); }
.delta.flat { color: var(--cp-text-muted); }

/* ---- pills --------------------------------------------------------------- */
.pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 9px; border-radius: 999px;
  font-size: 10.5px; font-weight: 700; white-space: nowrap;
  border: 1px solid transparent;
}
.pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.pill.ok { background: rgba(22,163,74,.10); color: var(--cp-success); border-color: rgba(22,163,74,.22); }
.pill.warn { background: rgba(245,158,11,.12); color: #b45309; border-color: rgba(245,158,11,.28); }
.pill.bad { background: rgba(220,38,38,.10); color: var(--cp-danger); border-color: rgba(220,38,38,.22); }
.pill.info { background: rgba(29,78,216,.10); color: var(--cp-link); border-color: rgba(29,78,216,.22); }
.pill.mute { background: var(--cp-surface-soft); color: var(--cp-text-muted); border-color: var(--cp-border); }
.pill.plain::before { display: none; }

/* ---- tables -------------------------------------------------------------- */
.table-wrap { overflow-x: auto; }
table.data { width: 100%; border-collapse: collapse; font-size: 12px; }
table.data th {
  text-align: left; padding: 8px 10px;
  font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
  color: var(--cp-text-soft); border-bottom: 1px solid var(--cp-border); white-space: nowrap;
}
table.data td {
  padding: 9px 10px; border-bottom: 1px solid var(--cp-border);
  vertical-align: middle;
}
table.data tbody tr:hover { background: var(--cp-surface-soft); }
table.data td.num, table.data th.num { text-align: right; font-variant-numeric: tabular-nums; }
table.data td.strong { font-weight: 700; }
table.data tr.total td { font-weight: 700; border-top: 2px solid var(--cp-border-strong); }

/* ---- bars ---------------------------------------------------------------- */
.bar {
  position: relative; height: 7px; border-radius: 999px;
  background: var(--cp-surface-soft); overflow: hidden; min-width: 70px;
}
.bar > span { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 999px; background: var(--cp-accent); }
.bar.ok > span { background: var(--cp-success); }
.bar.warn > span { background: var(--cp-warning); }
.bar.bad > span { background: var(--cp-danger); }
.bar-cell { display: flex; align-items: center; gap: 9px; min-width: 150px; }
.bar-cell .val { font-variant-numeric: tabular-nums; font-weight: 700; min-width: 46px; text-align: right; }

/* ---- charts -------------------------------------------------------------- */
.chart { width: 100%; height: 132px; display: block; }
.chart-legend { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 8px; }
.legend-key { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: var(--cp-text-muted); }
.legend-key i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

/* ---- collapsible --------------------------------------------------------- */
details.section { border: 1px solid var(--cp-border); border-radius: 14px; background: var(--cp-surface); }
details.section > summary {
  list-style: none; cursor: pointer; padding: 12px 16px;
  font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 10px;
}
details.section > summary::-webkit-details-marker { display: none; }
details.section > summary::after {
  content: "\25BE"; margin-left: auto; color: var(--cp-text-soft); transition: transform .18s ease;
}
details.section[open] > summary::after { transform: rotate(180deg); }
details.section > .section-body { padding: 0 16px 16px; }

/* ---- misc ---------------------------------------------------------------- */
.muted { color: var(--cp-text-muted); }
.tiny { font-size: 11px; }
.nowrap { white-space: nowrap; }
.tip { cursor: help; border-bottom: 1px dotted var(--cp-border-strong); }
.state {
  padding: 34px; text-align: center; color: var(--cp-text-muted);
  font-size: 13px; font-weight: 600;
}
.empty {
  padding: 22px; text-align: center; color: var(--cp-text-muted);
  font-size: 12px; font-weight: 600; border: 1px dashed var(--cp-border); border-radius: 12px;
}

@media (max-width: 1100px) {
  .grid.k5, .grid.k6 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grid.k4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 760px) {
  main { padding: 12px 12px 22px; }
  .grid.k2, .grid.k3, .grid.k4, .grid.k5, .grid.k6 { grid-template-columns: 1fr; }
  .span2 { grid-column: span 1; }
}

/* Compact label/value list used to fill tall cards beside a chart. */
.stat-list { margin-top: 16px; border-top: 1px solid var(--cp-border); }
.stat-list .stat-row {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 12px; padding: 9px 2px; border-bottom: 1px solid var(--cp-border);
  font-size: 12px;
}
.stat-list .stat-row:last-child { border-bottom: 0; }
.stat-list .stat-row span:first-child { color: var(--cp-text-soft); }
.stat-list .stat-row span:last-child { font-weight: 700; color: var(--cp-text); }

  </style>
</head>
<body>
<main id="root">
<div class="page-head">
  <div>
    <div class="page-title" id="pgTitle">Relationship Economics</div>
    <div class="page-sub">Where do we make money on this relationship, and are we earning enough for the capital we commit?</div>
  </div>
  <div class="row">
    <label class="card-sub" for="periodSelect">Period</label>
    <select id="periodSelect" style="padding:5px 9px;border-radius:8px;border:1px solid var(--cp-border);background:var(--cp-surface);color:var(--cp-text);font:inherit;font-weight:600;"></select>
    <span class="source-note"><span class="dot"></span>Source: Dataverse relationship economics</span>
  </div>
</div>

<div id="state" class="state">Loading relationship economics…</div>

<div id="content" hidden>
  <div class="demo-note">
    Lightweight POC profitability model. Figures are illustrative demo data, not the bank’s production profitability engine.
  </div>

  <div class="grid k3">
    <div class="card">
      <div class="card-head"><div class="card-title">RAROC vs hurdle</div>
        <div class="card-sub" id="rarocSub"></div></div>
      <div id="rarocGauge"></div>
      <div id="rarocVerdict" style="text-align:center;"></div>
      <div id="rarocStats" class="stat-list"></div>
    </div>
    <div class="card span2">
      <div class="card-head"><div class="card-title">Relationship P&amp;L</div>
        <div class="card-sub" id="plSub"></div></div>
      <div class="grid k3" id="plRow"></div>
    </div>
  </div>

  <div class="grid k2" style="margin-top:12px;">
    <div class="card">
      <div class="card-head"><div class="card-title">Revenue mix</div>
        <div class="card-sub">By income type</div></div>
      <div id="chartMix"></div>
      <div class="chart-legend" id="mixLegend"></div>
    </div>
    <div class="card">
      <div class="card-head"><div class="card-title">RAROC by product</div>
        <div class="card-sub">Bar height is RAROC %, the line marks the hurdle</div></div>
      <div id="chartRaroc"></div>
    </div>
  </div>

  <div class="card" style="margin-top:12px;">
    <div class="card-head">
      <div><div class="card-title">Profitability by product</div>
        <div class="card-sub" id="productSub"></div></div>
    </div>
    <div class="table-wrap">
      <table class="data">
        <thead><tr>
          <th>Product</th><th class="num">NII</th><th class="num">Fees</th>
          <th class="num">FX / Treasury</th><th class="num">Trade</th><th class="num">Total revenue</th>
          <th class="num">Cost of funds</th><th class="num">Cost to serve</th><th class="num">ECL</th>
          <th class="num">Net profit</th><th class="num">Capital</th><th class="num">RAROC</th><th>vs hurdle</th>
        </tr></thead>
        <tbody id="productBody"></tbody>
      </table>
    </div>
  </div>

  <div class="card" style="margin-top:12px;" id="trendCard">
    <div class="card-head"><div class="card-title">Trend</div>
      <div class="card-sub">Net relationship profitability and RAROC by period</div></div>
    <div class="grid k2">
      <div><div class="card-sub" style="margin-bottom:6px;">Net profitability</div><div id="chartTrendProfit"></div></div>
      <div><div class="card-sub" style="margin-bottom:6px;">RAROC %</div><div id="chartTrendRaroc"></div></div>
    </div>
  </div>
</div>

</main>
<script>
/* Shared Account Plan tab runtime.
 * Resolves the current fsi_accountplanning record and its fsi_customer account dynamically
 * from the hosting form, then exposes small Web API + formatting helpers.
 * No record GUIDs are hardcoded anywhere.
 * Mirrors the pattern already used by fsi_LimitUtilizationLive and fsi_shareofwallet.
 */
var APCtx = (function () {
  "use strict";

  var API = "/api/data/v9.2/";

  function getXrm() {
    try {
      if (window.parent && window.parent !== window && window.parent.Xrm) return window.parent.Xrm;
    } catch (e) { /* cross-origin during navigation */ }
    if (window.Xrm) return window.Xrm;
    return null;
  }

  function clientUrl() {
    var xrm = getXrm();
    if (!xrm) return "";
    try { return xrm.Utility.getGlobalContext().getClientUrl(); } catch (e) { return ""; }
  }

  function normaliseGuid(value) {
    return String(value || "").replace(/[{}]/g, "").toLowerCase();
  }

  /* Resolve { planId, accountId, accountName, planTitle, clientUrl }.
   * Works whether the web resource sits on the account plan form or (as a fallback)
   * directly on an account form. */
  function resolve() {
    var xrm = getXrm();
    if (!xrm) {
      return Promise.reject(new Error(
        "Xrm context not found. Host this page as a web resource inside the model-driven app."));
    }
    var url = clientUrl();
    var form = xrm.Page;
    var entityName = "";
    var recordId = "";
    try {
      entityName = form.data.entity.getEntityName();
      recordId = normaliseGuid(form.data.entity.getId());
    } catch (e) { /* form not ready */ }

    if (entityName === "account") {
      var accountName = "";
      try { accountName = form.getAttribute("name").getValue() || ""; } catch (e) { }
      return Promise.resolve({
        clientUrl: url, planId: null, planTitle: "", accountId: recordId, accountName: accountName
      });
    }

    var lookup = null;
    try {
      var attribute = form.getAttribute("fsi_customer");
      lookup = attribute && attribute.getValue();
    } catch (e) { }

    var planTitle = "";
    try {
      var title = form.getAttribute("fsi_title");
      planTitle = (title && title.getValue()) || "";
    } catch (e) { }

    if (lookup && lookup[0] && String(lookup[0].entityType).toLowerCase() === "account") {
      return Promise.resolve({
        clientUrl: url, planId: recordId, planTitle: planTitle,
        accountId: normaliseGuid(lookup[0].id), accountName: lookup[0].name || ""
      });
    }

    // The lookup may not be loaded onto the form yet - read it back from the plan record.
    if (!recordId) {
      return Promise.reject(new Error("The account plan record has not been saved yet."));
    }
    return fetchJson(url + API + "fsi_accountplannings(" + recordId + ")" +
      "?$select=fsi_title,_fsi_customer_value").then(function (plan) {
        var id = plan["_fsi_customer_value"];
        if (!id) throw new Error("This account plan has no Customer set, so there is nothing to show yet.");
        return {
          clientUrl: url,
          planId: recordId,
          planTitle: plan.fsi_title || planTitle,
          accountId: normaliseGuid(id),
          accountName: plan["_fsi_customer_value@OData.Community.Display.V1.FormattedValue"] || ""
        };
      });
  }

  function fetchJson(url) {
    return fetch(url, {
      headers: {
        "Accept": "application/json",
        "OData-MaxVersion": "4.0",
        "OData-Version": "4.0",
        "Prefer": 'odata.include-annotations="OData.Community.Display.V1.FormattedValue"'
      },
      credentials: "same-origin"
    }).then(function (response) {
      if (!response.ok) {
        return response.text().then(function (text) {
          throw new Error("Dataverse " + response.status + ": " + text.slice(0, 300));
        });
      }
      return response.json();
    });
  }

  /* Read a table, tolerating tables/columns that are absent in a given environment. */
  function query(scope, entitySet, options) {
    var url = scope.clientUrl + API + entitySet + (options ? "?" + options : "");
    return fetchJson(url).then(function (result) {
      return result.value || [];
    }).catch(function (error) {
      console.warn("[AccountPlan] " + entitySet + " unavailable:", error.message);
      return [];
    });
  }

  function record(scope, entitySet, id, options) {
    var url = scope.clientUrl + API + entitySet + "(" + id + ")" + (options ? "?" + options : "");
    return fetchJson(url).catch(function (error) {
      console.warn("[AccountPlan] " + entitySet + "(" + id + ") unavailable:", error.message);
      return null;
    });
  }

  function openRecord(entityName, id) {
    var xrm = getXrm();
    if (!xrm || !id) return;
    try { xrm.Navigation.openForm({ entityName: entityName, entityId: id }); } catch (e) { }
  }

  // ---- formatting -----------------------------------------------------------
  function number(value) {
    return typeof value === "number" && isFinite(value) ? value : null;
  }

  function compact(value, currency) {
    var n = number(value);
    if (n === null) return "–";
    var prefix = currency ? currency + " " : "";
    var sign = n < 0 ? "-" : "";
    var abs = Math.abs(n);
    if (abs >= 1e9) return sign + prefix + (abs / 1e9).toFixed(abs / 1e9 >= 100 ? 0 : 1) + "bn";
    if (abs >= 1e6) return sign + prefix + (abs / 1e6).toFixed(abs / 1e6 >= 100 ? 0 : 1) + "m";
    if (abs >= 1e3) return sign + prefix + (abs / 1e3).toFixed(0) + "k";
    return sign + prefix + abs.toFixed(0);
  }

  function pct(value, digits) {
    var n = number(value);
    return n === null ? "–" : n.toFixed(typeof digits === "number" ? digits : 1) + "%";
  }

  function ratio(value, digits) {
    var n = number(value);
    return n === null ? "–" : n.toFixed(typeof digits === "number" ? digits : 2) + "x";
  }

  function dateText(value) {
    if (!value) return "–";
    var d = new Date(value);
    if (isNaN(d.getTime())) return "–";
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
  }

  function daysBetween(from, to) {
    var a = new Date(from), b = to ? new Date(to) : new Date();
    if (isNaN(a.getTime()) || isNaN(b.getTime())) return null;
    return Math.round((b - a) / 86400000);
  }

  function escapeHtml(value) {
    return String(value == null ? "" : value)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function initials(name) {
    var parts = String(name || "?").trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return "?";
    return parts[0].charAt(0).toUpperCase();
  }

  function sum(rows, field) {
    return rows.reduce(function (total, row) {
      var n = number(row[field]);
      return total + (n === null ? 0 : n);
    }, 0);
  }

  return {
    API: API, resolve: resolve, query: query, record: record, fetchJson: fetchJson,
    openRecord: openRecord, getXrm: getXrm,
    compact: compact, pct: pct, ratio: ratio, dateText: dateText, daysBetween: daysBetween,
    escapeHtml: escapeHtml, initials: initials, num: number, sum: sum
  };
}());

</script>
<script>
/* Lightweight inline-SVG chart helpers shared by the new Account Plan tabs.
 * Deliberately dependency-free: no chart library is loaded into the model-driven app. */
var APChart = (function () {
  "use strict";

  var NS = "http://www.w3.org/2000/svg";

  function css(name, fallback) {
    try {
      var value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return value || fallback;
    } catch (e) { return fallback; }
  }

  function el(tag, attrs) {
    var node = document.createElementNS(NS, tag);
    Object.keys(attrs || {}).forEach(function (key) { node.setAttribute(key, attrs[key]); });
    return node;
  }

  function svg(width, height) {
    var node = el("svg", {
      viewBox: "0 0 " + width + " " + height,
      preserveAspectRatio: "none",
      class: "chart"
    });
    node.setAttribute("role", "img");
    return node;
  }

  function extent(series, zeroBaseline) {
    var values = [];
    series.forEach(function (s) {
      s.values.forEach(function (v) { if (typeof v === "number" && isFinite(v)) values.push(v); });
    });
    if (!values.length) return { min: 0, max: 1 };
    var min = Math.min.apply(null, values);
    var max = Math.max.apply(null, values);
    if (min === max) { max = min + Math.abs(min || 1); }
    if (zeroBaseline === false) {
      // Trend charts read better when the axis hugs the data instead of anchoring at zero.
      var spread = max - min;
      return { min: min - spread * 0.35, max: max + spread * 0.25 };
    }
    min = Math.min(min, 0);
    var pad = (max - min) * 0.12;
    return { min: min, max: max + pad };
  }

  /* Category labels are centred, except the outer two which would otherwise clip. */
  function axisLabel(node, text, x, y, index, count, color) {
    var anchor = "middle";
    if (count > 1 && index === 0) anchor = "start";
    if (count > 1 && index === count - 1) anchor = "end";
    var label = el("text", {
      x: x, y: y, "text-anchor": anchor, "font-size": 10, "font-weight": 600, fill: color
    });
    label.textContent = text;
    node.appendChild(label);
  }

  /* Grouped bar chart. series = [{label, values:[], color}], labels = category names.
     options.refLine = {value, label, color} draws a horizontal threshold across the plot. */
  function bars(target, labels, series, options) {
    options = options || {};
    var host = typeof target === "string" ? document.getElementById(target) : target;
    if (!host) return;
    host.innerHTML = "";

    var W = 480, H = 140, padL = 6, padR = 6, padT = 12, padB = 20;
    var node = svg(W, H);
    var ref = options.refLine;
    /* The threshold has to be inside the domain or the line would sit off-canvas. */
    var domain = ref && typeof ref.value === "number"
      ? series.concat([{ values: [ref.value] }]) : series;
    var range = extent(domain);
    var plotH = H - padT - padB;
    var plotW = W - padL - padR;
    var groups = labels.length || 1;
    var groupW = plotW / groups;
    var barCount = series.length || 1;
    var barW = Math.max(4, (groupW * 0.62) / barCount);

    var y = function (value) {
      return padT + plotH - (value - range.min) / (range.max - range.min) * plotH;
    };

    // baseline
    node.appendChild(el("line", {
      x1: padL, x2: W - padR, y1: y(0), y2: y(0),
      stroke: css("--cp-border", "#dbe5f0"), "stroke-width": 1
    }));

    labels.forEach(function (label, gi) {
      var groupX = padL + groupW * gi + (groupW - barW * barCount) / 2;
      series.forEach(function (s, si) {
        var value = s.values[gi];
        if (typeof value !== "number" || !isFinite(value)) return;
        var top = Math.min(y(value), y(0));
        var height = Math.max(1.5, Math.abs(y(value) - y(0)));
        var rect = el("rect", {
          x: groupX + barW * si, y: top, width: barW, height: height,
          rx: Math.min(3, barW / 2), fill: s.color || css("--cp-accent", "#1e3a8a")
        });
        rect.appendChild(el("title", {})).textContent =
          s.label + " \u00b7 " + label + ": " + (options.format ? options.format(value) : value);
        node.appendChild(rect);
      });

      /* Long category names collide once there are more than a handful of groups, so
         clip each label to the width its group can actually afford and keep the full
         text available as a tooltip. */
      var budget = Math.max(3, Math.floor(groupW / 5.6));
      var shown = label.length > budget ? label.slice(0, budget - 1).replace(/[\s\-–]+$/, "") + "\u2026" : label;

      var text = el("text", {
        x: padL + groupW * gi + groupW / 2, y: H - 6,
        "text-anchor": "middle", "font-size": 10, "font-weight": 600,
        fill: css("--cp-text-soft", "#6c7d95")
      });
      text.textContent = shown;
      if (shown !== label) text.appendChild(el("title", {})).textContent = label;
      node.appendChild(text);    });

    if (ref && typeof ref.value === "number" && isFinite(ref.value)) {
      var refY = y(ref.value);
      node.appendChild(el("line", {
        x1: padL, x2: W - padR, y1: refY, y2: refY,
        stroke: ref.color || css("--cp-danger", "#dc2626"),
        "stroke-width": 1.5, "stroke-dasharray": "5 3"
      }));
      if (ref.label) {
        var refText = el("text", {
          x: W - padR, y: Math.max(9, refY - 4), "text-anchor": "end",
          "font-size": 9.5, "font-weight": 700,
          fill: ref.color || css("--cp-danger", "#dc2626")
        });
        refText.textContent = ref.label;
        node.appendChild(refText);
      }
    }

    host.appendChild(node);
  }

  /* Line / area chart for a single trend series. */
  function line(target, labels, values, options) {
    options = options || {};
    var host = typeof target === "string" ? document.getElementById(target) : target;
    if (!host) return;
    host.innerHTML = "";

    var W = 480, H = 140, padL = 8, padR = 8, padT = 14, padB = 20;
    var node = svg(W, H);
    var range = extent([{ values: values }], options.zeroBaseline === true);
    var plotH = H - padT - padB;
    var plotW = W - padL - padR;
    var step = values.length > 1 ? plotW / (values.length - 1) : 0;
    var color = options.color || css("--cp-accent", "#1e3a8a");

    var points = values.map(function (value, i) {
      return {
        x: padL + step * i,
        y: padT + plotH - (value - range.min) / (range.max - range.min) * plotH,
        v: value
      };
    }).filter(function (p) { return isFinite(p.y); });

    if (!points.length) { host.appendChild(node); return; }

    var path = points.map(function (p, i) { return (i ? "L" : "M") + p.x + " " + p.y; }).join(" ");
    var area = path + " L " + points[points.length - 1].x + " " + (padT + plotH) +
      " L " + points[0].x + " " + (padT + plotH) + " Z";

    node.appendChild(el("path", { d: area, fill: color, opacity: 0.12 }));
    node.appendChild(el("path", {
      d: path, fill: "none", stroke: color, "stroke-width": 2.4,
      "stroke-linecap": "round", "stroke-linejoin": "round"
    }));

    points.forEach(function (p, i) {
      var dot = el("circle", { cx: p.x, cy: p.y, r: 3.4, fill: color });
      dot.appendChild(el("title", {})).textContent =
        (labels[i] || "") + ": " + (options.format ? options.format(p.v) : p.v);
      node.appendChild(dot);
      axisLabel(node, labels[i] || "", p.x, H - 6, i, points.length,
        css("--cp-text-soft", "#6c7d95"));
    });

    host.appendChild(node);
  }

  /* Horizontal stacked bar for composition (e.g. income mix). */
  function stacked(target, segments, options) {
    options = options || {};
    var host = typeof target === "string" ? document.getElementById(target) : target;
    if (!host) return;
    host.innerHTML = "";
    var total = segments.reduce(function (sum, s) { return sum + Math.max(0, s.value || 0); }, 0);
    if (!total) { host.innerHTML = '<div class="empty">No data to chart.</div>'; return; }

    var W = 480, H = 34;
    var node = svg(W, H);
    node.style.height = "34px";
    var x = 0;
    segments.forEach(function (s) {
      var width = Math.max(0, s.value || 0) / total * W;
      if (width <= 0) return;
      var rect = el("rect", { x: x, y: 6, width: width, height: 22, fill: s.color, rx: 3 });
      rect.appendChild(el("title", {})).textContent =
        s.label + ": " + (options.format ? options.format(s.value) : s.value) +
        " (" + (s.value / total * 100).toFixed(1) + "%)";
      node.appendChild(rect);
      x += width;
    });
    host.appendChild(node);
  }

  /* Semi-circular gauge used for RAROC vs hurdle and service health. */
  function gauge(target, value, max, options) {
    options = options || {};
    var host = typeof target === "string" ? document.getElementById(target) : target;
    if (!host) return;
    host.innerHTML = "";

    var W = 240, H = 132, cx = 120, cy = 112, r = 92;
    var node = svg(W, H);
    node.style.height = "132px";

    function arc(fromPct, toPct, color, width) {
      var a0 = Math.PI * (1 + Math.min(1, Math.max(0, fromPct)));
      var a1 = Math.PI * (1 + Math.min(1, Math.max(0, toPct)));
      var large = (a1 - a0) > Math.PI ? 1 : 0;
      var d = "M " + (cx + r * Math.cos(a0)) + " " + (cy + r * Math.sin(a0)) +
        " A " + r + " " + r + " 0 " + large + " 1 " +
        (cx + r * Math.cos(a1)) + " " + (cy + r * Math.sin(a1));
      node.appendChild(el("path", {
        d: d, fill: "none", stroke: color, "stroke-width": width || 14, "stroke-linecap": "round"
      }));
    }

    var fraction = max ? Math.min(1, Math.max(0, value / max)) : 0;
    arc(0, 1, css("--cp-surface-soft", "#f2f7fc"), 14);
    if (fraction > 0.012) {
      arc(0, fraction, options.color || css("--cp-accent", "#1e3a8a"), 14);
    }

    if (typeof options.marker === "number" && max) {
      var mf = Math.min(1, Math.max(0, options.marker / max));
      var angle = Math.PI * (1 + mf);
      node.appendChild(el("line", {
        x1: cx + (r - 12) * Math.cos(angle), y1: cy + (r - 12) * Math.sin(angle),
        x2: cx + (r + 12) * Math.cos(angle), y2: cy + (r + 12) * Math.sin(angle),
        stroke: css("--cp-text", "#172033"), "stroke-width": 2.4, "stroke-linecap": "round"
      }));
      if (options.markerLabel) {
        var ml = el("text", {
          x: cx + (r + 18) * Math.cos(angle), y: cy + (r + 18) * Math.sin(angle) + 3,
          "text-anchor": mf > 0.5 ? "start" : "end", "font-size": 9, "font-weight": 700,
          fill: css("--cp-text-soft", "#6c7d95")
        });
        ml.textContent = options.markerLabel;
        node.appendChild(ml);
      }
    }

    if (options.scale !== false) {
      [[cx - r, "start", options.minLabel || "0"],
       [cx + r, "end", options.maxLabel || String(Math.round(max * 10) / 10)]].forEach(function (item) {
        var tick = el("text", {
          x: item[0], y: cy + 14, "text-anchor": item[1], "font-size": 9, "font-weight": 600,
          fill: css("--cp-text-soft", "#6c7d95")
        });
        tick.textContent = item[2];
        node.appendChild(tick);
      });
    }

    var main = el("text", {
      x: cx, y: cy - 16, "text-anchor": "middle", "font-size": 30, "font-weight": 700,
      fill: css("--cp-text", "#172033")
    });
    main.textContent = options.label || String(value);
    node.appendChild(main);

    if (options.caption) {
      var caption = el("text", {
        x: cx, y: cy + 6, "text-anchor": "middle", "font-size": 11, "font-weight": 600,
        fill: css("--cp-text-soft", "#6c7d95")
      });
      caption.textContent = options.caption;
      node.appendChild(caption);
    }
    host.appendChild(node);
  }

  var SERIES = ["#1e3a8a", "#2f6fb5", "#5aa0dd", "#0e7490", "#7c3aed", "#64748b"];

  /* Categorical colour for chart series i, resolved from the shared theme tokens. */
  function series(index) {
    var i = ((index % SERIES.length) + SERIES.length) % SERIES.length;
    return css("--cp-series-" + (i + 1), SERIES[i]);
  }

  return { bars: bars, line: line, stacked: stacked, gauge: gauge, css: css, series: series };
}());

</script>
<script>
/* Relationship Economics tab.
 * Reads fsi_relationshipeconomics (one row per product category per period) and derives the
 * relationship P&L and RAROC. Calculations are intentionally simple and explainable - this is a
 * POC presentation layer, not a production profitability engine.
 */
(function () {
  "use strict";

  var CUR = "AED";
  var CATEGORY = {
    100000000: "Lending", 100000001: "Trade Finance", 100000002: "Cash Management",
    100000003: "FX & Treasury", 100000004: "Deposits", 100000005: "Other"
  };

  var state = { byPeriod: {}, periods: [], account: null };

  function show(message) {
    var el = document.getElementById("state");
    if (message === null) {
      el.hidden = true;
      document.getElementById("content").hidden = false;
      return;
    }
    el.hidden = false;
    el.textContent = message;
    document.getElementById("content").hidden = true;
  }

  function m(value) { return APCtx.num(value) === null ? "–" : APCtx.compact(value, CUR); }

  function kpi(label, value, meta, tone) {
    return '<div class="card kpi ' + (tone || "") + '">' +
      '<div class="kpi-label">' + label + "</div>" +
      '<div class="kpi-value sm">' + value + "</div>" +
      '<div class="kpi-meta">' + (meta || "&nbsp;") + "</div></div>";
  }

  function n(value) { return APCtx.num(value) || 0; }

  function normalise(row) {
    var nii = n(row.fsi_netinterestincome);
    var fee = n(row.fsi_feeincome);
    var fx = n(row.fsi_fxtreasuryincome);
    var trade = n(row.fsi_tradeincome);
    var cof = n(row.fsi_costoffunds);
    var cts = n(row.fsi_costtoserve);
    var ecl = n(row.fsi_expectedcreditloss);
    var capital = n(row.fsi_capitalconsumed);
    var revenue = nii + fee + fx + trade;
    var net = revenue - cof - cts - ecl;
    var storedRaroc = APCtx.num(row.fsi_raroc);
    return {
      category: CATEGORY[row.fsi_productcategory] || "Other",
      period: row.fsi_period || "",
      sort: APCtx.num(row.fsi_sortorder) || 99,
      nii: nii, fee: fee, fx: fx, trade: trade, revenue: revenue,
      cof: cof, cts: cts, ecl: ecl, capital: capital, net: net,
      // RAROC is always derived from the stored components so the product rows,
      // the totals row and the gauge can never disagree with each other.
      raroc: capital ? net / capital * 100 : storedRaroc,
      hurdle: APCtx.num(row.fsi_hurdlerate)
    };
  }

  function aggregate(rows) {
    var total = {
      nii: 0, fee: 0, fx: 0, trade: 0, revenue: 0,
      cof: 0, cts: 0, ecl: 0, capital: 0, net: 0
    };
    rows.forEach(function (r) {
      Object.keys(total).forEach(function (key) { total[key] += r[key]; });
    });
    total.raroc = total.capital ? total.net / total.capital * 100 : null;
    var hurdles = rows.map(function (r) { return r.hurdle; })
      .filter(function (h) { return h !== null && h !== undefined; });
    total.hurdle = hurdles.length ? hurdles[0] : null;
    return total;
  }

  // ---- render ---------------------------------------------------------------
  function renderGauge(total, accountRaroc) {
    var raroc = total.raroc !== null ? total.raroc : accountRaroc;
    var hurdle = total.hurdle !== null ? total.hurdle : 15;
    var max = Math.max(raroc || 0, hurdle) * 1.45 || 30;
    var meets = raroc !== null && raroc >= hurdle;

    APChart.gauge("rarocGauge", raroc || 0, max, {
      label: raroc === null ? "–" : raroc.toFixed(1) + "%",
      caption: "Hurdle " + hurdle.toFixed(1) + "%",
      /* Blue when the hurdle is met so the screen stays on-palette; only a shortfall
         earns an alarm colour. */
      color: APChart.css(meets ? "--cp-accent" : "--cp-danger", "#1e3a8a"),
      marker: hurdle,
      markerLabel: "Hurdle",
      minLabel: "0%",
      maxLabel: max.toFixed(0) + "%"
    });

    document.getElementById("rarocSub").textContent = "Risk adjusted return on capital";
    document.getElementById("rarocStats").innerHTML = [
      ["Capital committed", m(total.capital)],
      ["Net profit", m(total.net)],
      ["Return on revenue", total.revenue ? APCtx.pct(total.net / total.revenue * 100) : "–"],
      ["Hurdle rate", hurdle.toFixed(1) + "%"]
    ].map(function (pair) {
      return '<div class="stat-row"><span>' + pair[0] + "</span><span>" + pair[1] + "</span></div>";
    }).join("");
    document.getElementById("rarocVerdict").innerHTML = raroc === null
      ? '<span class="pill mute">Not calculable</span>'
      : '<span class="pill ' + (meets ? "ok" : "bad") + '">' +
        (meets ? "+" : "") + (raroc - hurdle).toFixed(1) + "pp vs hurdle</span>" +
        '<div class="kpi-meta" style="margin-top:6px;">' +
        (meets
          ? "The relationship earns an adequate return on the capital committed."
          : "The relationship is below the hurdle rate - repricing or capital relief required.") +
        "</div>";
  }

  function renderPl(total) {
    document.getElementById("plRow").innerHTML =
      kpi("Total relationship revenue", m(total.revenue), "Across all products", "good") +
      kpi("Net interest income", m(total.nii),
        total.revenue ? APCtx.pct(total.nii / total.revenue * 100) + " of revenue" : "&nbsp;") +
      kpi("Fee income", m(total.fee),
        total.revenue ? APCtx.pct(total.fee / total.revenue * 100) + " of revenue" : "&nbsp;") +
      kpi("FX / Treasury income", m(total.fx), "Trading and hedging") +
      kpi("Trade finance income", m(total.trade), "Documentary and guarantees") +
      kpi("Cost of funds", m(total.cof), "Funding charge", "warn") +
      kpi("Cost to serve", m(total.cts), "Operations and coverage", "warn") +
      kpi("Expected credit loss", m(total.ecl), "Risk cost", "bad") +
      kpi("Capital consumption", m(total.capital), "Regulatory capital committed") +
      kpi("Net relationship profitability", m(total.net),
        total.revenue ? APCtx.pct(total.net / total.revenue * 100) + " net margin" : "&nbsp;", "good");
  }

  function renderMix(total) {
    var segments = [
      { label: "Net interest income", value: total.nii },
      { label: "Fee income", value: total.fee },
      { label: "FX / Treasury", value: total.fx },
      { label: "Trade finance", value: total.trade }
    ].filter(function (s) { return s.value > 0; });
    segments.forEach(function (s, i) { s.color = APChart.series(i); });

    APChart.stacked("chartMix", segments, { format: m });
    document.getElementById("mixLegend").innerHTML = segments.map(function (s) {
      return '<span class="legend-key"><i style="background:' + s.color + '"></i>' +
        APCtx.escapeHtml(s.label) + " \u00b7 " + m(s.value) + "</span>";
    }).join("");
  }

  function renderRarocChart(rows, hurdle) {
    var withRaroc = rows.filter(function (r) { return r.raroc !== null; })
      .sort(function (a, b) { return b.raroc - a.raroc; });
    if (!withRaroc.length) {
      document.getElementById("chartRaroc").innerHTML = '<div class="empty">No RAROC recorded.</div>';
      return;
    }
    /* The hurdle is a single threshold, so it reads as a reference line rather than a
       bar repeated once per product. */
    APChart.bars("chartRaroc",
      withRaroc.map(function (r) { return r.category.split(/\s*[&/]\s*/)[0]; }),
      [
        { label: "RAROC", values: withRaroc.map(function (r) { return r.raroc; }),
          color: APChart.series(0) }
      ], {
        format: function (v) { return v.toFixed(1) + "%"; },
        refLine: { value: hurdle, label: "Hurdle " + hurdle.toFixed(1) + "%",
                   color: APChart.css("--cp-danger", "#dc2626") }
      });
  }

  function renderProducts(rows, hurdle) {
    var sorted = rows.slice().sort(function (a, b) { return a.sort - b.sort; });
    var total = aggregate(sorted);

    function row(r, isTotal) {
      var gap = r.raroc === null ? null : r.raroc - hurdle;
      return "<tr" + (isTotal ? ' class="total"' : "") + ">" +
        '<td class="strong">' + APCtx.escapeHtml(r.category) + "</td>" +
        '<td class="num">' + m(r.nii) + "</td>" +
        '<td class="num">' + m(r.fee) + "</td>" +
        '<td class="num">' + m(r.fx) + "</td>" +
        '<td class="num">' + m(r.trade) + "</td>" +
        '<td class="num strong">' + m(r.revenue) + "</td>" +
        '<td class="num">' + m(r.cof) + "</td>" +
        '<td class="num">' + m(r.cts) + "</td>" +
        '<td class="num">' + m(r.ecl) + "</td>" +
        '<td class="num strong">' + m(r.net) + "</td>" +
        '<td class="num">' + m(r.capital) + "</td>" +
        '<td class="num">' + (r.raroc === null ? "–" : APCtx.pct(r.raroc)) + "</td>" +
        "<td>" + (gap === null
          ? '<span class="pill mute">–</span>'
          : '<span class="pill ' + (gap >= 0 ? "ok" : "bad") + '">' +
            (gap >= 0 ? "+" : "") + gap.toFixed(1) + "pp</span>") + "</td>" +
        "</tr>";
    }

    total.category = "Total relationship";
    document.getElementById("productBody").innerHTML =
      sorted.map(function (r) { return row(r, false); }).join("") + row(total, true);

    var best = sorted.filter(function (r) { return r.raroc !== null; })
      .sort(function (a, b) { return b.raroc - a.raroc; })[0];
    var worst = sorted.filter(function (r) { return r.raroc !== null; })
      .sort(function (a, b) { return a.raroc - b.raroc; })[0];
    document.getElementById("productSub").textContent = best && worst
      ? "Strongest return: " + best.category + " (" + APCtx.pct(best.raroc) + ") \u00b7 " +
        "weakest: " + worst.category + " (" + APCtx.pct(worst.raroc) + ")"
      : "";
  }

  function renderTrend() {
    var periods = state.periods;
    if (periods.length < 2) {
      document.getElementById("trendCard").hidden = true;
      return;
    }
    document.getElementById("trendCard").hidden = false;
    var totals = periods.map(function (p) { return aggregate(state.byPeriod[p]); });
    APChart.line("chartTrendProfit", periods, totals.map(function (t) { return t.net; }),
      { format: m, color: APChart.series(2) });
    APChart.line("chartTrendRaroc", periods, totals.map(function (t) { return t.raroc; }),
      { format: function (v) { return v.toFixed(1) + "%"; }, color: APChart.series(0) });
  }

  function renderPeriod(period) {
    var rows = state.byPeriod[period] || [];
    var total = aggregate(rows);
    var hurdle = total.hurdle !== null ? total.hurdle : 15;
    document.getElementById("plSub").textContent = period + " \u00b7 stated in " + CUR;
    renderGauge(total, state.account ? APCtx.num(state.account.fsi_raroc_pct) : null);
    renderPl(total);
    renderMix(total);
    renderRarocChart(rows, hurdle);
    renderProducts(rows, hurdle);
  }

  // ---- load -----------------------------------------------------------------
  APCtx.resolve().then(function (scope) {
    document.getElementById("pgTitle").textContent =
      (scope.accountName || "Customer") + " \u2014 Relationship Economics";

    return Promise.all([
      APCtx.record(scope, "accounts", scope.accountId,
        "$select=name,fsi_raroc_pct,fsi_banksytdrevenue,fsi_total_fab_exposure"),
      APCtx.query(scope, "fsi_relationshipeconomicses",
        "$select=fsi_relationshipeconomicsid,fsi_name,fsi_productcategory,fsi_period," +
        "fsi_netinterestincome,fsi_feeincome,fsi_fxtreasuryincome,fsi_tradeincome," +
        "fsi_costoffunds,fsi_costtoserve,fsi_expectedcreditloss,fsi_capitalconsumed," +
        "fsi_raroc,fsi_hurdlerate,fsi_sortorder&$filter=_fsi_account_value eq " + scope.accountId)
    ]).then(function (results) {
      state.account = results[0];
      var rows = results[1].map(normalise);
      if (!rows.length) {
        show("No relationship economics have been recorded for " +
          (scope.accountName || "this customer") + " yet.");
        return;
      }

      rows.forEach(function (r) {
        (state.byPeriod[r.period] = state.byPeriod[r.period] || []).push(r);
      });
      state.periods = Object.keys(state.byPeriod).sort();

      var select = document.getElementById("periodSelect");
      select.innerHTML = state.periods.slice().reverse().map(function (p) {
        return '<option value="' + APCtx.escapeHtml(p) + '">' + APCtx.escapeHtml(p) + "</option>";
      }).join("");
      select.addEventListener("change", function () { renderPeriod(select.value); });

      renderPeriod(select.value || state.periods[state.periods.length - 1]);
      renderTrend();
      show(null);
    });
  }).catch(function (error) {
    console.error("[RelationshipEconomics]", error);
    show(error && error.message ? error.message : "Unable to load relationship economics.");
  });
}());

</script>
