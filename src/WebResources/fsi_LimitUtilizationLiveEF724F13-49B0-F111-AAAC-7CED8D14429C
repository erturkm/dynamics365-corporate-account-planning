<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Limit Utilization</title>
<script>
/* amCharts loader: prefer libraries hosted in this org so a demo never depends
   on internet reachability; fall back to the public CDN if they are missing. */
(function(){
  var LOCAL = [ "fsi_am5_index.js", "fsi_am5_xy.js", "fsi_am5_percent.js",
                "fsi_am5_radar.js", "fsi_am5_themes_animated.js" ];
  var CDN   = [ "https://cdn.amcharts.com/lib/5/index.js",
                "https://cdn.amcharts.com/lib/5/xy.js",
                "https://cdn.amcharts.com/lib/5/percent.js",
                "https://cdn.amcharts.com/lib/5/radar.js",
                "https://cdn.amcharts.com/lib/5/themes/Animated.js" ];

  // /WebResources/fsi_LimitUtilizationLive -> /WebResources/
  var base = location.pathname.replace(/[^/]*$/, "");
  if (!/\/WebResources\/$/i.test(base)) base = "/WebResources/";

  function one(src){
    return new Promise(function(res, rej){
      var s = document.createElement("script");
      s.src = src; s.async = false;          // async=false preserves execution order
      s.onload = function(){ res(src); };
      s.onerror = function(){ rej(new Error(src)); };
      document.head.appendChild(s);
    });
  }
  // Load strictly in order: index.js must evaluate before xy/percent/radar.
  function chain(list){
    return list.reduce(function(p, src){ return p.then(function(){ return one(src); }); },
                       Promise.resolve());
  }

  window.__am5Ready = chain(LOCAL.map(function(n){ return base + n; }))
    .catch(function(e){
      console.warn("amCharts: org-hosted libraries unavailable (" + e.message +
                   "), falling back to CDN.");
      // Anything that did load is harmless to re-load; order is still enforced.
      return chain(CDN);
    })
    .then(function(){
      if (typeof am5 === "undefined") throw new Error("amCharts failed to load");
    });
})();
</script>
<style>
  :root{
    --ink:#111827; --muted:#6b7280; --line:#e5e7eb; --soft:#f8fafc;
    --blue:#2563eb; --blue-d:#1d4ed8; --green:#059669;
    --shadow:0 10px 24px rgba(17,24,39,.07);
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:#fff;}
  body{font-family:"Segoe UI",system-ui,-apple-system,Arial,sans-serif;color:var(--ink);}

  .wrap{height:600px;display:flex;flex-direction:column;gap:8px;padding:8px 10px;background:#fff;}

  /* ---------- header ---------- */
  .hdr{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .dot{width:9px;height:9px;border-radius:99px;background:var(--blue)}
  .title{font-size:13px;font-weight:800;letter-spacing:.2px}
  .sub{font-size:11px;color:var(--muted)}
  .spacer{flex:1}
  .seg{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#fff}
  .seg button{border:0;background:#fff;font:inherit;font-size:11px;font-weight:700;color:var(--muted);
    padding:5px 10px;cursor:pointer;border-right:1px solid var(--line)}
  .seg button:last-child{border-right:0}
  .seg button.on{background:#eff6ff;color:var(--blue-d)}
  .seg button:disabled{opacity:.4;cursor:default}
  .btn{border:1px solid var(--line);background:#fff;border-radius:10px;padding:5px 10px;
    font-size:11px;font-weight:700;cursor:pointer;color:var(--ink)}
  .badge{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:700;
    padding:4px 8px;border-radius:99px;border:1px solid #fde68a;background:#fffbeb;color:#92400e;cursor:help}

  /* ---------- main grid ---------- */
  .grid{flex:1;display:grid;grid-template-columns:216px minmax(0,1fr) 268px;gap:8px;min-height:0}
  .card{border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:var(--shadow);
    display:flex;flex-direction:column;min-height:0;overflow:hidden}
  .card h4{margin:0;padding:8px 10px 6px;font-size:11px;font-weight:800;color:#334155;
    display:flex;align-items:center;justify-content:space-between;gap:6px}
  .card h4 span.h{font-size:10px;font-weight:600;color:var(--muted)}
  .chart{flex:1;min-height:0}
  .chip{display:inline-block;width:10px;height:3px;border-radius:2px;
        vertical-align:middle;margin-right:3px}

  /* left rail */
  .rail{display:flex;flex-direction:column;gap:8px;min-height:0}
  .gaugeCard{flex:0 0 168px;position:relative}
  .gaugeCard .chart{padding-bottom:16px}
  .gaugeVal{position:absolute;left:0;right:0;top:58%;text-align:center;
    font-size:24px;font-weight:900;line-height:1;pointer-events:none}
  .gaugeCap{position:absolute;left:0;right:0;bottom:6px;text-align:center;
    font-size:9px;font-weight:700;color:var(--muted);pointer-events:none}
  .kpis{flex:1;display:grid;grid-template-rows:repeat(3,1fr);gap:8px;min-height:0}
  .kpi{border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:var(--shadow);
    padding:7px 10px;display:flex;flex-direction:column;justify-content:center}
  .kpi .l{font-size:10px;color:var(--muted);font-weight:600}
  .kpi .v{font-size:16px;font-weight:900;line-height:1.2;margin-top:1px}
  .kpi .d{font-size:10px;font-weight:700;margin-top:1px}

  /* right rail */
  .rrail{display:flex;flex-direction:column;gap:8px;min-height:0}
  .donutCard{flex:0 0 186px}
  .dlegend{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;padding:0 8px 7px}
  .dlegend span{display:inline-flex;align-items:center;gap:4px;font-size:9.5px;font-weight:700;color:#475569}
  .dlegend i{width:8px;height:8px;border-radius:3px;display:inline-block}
  .concCard{flex:1;min-height:0;position:relative}
  .concCard::after{content:"";position:absolute;left:1px;right:1px;bottom:1px;height:16px;
    border-radius:0 0 11px 11px;pointer-events:none;
    background:linear-gradient(180deg,rgba(255,255,255,0),#fff)}
  .conc{overflow:auto;padding:2px 10px 12px}
  .crow{display:grid;grid-template-columns:1fr 46px;gap:6px;align-items:center;padding:4px 0;
    border-bottom:1px dashed #eef2f7;cursor:pointer}
  .crow:last-child{border-bottom:0}
  .crow:hover{background:var(--soft)}
  .cname{font-size:10.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .cmeta{font-size:9.5px;color:var(--muted)}
  .cbar{height:4px;border-radius:99px;background:#eef2f7;margin-top:3px;overflow:hidden}
  .cbar i{display:block;height:100%;border-radius:99px}
  .cpct{font-size:11px;font-weight:900;text-align:right}

  /* footer table */
  .foot{flex:0 0 150px;border:1px solid var(--line);border-radius:12px;background:#fff;
    box-shadow:var(--shadow);display:flex;flex-direction:column;overflow:hidden}
  .foot .th,.foot .tr{display:grid;
    grid-template-columns:1.6fr .8fr .8fr .8fr 1.5fr .9fr .8fr;gap:8px;padding:5px 10px;align-items:center}
  .foot .th{background:#fafafa;border-bottom:1px solid var(--line);font-size:10px;font-weight:800;color:#334155}
  .foot .tb{overflow:auto}
  .foot .tr{border-bottom:1px dashed #f1f5f9;font-size:10.5px}
  .foot .tr:hover{background:var(--soft)}
  .num{font-variant-numeric:tabular-nums;text-align:right}
  .chip{display:inline-block;font-size:9px;font-weight:800;padding:1.5px 6px;border-radius:99px}
  .c-f{background:#eff6ff;color:#1d4ed8}
  .c-nf{background:#f0fdf4;color:#15803d}
  .c-o{background:#faf5ff;color:#6d28d9}
  .mbar{height:5px;border-radius:99px;background:#eef2f7;overflow:hidden}
  .mbar i{display:block;height:100%;border-radius:99px}
  .note{font-size:10px;color:var(--muted);padding:4px 10px;border-top:1px solid var(--line);background:#fafafa}

  /* ---------- states ---------- */
  .state{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;
    justify-content:center;gap:10px;background:#fff;z-index:20;text-align:center;padding:20px}
  .state.on{display:flex}
  .state h3{margin:0;font-size:14px;font-weight:800}
  .state p{margin:0;font-size:12px;color:var(--muted);max-width:440px;line-height:1.5}
  .spin{width:26px;height:26px;border-radius:99px;border:3px solid #e5e7eb;
    border-top-color:var(--blue);animation:sp .8s linear infinite}
  @keyframes sp{to{transform:rotate(360deg)}}
  .skel{width:100%;height:100%;display:grid;
    grid-template-columns:216px minmax(0,1fr) 268px;gap:8px;padding:34px 10px 10px;opacity:.5}
  .skel div{background:linear-gradient(90deg,#f1f5f9,#e2e8f0,#f1f5f9);background-size:200% 100%;
    border-radius:12px;animation:sh 1.3s ease-in-out infinite}
  @keyframes sh{0%{background-position:200% 0}100%{background-position:-200% 0}}
  .errbox{border:1px solid #fecaca;background:#fef2f2;color:#991b1b;border-radius:10px;
    padding:8px 12px;font-size:11px;max-width:520px;text-align:left;word-break:break-word;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
  .host{position:relative;height:600px}
</style>
</head>
<body>

<div class="host">

  <!-- ============ LOADING ============ -->
