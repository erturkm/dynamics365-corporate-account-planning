      var lines = [];
      s.fields.forEach(function (f) {
        var v = values ? values[f.id] : null;
        if (v === null || v === undefined || v === "" || (Array.isArray(v) && !v.length)) return;
        if (Array.isArray(v)) v = v.join(", ");
        if (f.type === "boolean") v = v ? "Yes" : "No";
        if (f.type === "currency") v = "AED " + v;
        if (f.type === "percentage") v = v + "%";
        if (f.type === "date") v = fmtDate(v);
        lines.push("- " + f.label + ": " + v);
      });
      if (lines.length) out.push("## " + s.title + "\n" + lines.join("\n"));
    });
    return out.join("\n\n");
  }

  /* ============================ navigation ============================ */
  function openRequest(id) {
    var X = xrm();
    if (!X) { return; }
    X.Navigation.openForm({ entityName: "fsi_informationrequest", entityId: id });
  }
  function openWebResourceDialog(name, data, opts) {
    var X = xrm();
    opts = opts || {};
    return X.Navigation.navigateTo(
      { pageType: "webresource", webresourceName: name, data: typeof data === "string" ? data : JSON.stringify(data || {}) },
      { target: 2, position: 1, width: opts.width || { value: 1080, unit: "px" }, height: opts.height || { value: 820, unit: "px" }, title: opts.title || "Request Information" }
    );
  }
  /** Read the "data" parameter passed into a web resource dialog / form. */
  function pageData() {
    var q = new URLSearchParams(window.location.search);
    var d = q.get("data") || q.get("Data") || "";
    if (!d) return {};
    try { return JSON.parse(decodeURIComponent(d)); } catch (e) {}
    try { return JSON.parse(d); } catch (e) {}
    return {};
  }

  /* ============================ AI service ============================ */
  /**
   * AI calls go through an HTTP-triggered Power Automate flow whose URL is stored
   * in a Dataverse configuration record (never hardcoded in the web resource).
   * Config record: fsi_informationrequesttemplate where fsi_name = '__CONFIG__'
   * and fsi_formjson = { "aiEndpoint": "https://prod-xx.../invoke?..." }
   */
  var _cfg = null;
  function getConfig() {
    if (_cfg) return Promise.resolve(_cfg);
    return DV.retrieveMultiple("fsi_informationrequesttemplates",
      "?$select=fsi_formjson&$filter=fsi_name eq '__CONFIG__'&$top=1")
      .then(function (r) {
        var c = {};
        if (r.length && r[0].fsi_formjson) { try { c = JSON.parse(r[0].fsi_formjson); } catch (e) {} }
        _cfg = c; return c;
      }).catch(function () { _cfg = {}; return _cfg; });
  }

  function aiCall(action, payload) {
    return getConfig().then(function (c) {
      if (!c.aiEndpoint) {
        var e = new Error("AI service is not configured for this environment.");
        e.code = "NO_AI"; throw e;
      }
      return fetch(c.aiEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.assign({ action: action }, payload || {}))
      }).then(function (r) {
        if (!r.ok) return r.text().then(function (t) { throw new Error("AI service error: " + r.status + " " + t.slice(0, 300)); });
        return r.json();
      });
    });
  }
  function parseAiJson(res) {
    var raw = res;
    if (res && typeof res === "object") raw = res.result || res.output || res.content || res.text || res;
    if (typeof raw === "object") return raw;
    var s = String(raw || "").trim();
    s = s.replace(/^```(?:json)?\s*/i, "").replace(/```\s*$/, "");
    var a = s.indexOf("{"), b = s.lastIndexOf("}");
    if (a >= 0 && b > a) s = s.slice(a, b + 1);
    return JSON.parse(s);
  }

  /* ============================ export ============================ */
  G.GTI = {
    xrm: xrm, clientUrl: clientUrl, DV: DV,
    esc: esc, el: el, $: $, $$: $$, uid: uid, toast: toast, icon: icon, ICONS: ICONS,
    fmtDate: fmtDate, fmtDateTime: fmtDateTime, fmtMoney: fmtMoney, toISODate: toISODate, daysUntil: daysUntil,
    CATEGORY: CATEGORY, TEAMTYPE: TEAMTYPE, STATUS: STATUS, STATUS_V: STATUS_V, STATUS_CLS: STATUS_CLS,
    TEAM_FOR_TYPE: TEAM_FOR_TYPE, statusBadge: statusBadge,
    FIELD_TYPES: FIELD_TYPES, normalizeForm: normalizeForm, countFields: countFields,
    Renderer: Renderer, responseToText: responseToText,
    openRequest: openRequest, openWebResourceDialog: openWebResourceDialog, pageData: pageData,
    getConfig: getConfig, aiCall: aiCall, parseAiJson: parseAiJson
  };
})(window);
</script>
<script>
(function(){
  "use strict";
  var G = window.GTI, $ = G.$, $$ = G.$$, esc = G.esc;

  var ctx = G.pageData();               /* planId, planTitle, accountId, accountName, ownerId */
  var step = 1, mode = null;
  var templates = [], selTpl = null, cat = "all", search = "";
  var form = null, formBeforeAi = null, editing = false;
  var teams = [], users = [], me = null;

  /* ---------------- shell ---------------- */
  function setSteps(){
    var labels = [ "Choose approach",
                   mode === "template" ? "Select template" : mode === "describe" ? "Describe need" : "Build questions",
                   "Review questionnaire", "Send" ];
    $("#steps").innerHTML = labels.map(function(l,i){
      var n = i + 1, cls = n === step ? "on" : (n < step ? "done" : "");
      return (i ? '<span class="step-sep"></span>' : "") +
        '<span class="step ' + cls + '"><span class="sn">' + (n < step ? "✓" : n) + '</span>' + esc(l) + '</span>';
    }).join("");
  }

  function show(){
    ["s1","s2t","s2d","s3","s4"].forEach(function(id){ $("#"+id).classList.add("hidden"); });
    if (step === 1) $("#s1").classList.remove("hidden");
    else if (step === 2) {
      if (mode === "template") $("#s2t").classList.remove("hidden");
      else if (mode === "describe") $("#s2d").classList.remove("hidden");
      else { step = 3; return show(); }
    }
    else if (step === 3) $("#s3").classList.remove("hidden");
    else $("#s4").classList.remove("hidden");

    $("#btnBack").classList.toggle("hidden", step === 1);
    $("#btnNext").classList.toggle("hidden", step === 1 || (step === 2 && mode !== "template"));
    $("#btnDraft").classList.toggle("hidden", step < 3);
    $("#btnNext").innerHTML = step === 4 ? (G.icon("send",15) + " Send Request") : "Continue";
    $("#btnNext").className = "btn btn-lg " + (step === 4 ? "btn-ok" : "btn-primary");
    $("#barHint").textContent = step === 2 && mode === "template" ? "Select a template to continue"
                              : step === 3 ? "Review and adjust before sending" : "";
    setSteps();
    window.scrollTo({ top:0, behavior:"smooth" });
  }

  /* ---------------- step 1 ---------------- */
  $("#mi1").innerHTML = G.icon("copy",23,1.6);  $("#mb1").innerHTML = "Browse gallery " + G.icon("back",13).replace('d="M19 12H5"','d="M5 12h14"').replace('d="M12 19l-7-7 7-7"','d="M12 5l7 7-7 7"');
  $("#mi2").innerHTML = G.icon("sparkle",23,1.6); $("#mb2").innerHTML = "Ask Copilot";
  $("#mi3").innerHTML = G.icon("blank",23,1.6);   $("#mb3").innerHTML = "Build my own";
  $("#tSearchIco").innerHTML = G.icon("search",14);
  $("#btnGenerate").innerHTML = G.icon("sparkle",15) + " Generate with Copilot";
  $("#btnCustomize").innerHTML = G.icon("sparkle",14) + " Customize with Copilot";
  $("#aiHdr").innerHTML = G.icon("sparkle",14) + " Ask Copilot to customize this questionnaire";
  $("#btnAddSec").innerHTML = G.icon("plus",13) + " Add section";
  $("#btnBack").innerHTML = G.icon("back",14) + " Back";

  $$(".mode").forEach(function(m){
    m.addEventListener("click", function(){
      mode = m.getAttribute("data-m");
      if (mode === "blank") {
        form = { title:"", description:"", schemaVersion:"1.0",
                 sections:[{ title:"Section 1", fields:[{ id:"q1", label:"Question 1", type:"text", required:false }] }] };
        selTpl = null; editing = true; step = 3; paintReview(); show(); return;
      }
      step = 2;
      if (mode === "template") paintGallery();
      show();
    });
  });

  /* ---------------- step 2a : gallery ---------------- */
  function loadTemplates(){
    return G.DV.retrieveMultiple("fsi_informationrequesttemplates",
      "?$select=fsi_name,fsi_description,fsi_category,fsi_targetteamtype,fsi_formjson,fsi_icon,fsi_accentcolor,fsi_version"
      + "&$filter=fsi_active eq true&$orderby=fsi_name asc")
      .then(function(r){ templates = r.filter(function(t){ return t.fsi_name !== "__CONFIG__"; }); });
  }

  function paintGallery(){
    var cats = {};
    templates.forEach(function(t){ var c = G.CATEGORY[t.fsi_category] || "Other"; cats[c] = (cats[c]||0)+1; });
    $("#tCats").innerHTML = '<span class="chip' + (cat==="all"?" on":"") + '" data-c="all">All <b style="opacity:.7">' + templates.length + '</b></span>'
      + Object.keys(cats).sort().map(function(c){
          return '<span class="chip' + (cat===c?" on":"") + '" data-c="' + esc(c) + '">' + esc(c) + ' <b style="opacity:.7">' + cats[c] + '</b></span>';
        }).join("");
    $$("#tCats .chip").forEach(function(c){
      c.addEventListener("click", function(){ cat = c.getAttribute("data-c"); paintGallery(); });
    });

    var list = templates.filter(function(t){
      var c = G.CATEGORY[t.fsi_category] || "Other";
      if (cat !== "all" && c !== cat) return false;
      if (search && (t.fsi_name + " " + (t.fsi_description||"")).toLowerCase().indexOf(search) < 0) return false;
      return true;
    });

    if (!list.length){
      $("#tGallery").innerHTML = '<div class="empty" style="grid-column:1/-1"><div class="e-ico">' + G.icon("search",38,1.4) +
        '</div><div class="e-t">No templates found</div><div class="e-s">Try another category or search term.</div></div>';
      return;
    }
    $("#tGallery").innerHTML = list.map(function(t){
      var f = G.normalizeForm(t.fsi_formjson, t.fsi_name);
      var n = G.countFields(f), col = t.fsi_accentcolor || "#2563eb";
      return '<div class="tcard' + (selTpl && selTpl.id === t.fsi_informationrequesttemplateid ? " sel" : "") + '" ' +
        'data-id="' + t.fsi_informationrequesttemplateid + '" style="--accent:' + esc(col) + ';--accent-soft:' + esc(col) + '14">' +
        '<div class="ticon">' + G.icon(t.fsi_icon || "blank", 19, 1.7) + '</div>' +
        '<div class="tname">' + esc(t.fsi_name) + '</div>' +
        '<div class="tdesc">' + esc(t.fsi_description || "") + '</div>' +
        '<div class="tmeta"><span class="badge b-draft">' + esc(G.TEAMTYPE[t.fsi_targetteamtype] || "—") + '</span>' +
        '<span>' + f.sections.length + ' sections · ' + n + ' questions</span></div></div>';
    }).join("");

    $$("#tGallery .tcard").forEach(function(c){
      c.addEventListener("click", function(){
        var id = c.getAttribute("data-id");
        var t = templates.filter(function(x){ return x.fsi_informationrequesttemplateid === id; })[0];
        selTpl = { id:id, rec:t };
        form = G.normalizeForm(t.fsi_formjson, t.fsi_name);
        formBeforeAi = null; editing = false;
        step = 3; paintReview(); show();
      });
    });
  }
  $("#tSearch").addEventListener("input", function(){ search = this.value.trim().toLowerCase(); paintGallery(); });
  $$("#s2d .chip[data-ex]").forEach(function(c){
    c.addEventListener("click", function(){ $("#nlInput").value = c.getAttribute("data-ex"); });
  });

  /* ---------------- step 2b : AI generate ---------------- */
  var aiSuggest = null;
  $("#btnGenerate").addEventListener("click", function(){
    var txt = $("#nlInput").value.trim();
    if (!txt) { G.toast("Describe what you need first.", "err"); return; }
    var b = this, old = b.innerHTML;
    b.disabled = true; b.innerHTML = '<span class="spin"></span> Copilot is drafting…';
    G.aiCall("generate", { instruction: txt, account: ctx.accountName || "", accountPlan: ctx.planTitle || "" })
      .then(function(res){
        var j = G.parseAiJson(res);
        aiSuggest = j;
        form = G.normalizeForm(j.form || j.questionnaire || j, j.title || "Information Request");
        selTpl = null; formBeforeAi = null; editing = false;
        step = 3; paintReview(); show();
        G.toast("Copilot drafted your questionnaire", "ok");
      })
      .catch(function(e){
        if (e.code === "NO_AI") { fallbackGenerate(txt); return; }
        G.toast(e.message || "Copilot could not generate the questionnaire.", "err", 5000);
      })
      .then(function(){ b.disabled = false; b.innerHTML = old; });
  });

  /* Graceful degradation when the AI endpoint is not yet configured. */
  function fallbackGenerate(txt){
    var guess = "Other";
    [["hedg","Global Markets"],["fx","Global Markets"],["currenc","Global Markets"],
     ["cash","Transaction Banking"],["liquid","Transaction Banking"],["payment","Transaction Banking"],
     ["trade","Trade Finance"],["letter of credit","Trade Finance"],["supply chain","Trade Finance"],
     ["credit","Credit / Risk"],["risk","Credit / Risk"],["limit","Credit / Risk"],
     ["bond","DCM / ECM"],["sukuk","DCM / ECM"],["ipo","DCM / ECM"],["capital market","DCM / ECM"],
     ["loan","Lending"],["financ","Lending"],["wallet","Country Coverage"],["stakeholder","Relationship Management"]]
      .forEach(function(p){ if (txt.toLowerCase().indexOf(p[0]) >= 0 && guess === "Other") guess = p[1]; });
    aiSuggest = { title: txt.slice(0,110), targetTeamType: guess, requestDescription: txt };
    form = G.normalizeForm({
      title: txt.slice(0,110),
      description: txt,
      sections: [
        { title:"Context", fields:[
          { id:"background", label:"Background & Current Position", type:"multiline", required:true },
          { id:"scope", label:"Scope / Entities Covered", type:"text", required:false }]},
        { title:"Assessment", fields:[
          { id:"assessment", label:"Assessment", type:"multiline", required:true },
          { id:"estimatedValue", label:"Estimated Value", type:"currency", required:false },
          { id:"timing", label:"Expected Timing", type:"date", required:false }]},
        { title:"Opportunity", fields:[
          { id:"opportunity", label:"Potential FAB Opportunity", type:"multiline", required:true },
          { id:"revenue", label:"Estimated Revenue Opportunity", type:"currency", required:false },
          { id:"nextAction", label:"Recommended Next Action", type:"multiline", required:true }]}
      ]});
    selTpl = null; formBeforeAi = null; editing = true;
    step = 3; paintReview(); show();
    G.toast("AI service not configured — a starter questionnaire was created for you to edit.", "", 6000);
  }

  /* ---------------- step 3 : review / edit ---------------- */
  function paintReview(){
    $("#fTitle").value = form.title || "";
    $("#fDesc").value = form.description || "";
    $("#pvCount").textContent = form.sections.length + " sections · " + G.countFields(form) + " questions";
    $("#btnToggleEdit").innerHTML = editing ? (G.icon("check",13) + " Done editing") : (G.icon("edit",13) + " Edit questions");
    $("#pvLbl").textContent = editing ? "Edit questionnaire" : "Questionnaire preview";
    $("#btnAddSec").classList.toggle("hidden", !editing);
    $("#pvHost").classList.toggle("hidden", editing);
    $("#edHost").classList.toggle("hidden", !editing);
    $("#btnUndoAi").classList.toggle("hidden", !formBeforeAi);
    if (editing) paintEditor(); else new G.Renderer({ form: form, container: $("#pvHost"), readOnly: true });
  }
  $("#fTitle").addEventListener("input", function(){ form.title = this.value; });
  $("#fDesc").addEventListener("input", function(){ form.description = this.value; });
  $("#btnToggleEdit").addEventListener("click", function(){
    if (editing) syncEditor();
    editing = !editing; paintReview();
  });
  $("#btnAddSec").addEventListener("click", function(){
    syncEditor();
    form.sections.push({ title:"New section", fields:[{ id:G.uid("q"), label:"New question", type:"text", required:false }] });
    paintReview();
  });
  $("#btnUndoAi").addEventListener("click", function(){
    if (!formBeforeAi) return;
    form = formBeforeAi; formBeforeAi = null; $("#aiStat").textContent = ""; paintReview();
    G.toast("Reverted to the original questionnaire", "ok");
  });

  function paintEditor(){
    var h = "";
    form.sections.forEach(function(s, si){
      h += '<div class="qsec" data-si="' + si + '"><div class="qhead">' +
        '<div class="qtitle" style="flex:1"><span class="qnum">' + (si+1) + '</span>' +
        '<input type="text" class="secTitle" value="' + esc(s.title) + '" style="max-width:380px;font-weight:700"></div>' +
        '<div class="row"><button class="btn btn-sm addQ">' + G.icon("plus",12) + ' Question</button>' +
        '<button class="btn btn-sm btn-danger delSec" title="Delete section">' + G.icon("trash",12) + '</button></div></div>' +
        '<div class="qbody">';
      s.fields.forEach(function(f, fi){
        h += '<div class="qedit" data-fi="' + fi + '"><div class="qrow">' +
          '<div class="fld"><label class="flbl">Question label</label><input type="text" class="qLbl" value="' + esc(f.label) + '"></div>' +
          '<div class="fld"><label class="flbl">Field type</label><select class="qType">' +
            G.FIELD_TYPES.map(function(t){ return '<option value="' + t.v + '"' + (f.type===t.v?" selected":"") + '>' + esc(t.l) + '</option>'; }).join("") +
          '</select></div>' +
          '<div class="fld"><label class="flbl">Required</label><label class="tgl"><input type="checkbox" class="qReq"' + (f.required?" checked":"") +
            '><span class="track"></span><span class="tlbl">' + (f.required?"Yes":"No") + '</span></label></div>' +
          '<div><button class="btn btn-sm btn-danger delQ" title="Delete question">' + G.icon("trash",12) + '</button></div>' +
        '</div><div class="qrow2">' +
          '<div class="fld"><label class="flbl">Help text</label><input type="text" class="qHelp" value="' + esc(f.help||"") + '" placeholder="Optional guidance for the contributor"></div>' +
          '<div class="fld optWrap' + (f.type==="choice"||f.type==="multiselect" ? "" : " hidden") + '"><label class="flbl">Choice options <span class="mini muted">(comma separated)</span></label>' +
            '<input type="text" class="qOpts" value="' + esc((f.options||[]).join(", ")) + '"></div>' +
        '</div></div>';
      });
      h += '</div></div>';
    });
    $("#edHost").innerHTML = h;

    $$("#edHost .qType").forEach(function(s){
      s.addEventListener("change", function(){
        var w = s.closest(".qedit").querySelector(".optWrap");
        w.classList.toggle("hidden", !(s.value === "choice" || s.value === "multiselect"));
        var oi = w.querySelector(".qOpts");
        if (!w.classList.contains("hidden") && !oi.value.trim()) oi.value = "Option 1, Option 2, Option 3";
      });
    });
    $$("#edHost .qReq").forEach(function(c){
      c.addEventListener("change", function(){ c.parentElement.querySelector(".tlbl").textContent = c.checked ? "Yes" : "No"; });
    });
    $$("#edHost .addQ").forEach(function(b){
      b.addEventListener("click", function(){
        syncEditor();
        var si = +b.closest(".qsec").getAttribute("data-si");
        form.sections[si].fields.push({ id:G.uid("q"), label:"New question", type:"text", required:false });
        paintReview();
      });
    });
    $$("#edHost .delQ").forEach(function(b){
      b.addEventListener("click", function(){
        syncEditor();
        var si = +b.closest(".qsec").getAttribute("data-si"), fi = +b.closest(".qedit").getAttribute("data-fi");
        form.sections[si].fields.splice(fi,1);
        if (!form.sections[si].fields.length) form.sections.splice(si,1);
        if (!form.sections.length) form.sections = [{ title:"Section 1", fields:[{ id:G.uid("q"), label:"Question 1", type:"text", required:false }] }];
        paintReview();
      });
    });
    $$("#edHost .delSec").forEach(function(b){
      b.addEventListener("click", function(){
        syncEditor();
        var si = +b.closest(".qsec").getAttribute("data-si");
        form.sections.splice(si,1);
        if (!form.sections.length) form.sections = [{ title:"Section 1", fields:[{ id:G.uid("q"), label:"Question 1", type:"text", required:false }] }];
        paintReview();
      });
    });
  }

  function syncEditor(){
    if ($("#edHost").classList.contains("hidden") && !editing) return;
    var secs = [];
    $$("#edHost .qsec").forEach(function(sn){
      var sec = { title: sn.querySelector(".secTitle").value || "Section", fields: [] };
      $$(".qedit", sn).forEach(function(qn, i){
        var t = qn.querySelector(".qType").value;
        var f = { id: G.uid("q"), label: qn.querySelector(".qLbl").value || ("Question " + (i+1)),
                  type: t, required: qn.querySelector(".qReq").checked };
        var hp = qn.querySelector(".qHelp").value.trim(); if (hp) f.help = hp;
        if (t === "choice" || t === "multiselect") {
          f.options = qn.querySelector(".qOpts").value.split(",").map(function(x){ return x.trim(); }).filter(Boolean);
          if (!f.options.length) f.options = ["Option 1","Option 2"];
        }
        sec.fields.push(f);
      });
      if (sec.fields.length) secs.push(sec);
    });
    if (secs.length) form.sections = secs;
    form.title = $("#fTitle").value; form.description = $("#fDesc").value;
    form = G.normalizeForm(form);
  }

  /* ---------------- AI customize ---------------- */
  $("#btnCustomize").addEventListener("click", function(){
    var ins = $("#aiInput").value.trim();
    if (!ins) { G.toast("Tell Copilot how to adapt the questionnaire.", "err"); return; }
    if (editing) { syncEditor(); editing = false; }
    var b = this, old = b.innerHTML;
    b.disabled = true; b.innerHTML = '<span class="spin"></span> Copilot is adapting…';
    var before = JSON.parse(JSON.stringify(form));
    G.aiCall("customize", {
      instruction: ins, form: form,
      account: ctx.accountName || "", accountPlan: ctx.planTitle || ""
    }).then(function(res){
      var j = G.parseAiJson(res);
      formBeforeAi = before;
      form = G.normalizeForm(j.form || j.questionnaire || j, before.title);
      $("#aiStat").textContent = "Adapted by Copilot · " + G.countFields(form) + " questions";
      paintReview();
      G.toast("Copilot adapted the questionnaire", "ok");
    }).catch(function(e){
      G.toast(e.code === "NO_AI" ? "AI service is not configured in this environment yet."
                                 : (e.message || "Copilot could not adapt the questionnaire."), "err", 5000);
    }).then(function(){ b.disabled = false; b.innerHTML = old; });
  });

  /* ---------------- step 4 : send ---------------- */
  function paintSend(){
    $("#rType").innerHTML = Object.keys(G.CATEGORY).map(function(k){
      return '<option value="' + k + '">' + esc(G.CATEGORY[k]) + '</option>'; }).join("");
    var wantType = null;
    if (selTpl) wantType = String((selTpl.rec.fsi_targetteamtype || 10109) - 100);
    else if (aiSuggest && aiSuggest.targetTeamType) {
      Object.keys(G.CATEGORY).forEach(function(k){
        if (G.CATEGORY[k].toLowerCase() === String(aiSuggest.targetTeamType).toLowerCase()) wantType = k; });
    }
    if (wantType) $("#rType").value = wantType;

    $("#rTitle").value = $("#rTitle").value || (selTpl ? selTpl.rec.fsi_name : (aiSuggest && aiSuggest.title) || form.title || "");
    $("#rDesc").value  = $("#rDesc").value  || (aiSuggest && aiSuggest.requestDescription) || form.description || "";
    if (!$("#rDue").value){
      var d = new Date(); d.setDate(d.getDate() + 14);
      $("#rDue").value = G.toISODate(d);
    }
    if (!$("#rTeam").value) matchTeam();
    $("#s4Ctx").innerHTML = "Linked to <b>" + esc(ctx.accountName || "—") + "</b> · " + esc(ctx.planTitle || "");
  }
  function matchTeam(){
    var typeLbl = G.CATEGORY[$("#rType").value];
    var want = G.TEAM_FOR_TYPE[typeLbl];
    var t = teams.filter(function(x){ return x.name === want; })[0];
    if (t) $("#rTeam").value = t.teamid;
  }
  $("#rType").addEventListener("change", matchTeam);

  function loadPeople(){
    return Promise.all([
      G.DV.retrieveMultiple("teams","?$select=name,teamid&$filter=teamtype eq 0&$orderby=name asc&$top=1000"),
      G.DV.retrieveMultiple("systemusers","?$select=fullname,internalemailaddress&$filter=isdisabled eq false and accessmode eq 0&$orderby=fullname asc&$top=200"),
      G.DV.whoAmI()
    ]).then(function(r){
      var named = ["Country Coverage","Sector Coverage","Global Markets","Transaction Banking",
                   "Trade Finance","Credit & Risk","DCM / ECM"];
      teams = r[0].filter(function(t){ return named.indexOf(t.name) >= 0; });
      if (!teams.length) teams = r[0].filter(function(t){ return !/^[0-9a-f]{32}_\d$/.test(t.name); }).slice(0,60);
      users = r[1]; me = r[2];
      $("#rTeam").innerHTML = '<option value="">— Select team —</option>' +
        teams.map(function(t){ return '<option value="' + t.teamid + '">' + esc(t.name) + '</option>'; }).join("");
      $("#rUser").innerHTML = '<option value="">— Optional —</option>' +
        users.map(function(u){ return '<option value="' + u.systemuserid + '">' + esc(u.fullname || u.internalemailaddress || "") + '</option>'; }).join("");
    });
  }

  /* ---------------- persist ---------------- */
  function buildRecord(statusLabel){
    var rec = {
      "fsi_name": $("#rTitle").value.trim(),
      "fsi_requestdescription": $("#rDesc").value.trim() || null,
      "fsi_requesttype": Number($("#rType").value),
      "fsi_status": G.STATUS_V[statusLabel],
      "fsi_duedate": $("#rDue").value || null,
      "fsi_requestingteam": $("#rFrom").value.trim() || null,
      "fsi_generatedformjson": JSON.stringify(form),
      "fsi_aicustomizationinstruction": ($("#aiInput").value || $("#nlInput").value || "").trim() || null
    };
    if (ctx.planId)    rec["fsi_AccountPlan@odata.bind"] = "/fsi_accountplannings(" + ctx.planId + ")";
    if (ctx.accountId) rec["fsi_Account@odata.bind"]     = "/accounts(" + ctx.accountId + ")";
    if (selTpl)        rec["fsi_SourceTemplate@odata.bind"] = "/fsi_informationrequesttemplates(" + selTpl.id + ")";
    if ($("#rTeam").value) rec["fsi_RequestedFromTeam@odata.bind"] = "/teams(" + $("#rTeam").value + ")";
    if ($("#rUser").value) rec["fsi_RequestedFromUser@odata.bind"] = "/systemusers(" + $("#rUser").value + ")";
    return rec;
  }

  function validateSend(){
    if (!$("#rTitle").value.trim()) { G.toast("Enter a request title.", "err"); $("#rTitle").focus(); return false; }
    if (!$("#rDue").value) { G.toast("Select a due date.", "err"); $("#rDue").focus(); return false; }
    if (!$("#rTeam").value && !$("#rUser").value) { G.toast("Select a team or a person to request from.", "err"); return false; }
    return true;
  }

  function save(statusLabel, btn){
    if (editing) { syncEditor(); editing = false; paintReview(); }
    if (statusLabel === "Sent" && !validateSend()) return;
    if (statusLabel === "Draft" && !$("#rTitle").value.trim())
      $("#rTitle").value = form.title || "Information Request";
    var old = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Saving…';
    G.DV.create("fsi_informationrequests", buildRecord(statusLabel))
      .then(function(id){
        if (statusLabel !== "Sent") return id;
        return notify(id).then(function(){ return id; });
      })
      .then(function(id){
        G.toast(statusLabel === "Sent" ? "Request sent" : "Saved as draft", "ok");
        setTimeout(function(){
          try { G.xrm().Navigation.navigateTo({ pageType:"entityrecord", entityName:"fsi_informationrequest", entityId:id }); } catch(e){}
          closeDialog();
        }, 650);
      })
      .catch(function(e){ G.toast(e.message || "Could not save the request.", "err", 6000); })
      .then(function(){ btn.disabled = false; btn.innerHTML = old; });
  }

  /* in-product notification to the nominated contributor(s) */
  function notify(reqId){
    var recips = [];
    if ($("#rUser").value) recips.push($("#rUser").value);
    var teamId = $("#rTeam").value;
    var p = teamId && !recips.length
      ? G.DV.retrieveMultiple("teammemberships", "?$select=systemuserid&$filter=teamid eq " + teamId + "&$top=25")
          .then(function(m){ return m.map(function(x){ return x.systemuserid; }); })
      : Promise.resolve(recips);
    return p.then(function(ids){
      if (!ids.length) return;
      var url = G.clientUrl() + "/main.aspx?etn=fsi_informationrequest&id=" + reqId + "&pagetype=entityrecord";
      var body = "You have been asked to provide information for " + (ctx.accountName || "an account") + ".\n\n"
        + "Request: " + $("#rTitle").value.trim() + "\n"
        + "Account: " + (ctx.accountName || "—") + "\n"
        + "Account Plan: " + (ctx.planTitle || "—") + "\n"
        + "Due: " + ($("#rDue").value ? G.fmtDate($("#rDue").value) : "—") + "\n\n"
        + "Open the request: " + url;
      return Promise.all(ids.slice(0,25).map(function(uid){
        return G.DV.create("appnotifications", {
          "title": "Information requested: " + $("#rTitle").value.trim(),
          "body": body,
          "ttlinseconds": 60 * 60 * 24 * 30,
          "icontype": 100000000,
          "ownerid@odata.bind": "/systemusers(" + uid + ")",
          "data": JSON.stringify({ actions:[{ title:"Open request", data:{ url:url, navigationTarget:"newWindow" } }] })
        }).catch(function(){});
      }));
    }).catch(function(){});
  }

  function closeDialog(){
    try { G.xrm().Navigation.navigateTo; } catch(e){}
    try { if (window.close) window.close(); } catch(e){}
    try { parent.postMessage({ gti:"close" }, "*"); } catch(e){}
  }

  /* ---------------- bar ---------------- */
  $("#btnNext").addEventListener("click", function(){
    if (step === 2 && mode === "template") { G.toast("Select a template card to continue.", "err"); return; }
    if (step === 3) {
      if (editing) { syncEditor(); editing = false; paintReview(); }
      if (!form.title || !form.title.trim()) { G.toast("Give the questionnaire a title.", "err"); $("#fTitle").focus(); return; }
      step = 4; paintSend(); show(); return;
    }
    if (step === 4) { save("Sent", this); return; }
  });
  $("#btnDraft").addEventListener("click", function(){
    if (step === 3) { if (editing) { syncEditor(); editing = false; paintReview(); } step = 4; paintSend(); show(); }
    save("Draft", this);
  });
  $("#btnBack").addEventListener("click", function(){
    if (step === 4) { step = 3; paintReview(); }
    else if (step === 3) { step = mode === "blank" ? 1 : 2; if (mode === "template") paintGallery(); }
    else step = 1;
    show();
  });

  /* ---------------- boot ---------------- */
  $("#heroSub").textContent = (ctx.accountName ? ctx.accountName + " · " : "") + (ctx.planTitle || "Account plan");
  Promise.all([loadTemplates(), loadPeople()]).then(show).catch(function(e){
    G.toast(e.message || "Could not load reference data.", "err", 6000); show();
  });
})();
</script>
</body>
</html>
