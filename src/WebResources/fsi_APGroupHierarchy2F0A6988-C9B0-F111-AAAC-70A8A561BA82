    100000003: "Watchlist", 100000004: "Target", 100000005: "Non-Client"
  };
  var STATUS_PILL = {
    100000000: "pill-strategic", 100000001: "pill-strategic", 100000002: "pill-neutral",
    100000003: "pill-watch", 100000004: "pill-watch", 100000005: "pill-risk"
  };

  var state = { nodes: {}, root: null, account: null, financial: null };

  function setState(message) {
    var el = document.getElementById("hierState");
    if (!el) return;
    if (message === null) { el.classList.add("hidden"); return; }
    el.classList.remove("hidden");
    el.textContent = message;
  }

  function kindKey(row) {
    if (row.fsi_is_ubo) return "ubo";
    if (row.fsi_entity_kind === 100000000) return "parent";
    if (row.fsi_entity_kind === 100000001) return "subsidiary";
    return "related";
  }

  function money(value) {
    return APCtx.num(value) ? APCtx.compact(value, "AED") : "AED 0";
  }

  /* Map one fsi_borrowerentity row onto the card model the original renderer expects. */
  /* Seeded rows carry an "ILLUSTRATIVE DEMO |" marker; the banner already states that,
     so strip it from free text rather than repeating it on every card. */
  function cleanNote(value) {
    var text = String(value || "").trim();
    if (!/^ILLUSTRATIVE DEMO/i.test(text)) return text;
    var parts = text.split("|");
    return parts.slice(1).join("|").trim();
  }

  function toNode(row, groupFinancial) {    var total = APCtx.num(row.fsi_exposure_amount) || 0;
    var funded = APCtx.num(row.fsi_funded_exposure) || 0;
    var nonFunded = APCtx.num(row.fsi_nonfunded_exposure) || 0;
    if (total && !funded && !nonFunded) { funded = total; }
    var denominator = funded + nonFunded;
    var fundedPct = denominator ? Math.round(funded / denominator * 100) : 0;

    var kind = kindKey(row);
    var isClient = !!row.fsi_is_fab_client;
    var flags = [];
    flags.push(isClient
      ? { className: "flag-clear", text: "FAB customer" }
      : { className: "flag-watch", text: "Non-FAB entity" });
    flags.push(row.fsi_is_ubo
      ? { className: "flag-clear", text: "UBO verified" }
      : { className: "flag-clear", text: "Screening clear" });
    if (row.fsi_hierarchy_status === 100000003) {
      flags.push({ className: "flag-watch", text: "On watchlist" });
    }

    var isGroupParent = kind === "parent" && !row.fsi_is_ubo;
    var snapshot = isGroupParent && groupFinancial ? groupFinancial : null;

    return {
      id: row.fsi_borrowerentityid,
      raw: row,
      kind: kind,
      isClient: isClient,
      name: APCtx.escapeHtml(row.fsi_name || "Unnamed entity"),
      shortLabel: APCtx.initials(row.fsi_name),
      statusClass: STATUS_PILL[row.fsi_hierarchy_status] || "pill-neutral",
      statusText: STATUS_TEXT[row.fsi_hierarchy_status] || (isClient ? "Client" : "Non-Client"),
      rating: APCtx.escapeHtml(row.fsi_rating || "Unrated"),
      raroc: APCtx.num(row.fsi_raroc_pct) !== null ? APCtx.pct(row.fsi_raroc_pct) : "n/a",
      role: ENTITY_KIND[row.fsi_entity_kind] || "Related entity",
      industry: APCtx.escapeHtml(row.fsi_sector || "–"),
      ownership: APCtx.num(row.fsi_ownership_pct) !== null ? APCtx.pct(row.fsi_ownership_pct, 1) : "–",
      primaryUbo: APCtx.escapeHtml(row.fsi_ubo_name || "–"),
      rm: APCtx.escapeHtml(row.fsi_rm_name || "Unassigned"),
      totalExposure: total ? money(total) : "No facilities",
      fundedExposure: money(funded),
      nonFundedExposure: money(nonFunded),
      fundedPct: fundedPct,
      nonFundedPct: 100 - fundedPct,
      riskLevel: APCtx.num(row.fsi_risk_level) || 1,
      revenue: snapshot ? money(snapshot.fsi_revenue) : "Group level",
      ebitda: snapshot ? money(snapshot.fsi_ebitda) : "Group level",
      debt: snapshot ? money(snapshot.fsi_totaldebt) : "Group level",
      netLeverage: snapshot && APCtx.num(snapshot.fsi_ebitda)
        ? APCtx.ratio((APCtx.num(snapshot.fsi_totaldebt) - APCtx.num(snapshot.fsi_cashandequivalents)) / snapshot.fsi_ebitda)
        : "Group level",
      screeningFlags: flags,
      ma: APCtx.escapeHtml(cleanNote(row.fsi_relationship_note) || "No activity recorded."),
      opportunity: isClient
        ? "Existing FAB client \u00b7 cross-sell and wallet expansion tracked in the Pipeline tab."
        : "Not currently banked by FAB \u00b7 acquisition target for the coverage team.",
      children: []
    };
  }

  function buildTree(rows, groupFinancial) {
    var byId = {};
    rows.forEach(function (row) {
      byId[row.fsi_borrowerentityid] = toNode(row, groupFinancial);
    });
    state.nodes = byId;

    var roots = [];
    rows.forEach(function (row) {
      var node = byId[row.fsi_borrowerentityid];
      var parentId = row["_fsi_parententity_value"];
      var parent = parentId ? byId[parentId] : null;
      if (parent && parent !== node) { parent.children.push(node); } else { roots.push(node); }
    });

    // Sort children: FAB clients first, then by exposure, then alphabetically.
    Object.keys(byId).forEach(function (key) {
      byId[key].children.sort(function (a, b) {
        if (a.isClient !== b.isClient) return a.isClient ? -1 : 1;
        var ea = APCtx.num(a.raw.fsi_exposure_amount) || 0;
        var eb = APCtx.num(b.raw.fsi_exposure_amount) || 0;
        if (ea !== eb) return eb - ea;
        return String(a.raw.fsi_name).localeCompare(String(b.raw.fsi_name));
      });
    });

    if (!roots.length) return null;
    if (roots.length === 1) return roots[0];

    // More than one root: present a synthetic group node so the canvas still renders one tree.
    return {
      id: "synthetic-group-root",
      kind: "parent",
      isClient: true,
      raw: {},
      name: APCtx.escapeHtml((state.account && state.account.name) || "Group"),
      shortLabel: APCtx.initials((state.account && state.account.name) || "G"),
      statusClass: "pill-strategic", statusText: "Group", rating: "–", raroc: "n/a",
      role: "Group holding view", industry: "–", ownership: "–",
      primaryUbo: "–", rm: "–",
      totalExposure: "–", fundedExposure: "AED 0", nonFundedExposure: "AED 0",
      fundedPct: 0, nonFundedPct: 0, riskLevel: 1,
      revenue: "–", ebitda: "–", debt: "–", netLeverage: "–",
      screeningFlags: [], ma: "–", opportunity: "–",
      children: roots
    };
  }

  // ---- decoration + interaction -------------------------------------------
  var KIND_LABEL = { ubo: "UBO", parent: "Parent", subsidiary: "Subsidiary", related: "Related" };

  /* Wide groups are hard to read fully expanded, so every parent gets a collapse
     control. Children are hidden with a class so the original connector CSS is untouched. */
  function wireBranchToggles() {
    var items = document.querySelectorAll("#treeRoot li");
    Array.prototype.forEach.call(items, function (item) {
      var childList = null;
      for (var i = 0; i < item.children.length; i++) {
        if (item.children[i].tagName === "UL") { childList = item.children[i]; break; }
      }
      if (!childList) return;

      var count = childList.children.length;
      var toggle = document.createElement("button");
      toggle.type = "button";
      toggle.className = "branch-toggle";
      item.insertBefore(toggle, childList);

      function paint() {
        var collapsed = item.classList.contains("is-collapsed");
        toggle.textContent = collapsed ? "+ " + count : "\u2212 hide " + count;
        toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
        toggle.title = (collapsed ? "Show " : "Hide ") + count +
          (count === 1 ? " subsidiary" : " subsidiaries");
      }

      toggle.addEventListener("click", function (event) {
        event.stopPropagation();
        item.classList.toggle("is-collapsed");
        paint();
        requestAnimationFrame(function () { applyTransform(); });
      });
      paint();
    });
  }

  /* fitToScreen applies the legibility floor itself, but the iframe can still be
     hidden when the tree first renders, so re-fit once it is actually measurable. */
  function initialView() {
    var ticks = 0;
    var timer = setInterval(function () {
      var content = document.getElementById("content");
      if (content && content.offsetWidth) {
        ticks += 1;
        fitToScreen();
        if (ticks >= 3) { clearInterval(timer); }
      }
    }, 150);
  }

  function decorateCards() {
    document.querySelectorAll(".company-card").forEach(function (card) {
      var node = state.nodes[card.getAttribute("data-card-id")];
      if (!node) return;
      card.classList.add("kind-" + node.kind);
      if (!node.isClient) card.classList.add("non-client");

      var pillRow = card.querySelector(".pill-row");
      if (pillRow && !pillRow.querySelector(".kind-badge")) {
        var kindBadge = document.createElement("span");
        kindBadge.className = "kind-badge kb-" + node.kind;
        kindBadge.textContent = KIND_LABEL[node.kind] || "Entity";
        pillRow.insertBefore(kindBadge, pillRow.firstChild);

        var clientBadge = document.createElement("span");
        clientBadge.className = "client-badge " + (node.isClient ? "is-client" : "not-client");
        clientBadge.textContent = node.isClient ? "FAB client" : "Not banked";
        pillRow.appendChild(clientBadge);
      }
    });
  }

  function detailRow(label, value) {
    return '<div class="dp-row"><span>' + label + "</span><span>" + value + "</span></div>";
  }

  function openDetail(node) {
    var row = node.raw || {};
    var linked = row["_fsi_linked_account_value"];
    var html = '<div class="dp-name">' + node.name + "</div>" +
      '<div class="dp-role">' + node.role + " \u00b7 " + APCtx.escapeHtml(row.fsi_country || "–") + "</div>" +
      '<div class="dp-badges">' +
        '<span class="kind-badge kb-' + node.kind + '">' + (KIND_LABEL[node.kind] || "Entity") + "</span>" +
        '<span class="client-badge ' + (node.isClient ? "is-client" : "not-client") + '">' +
          (node.isClient ? "FAB client" : "Not banked") + "</span>" +
        '<span class="pill ' + node.statusClass + '">' + node.statusText + "</span>" +
      "</div>" +
      '<div class="dp-section">Ownership</div>' +
      detailRow("Ownership held", node.ownership) +
      detailRow("Ultimate owner", node.primaryUbo) +
      detailRow("Entity type", node.role) +
      detailRow("Country", APCtx.escapeHtml(row.fsi_country || "–")) +
      detailRow("Sector", node.industry) +
      '<div class="dp-section">FAB relationship</div>' +
      detailRow("Relationship status", node.statusText) +
      detailRow("Internal rating", node.rating) +
      detailRow("RAROC", node.raroc) +
      detailRow("Relationship manager", node.rm) +
      '<div class="dp-section">Exposure</div>' +
      detailRow("Total exposure", node.totalExposure) +
      detailRow("Funded", node.fundedExposure + " (" + node.fundedPct + "%)") +
      detailRow("Non-funded", node.nonFundedExposure + " (" + node.nonFundedPct + "%)") +
      '<div class="dp-section">Coverage note</div>' +
      '<div class="dp-note">' + node.ma + "</div>" +
      (linked
        ? '<button class="dp-link" data-account-id="' + linked + '">Open Customer 360</button>'
        : '<button class="dp-link" disabled>No linked account record</button>');

    var panel = document.getElementById("detailPanel");
    document.getElementById("dpBody").innerHTML = html;
    panel.classList.add("open");

    var link = panel.querySelector(".dp-link[data-account-id]");
    if (link) {
      link.addEventListener("click", function () {
        APCtx.openRecord("account", link.getAttribute("data-account-id"));
      });
    }
  }

  function wireDetailPanel() {
    document.getElementById("dpClose").addEventListener("click", function () {
      document.getElementById("detailPanel").classList.remove("open");
    });
    document.querySelectorAll(".company-card").forEach(function (card) {
      card.addEventListener("click", function () {
        if (isDraggingCanvas || dragMoved) return;
        var node = state.nodes[card.getAttribute("data-card-id")];
        if (node) openDetail(node);
      });
    });
  }

  function updateHeader(rows, scope) {
    var clients = rows.filter(function (r) { return r.fsi_is_fab_client; }).length;
    var exposure = APCtx.sum(rows, "fsi_exposure_amount");
    var countries = {};
    rows.forEach(function (r) { if (r.fsi_country) countries[r.fsi_country] = 1; });

    document.getElementById("hierTitle").textContent =
      (scope.accountName || "Group") + " \u2014 Group Hierarchy & UBO";
    document.getElementById("hierSub").textContent =
      "Ultimate beneficial ownership and legal entity structure \u00b7 illustrative demo data";
    document.getElementById("mEntities").textContent = rows.length;
    document.getElementById("mClients").textContent = clients + " / " + rows.length;
    document.getElementById("mExposure").textContent = APCtx.compact(exposure, "AED");
    document.getElementById("mCountries").textContent = Object.keys(countries).length;
  }

  // ---- load ----------------------------------------------------------------
  APCtx.resolve().then(function (scope) {
    state.account = { id: scope.accountId, name: scope.accountName };

    var entities = APCtx.query(scope, "fsi_borrowerentities", [
      "$select=fsi_borrowerentityid,fsi_name,fsi_entity_kind,fsi_ownership_pct,fsi_country,",
      "fsi_sector,fsi_exposure_amount,fsi_funded_exposure,fsi_nonfunded_exposure,fsi_is_ubo,",
      "fsi_ubo_name,fsi_is_fab_client,fsi_hierarchy_status,fsi_rating,fsi_raroc_pct,fsi_rm_name,",
      "fsi_risk_level,fsi_relationship_note,_fsi_parententity_value,_fsi_linked_account_value",
      "&$filter=_fsi_account_value eq " + scope.accountId
    ].join(""));

    var financials = APCtx.query(scope, "fsi_companyfinancials",
      "$select=fsi_revenue,fsi_ebitda,fsi_totaldebt,fsi_cashandequivalents,fsi_yearended" +
      "&$filter=_fsi_company_value eq " + scope.accountId +
      "&$orderby=fsi_yearended desc&$top=1");

    return Promise.all([entities, financials]).then(function (results) {
      var rows = results[0];
      var groupFinancial = results[1][0] || null;
      if (!rows.length) {
        setState("No group entities have been recorded for " +
          (scope.accountName || "this customer") + " yet.");
        return;
      }
      state.financial = groupFinancial;
      var tree = buildTree(rows, groupFinancial);
      if (!tree) { setState("The group hierarchy could not be assembled."); return; }

      document.getElementById("treeRoot").innerHTML = "<ul>" + renderNode(tree) + "</ul>";
      decorateCards();
      wireBranchToggles();
      wireCards();
      wireDetailPanel();
      updateHeader(rows, scope);
      setState(null);
      requestAnimationFrame(function () { initialView(); });
    });
  }).catch(function (error) {
    console.error("[GroupHierarchy]", error);
    setState(error && error.message ? error.message : "Unable to load the group hierarchy.");
  });
}());

  </script>
</body>
