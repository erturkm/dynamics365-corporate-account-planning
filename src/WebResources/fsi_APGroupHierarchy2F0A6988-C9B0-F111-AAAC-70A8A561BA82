    function wireCards() {

    document.querySelectorAll(".company-card").forEach(function(card) {
      const btn = card.querySelector(".toggle-btn");

      function syncText() {
        btn.textContent = card.classList.contains("expanded")
          ? "Hide Details"
          : "Show More Details";
      }

      function toggleCard() {
        if (dragMoved) return;
        card.classList.toggle("expanded");
        syncText();
        setTimeout(fitToScreenIfNeededAfterExpand, 50);
      }

      card.addEventListener("click", function(e) {
        if (isDraggingCanvas || dragMoved) return;
        if (e.target.tagName !== "BUTTON") {
          toggleCard();
        }
      });

      btn.addEventListener("click", function(e) {
        e.stopPropagation();
        if (isDraggingCanvas || dragMoved) return;
        toggleCard();
      });

      syncText();
    });

    }

    const viewport = document.getElementById("viewport");
    const canvas = document.getElementById("canvas");
    const content = document.getElementById("content");
    const zoomReadout = document.getElementById("zoomReadout");

    const state = {
      scale: 1,
      minScale: 0.12,
      maxScale: 2.5,
      x: 0,
      y: 0,
      dragging: false,
      startX: 0,
      startY: 0,
      startPanX: 0,
      startPanY: 0
    };

    function applyTransform() {
      canvas.style.transform = "translate(" + state.x + "px," + state.y + "px) scale(" + state.scale + ")";
      zoomReadout.textContent = Math.round(state.scale * 100) + "%";
    }

    /* A large group renders several thousand pixels wide, so a true fit-to-screen
       shrinks the cards past the point of being readable. Automatic fits (initial
       render and window resize) are clamped to a legible floor and anchored to the
       top-left; the Fit button passes showEverything to get the full overview. */
    const LEGIBLE_FLOOR = 0.62;

    function fitToScreen(showEverything) {
      const vw = viewport.clientWidth;
      const vh = viewport.clientHeight;
      const cw = content.offsetWidth;
      const ch = content.offsetHeight;

      if (!cw || !ch) return;

      const padding = 60;
      const scaleX = (vw - padding) / cw;
      const scaleY = (vh - padding) / ch;

      let nextScale = Math.min(scaleX, scaleY);
      if (!isFinite(nextScale) || nextScale <= 0) nextScale = 1;

      if (showEverything !== true) nextScale = Math.max(nextScale, LEGIBLE_FLOOR);

      state.scale = Math.max(state.minScale, Math.min(nextScale, state.maxScale));
      /* Horizontally the tree is centred on its root; vertically it is anchored to the
         top whenever it is taller than the viewport, so the ultimate parent stays visible. */
      state.x = Math.min(30, (vw - (cw * state.scale)) / 2);
      state.y = ((ch * state.scale) > (vh - padding)) ? 24 : (vh - (ch * state.scale)) / 2;

      applyTransform();
    }

    function fitToScreenIfNeededAfterExpand() {
      applyTransform();
    }

    function resetView() {
      state.scale = 1;
      state.x = 30;
      state.y = 30;
      applyTransform();
    }

    function zoomAt(factor, clientX, clientY) {
      const rect = viewport.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;

      const oldScale = state.scale;
      const newScale = Math.max(state.minScale, Math.min(oldScale * factor, state.maxScale));
      if (newScale === oldScale) return;

      state.x = px - ((px - state.x) * (newScale / oldScale));
      state.y = py - ((py - state.y) * (newScale / oldScale));
      state.scale = newScale;

      applyTransform();
    }

    document.getElementById("zoomInBtn").addEventListener("click", function() {
      const rect = viewport.getBoundingClientRect();
      zoomAt(1.15, rect.left + rect.width / 2, rect.top + rect.height / 2);
    });

    document.getElementById("zoomOutBtn").addEventListener("click", function() {
      const rect = viewport.getBoundingClientRect();
      zoomAt(1 / 1.15, rect.left + rect.width / 2, rect.top + rect.height / 2);
    });

    document.getElementById("fitBtn").addEventListener("click", function () { fitToScreen(true); });
    document.getElementById("resetBtn").addEventListener("click", resetView);

    viewport.addEventListener("wheel", function(e) {
      e.preventDefault();
      zoomAt(e.deltaY < 0 ? 1.08 : (1 / 1.08), e.clientX, e.clientY);
    }, { passive: false });

    viewport.addEventListener("mousedown", function(e) {
      state.dragging = true;
      isDraggingCanvas = false;
      dragMoved = false;
      viewport.classList.add("dragging");
      state.startX = e.clientX;
      state.startY = e.clientY;
      state.startPanX = state.x;
      state.startPanY = state.y;
    });

    window.addEventListener("mousemove", function(e) {
      if (!state.dragging) return;

      const dx = e.clientX - state.startX;
      const dy = e.clientY - state.startY;

      if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
        isDraggingCanvas = true;
        dragMoved = true;
      }

      state.x = state.startPanX + dx;
      state.y = state.startPanY + dy;
      applyTransform();
    });

    window.addEventListener("mouseup", function() {
      state.dragging = false;
      viewport.classList.remove("dragging");
      setTimeout(function() {
        isDraggingCanvas = false;
        dragMoved = false;
      }, 0);
    });

    viewport.addEventListener("touchstart", function(e) {
      if (e.touches.length === 1) {
        state.dragging = true;
        isDraggingCanvas = false;
        dragMoved = false;
        state.startX = e.touches[0].clientX;
        state.startY = e.touches[0].clientY;
        state.startPanX = state.x;
        state.startPanY = state.y;
      }
    }, { passive: true });

    viewport.addEventListener("touchmove", function(e) {
      if (e.touches.length === 1 && state.dragging) {
        const dx = e.touches[0].clientX - state.startX;
        const dy = e.touches[0].clientY - state.startY;

        if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
          isDraggingCanvas = true;
          dragMoved = true;
        }

        state.x = state.startPanX + dx;
        state.y = state.startPanY + dy;
        applyTransform();
      }
    }, { passive: true });

    viewport.addEventListener("touchend", function() {
      state.dragging = false;
      setTimeout(function() {
        isDraggingCanvas = false;
        dragMoved = false;
      }, 0);
    });

    window.addEventListener("resize", function () { fitToScreen(); });

    requestAnimationFrame(function() {
      fitToScreen();
    });

/* Dataverse data layer for the Account Plan "Group Hierarchy & UBO" tab.
