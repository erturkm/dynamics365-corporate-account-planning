<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Group Hierarchy &amp; UBO</title>
  <style>
    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: linear-gradient(180deg, #f8fafc 0%, #eef3f8 100%);
      font-family: "Segoe UI", Arial, sans-serif;
      color: #172033;
    }

    body {
      padding: 16px;
    }

    .viewer-shell {
      position: relative;
      width: 100%;
      height: calc(100vh - 32px);
      background: #ffffff;
      border: 1px solid #e7edf5;
      border-radius: 28px;
      box-shadow: 0 14px 34px rgba(15, 23, 42, 0.07);
      overflow: hidden;
    }

    .toolbar {
      position: absolute;
      top: 14px;
      right: 14px;
      z-index: 30;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      padding: 8px;
      background: rgba(255,255,255,0.95);
      border: 1px solid #e7edf5;
      border-radius: 16px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
      backdrop-filter: blur(10px);
    }

    .btn {
      border: 1px solid #d9e2ee;
      background: #ffffff;
      color: #1f2a44;
      border-radius: 10px;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .btn:hover {
      background: #f8fbff;
      border-color: #bfd0e5;
    }

    .zoom-readout {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 68px;
      padding: 8px 10px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 800;
      color: #334155;
      background: #f8fbff;
      border: 1px solid #d9e2ee;
    }

    .viewport {
      position: absolute;
      inset: 0;
      overflow: hidden;
      cursor: grab;
      touch-action: none;
      background:
        radial-gradient(circle at 1px 1px, rgba(148,163,184,0.12) 1px, transparent 0);
      background-size: 22px 22px;
    }

    .viewport.dragging {
      cursor: grabbing;
    }

    .canvas {
      position: absolute;
      top: 0;
      left: 0;
      transform-origin: 0 0;
      will-change: transform;
      user-select: none;
    }

    .content {
      display: inline-block;
      padding: 28px 28px 60px 28px;
    }

    .tree {
      display: flex;
      justify-content: center;
      min-width: max-content;
      padding: 10px 10px 24px 10px;
    }

    .tree ul {
      position: relative;
      padding-top: 46px;
      padding-left: 0;
      margin: 0;
      display: flex;
      justify-content: center;
      gap: 22px;
      flex-wrap: nowrap;
    }

    .tree li {
      list-style: none;
      text-align: center;
      position: relative;
      padding: 0 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .tree li::before,
    .tree li::after {
      content: "";
      position: absolute;
      top: 0;
      right: 50%;
      width: 50%;
      height: 34px;
      border-top: 3px solid #b8c6d8;
      border-radius: 18px 0 0 0;
    }

    .tree li::after {
      right: auto;
      left: 50%;
      border-left: 3px solid #b8c6d8;
      border-radius: 0 18px 0 0;
    }

    .tree li:only-child::before,
    .tree li:only-child::after {
      display: none;
    }

    .tree li:first-child::before,
    .tree li:last-child::after {
      border: 0 none;
    }

    .tree li:last-child::before {
      border-right: 3px solid #b8c6d8;
      border-radius: 0 18px 0 0;
    }

    .tree li:first-child::after {
      border-radius: 18px 0 0 0;
    }

    .tree ul ul::before {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      height: 46px;
      border-left: 3px solid #b8c6d8;
      transform: translateX(-50%);
    }

    .company-card {
      width: 420px;
      max-width: 420px;
      background: #ffffff;
      border: 2px solid #dfe7f0;
      border-radius: 26px;
      box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
      overflow: hidden;
      transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
      cursor: pointer;
      text-align: left;
    }

    .company-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 42px rgba(15, 23, 42, 0.12);
      border-color: #c9d8e8;
    }

    .company-card.expanded {
      transform: scale(1.02);
      border-color: #2f6fed;
      box-shadow: 0 0 0 5px rgba(47, 111, 237, 0.08), 0 24px 56px rgba(15, 23, 42, 0.16);
    }

    .card-main {
      padding: 16px;
    }

    .pill-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 11px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 800;
      border: 1px solid transparent;
      white-space: nowrap;
    }

    .pill::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }

    .pill-strategic {
      background: #e9f8ef;
      color: #17663a;
      border-color: #cbeed7;
    }

    .pill-strategic::before {
      background: #22c55e;
    }

    .pill-watch {
      background: #fff7df;
      color: #a16207;
      border-color: #f7e3a5;
    }

    .pill-watch::before {
      background: #f59e0b;
    }

    .pill-risk {
      background: #fdecec;
      color: #a12622;
      border-color: #f5c7c5;
    }

    .pill-risk::before {
      background: #ef4444;
    }

    .pill-neutral {
      background: #f2f5f9;
      color: #475569;
      border-color: #dbe3ec;
    }

    .pill-neutral::before {
      background: #94a3b8;
    }

    .pill-rating {
      background: #eef4ff;
      color: #1f4fd1;
      border-color: #d6e2ff;
    }

    .pill-rating::before {
      display: none;
    }

    .identity {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 12px;
    }

    .avatar {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: #d8dee7;
      color: #172033;
      font-size: 28px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .identity-text {
      min-width: 0;
      flex: 1;
    }

    .name-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
    }

    .company-name {
      font-size: 21px;
      line-height: 1.14;
      font-weight: 800;
      color: #172033;
      letter-spacing: -0.02em;
      min-width: 0;
    }

    .raroc-pill {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      padding: 6px 10px;
      border-radius: 999px;
      background: #eefbf4;
      color: #166534;
      border: 1px solid #d2f1dd;
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .company-role {
      margin-top: 5px;
      font-size: 12px;
      color: #64748b;
      font-weight: 600;
    }

    .compact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 10px;
    }

    .mini-stat {
      background: #f8fbff;
      border: 1px solid #e2eaf4;
      border-radius: 14px;
      padding: 10px 11px;
      min-width: 0;
    }

    .mini-label {
      font-size: 10px;
      font-weight: 800;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 4px;
    }

    .mini-value {
      font-size: 13px;
      font-weight: 800;
      color: #172033;
      line-height: 1.2;
      word-break: break-word;
    }

    .compact-pair-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 10px;
    }

    .compact-box {
      background: #f8fafc;
      border: 1px solid #e5edf5;
      border-radius: 14px;
      padding: 10px 11px;
      min-width: 0;
    }

    .compact-box .mini-value {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .exposure-visual {
      background: linear-gradient(180deg, #f8fbff 0%, #f4f8fd 100%);
      border: 1px solid #e2eaf4;
      border-radius: 14px;
      padding: 11px;
      margin-bottom: 10px;
    }

    .exposure-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
    }

    .exposure-total {
      font-size: 15px;
      font-weight: 800;
      color: #172033;
    }

    .stack-bar {
      width: 100%;
      height: 10px;
      background: #e7eef6;
      border-radius: 999px;
      overflow: hidden;
      display: flex;
      margin-bottom: 8px;
    }

    .stack-funded {
      height: 100%;
      background: linear-gradient(90deg, #2f6fed 0%, #4f8cff 100%);
    }

    .stack-nonfunded {
      height: 100%;
      background: linear-gradient(90deg, #8b5cf6 0%, #a78bfa 100%);
    }

    .legend-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .legend-item {
      background: #ffffff;
      border: 1px solid #e4ebf3;
      border-radius: 12px;
      padding: 8px 9px;
    }

    .legend-head {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
    }

    .legend-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .legend-dot-funded {
      background: #2f6fed;
    }

    .legend-dot-nonfunded {
      background: #8b5cf6;
    }

    .legend-label {
      font-size: 10px;
      font-weight: 800;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .legend-value {
      font-size: 13px;
      font-weight: 800;
      color: #172033;
    }

    .legend-sub {
      margin-top: 2px;
      font-size: 10px;
      color: #64748b;
    }

    .risk-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 10px;
    }

    .risk-label {
      font-size: 12px;
      font-weight: 700;
      color: #475569;
    }

    .dot-score {
      display: flex;
      gap: 6px;
    }

    .dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      border: 2px solid #d5dde7;
      background: #ffffff;
    }

    .dot.filled {
      background: #2f6fed;
      border-color: #2f6fed;
    }

    .dot.warning {
      background: #f59e0b;
      border-color: #f59e0b;
    }

    .dot.danger {
      background: #ef4444;
      border-color: #ef4444;
    }

    .expand-area {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.38s ease, opacity 0.24s ease;
      border-top: 1px solid transparent;
      background: linear-gradient(180deg, #fbfdff 0%, #f6f9fd 100%);
    }

    .company-card.expanded .expand-area {
      max-height: 1200px;
      opacity: 1;
      border-top-color: #e6edf5;
    }

    .expand-inner {
      padding: 0 16px 16px 16px;
    }

    .section-title {
      font-size: 11px;
      font-weight: 800;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin: 16px 0 10px 0;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .detail-item {
      background: #ffffff;
      border: 1px solid #e4ebf3;
      border-radius: 16px;
      padding: 12px;
    }

    .detail-item.wide {
      grid-column: 1 / -1;
    }

    .detail-top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
      margin-bottom: 4px;
    }

    .detail-title {
      font-size: 13px;
      font-weight: 800;
      color: #172033;
    }

    .detail-tag {
      font-size: 11px;
      font-weight: 800;
      color: #1f4fd1;
      background: #eef4ff;
      border: 1px solid #d6e2ff;
      border-radius: 999px;
      padding: 5px 9px;
      white-space: nowrap;
    }

    .detail-sub {
      font-size: 12px;
      color: #64748b;
      line-height: 1.4;
    }

    .flag-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .flag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 11px;
      font-weight: 800;
      border: 1px solid transparent;
    }

    .flag::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }

    .flag-clear {
      background: #e9f8ef;
      color: #17663a;
      border-color: #cbeed7;
    }

    .flag-clear::before {
      background: #22c55e;
    }

    .flag-watch {
      background: #fff7df;
      color: #a16207;
      border-color: #f7e3a5;
    }

    .flag-watch::before {
      background: #f59e0b;
    }

    .flag-alert {
      background: #fdecec;
      color: #a12622;
      border-color: #f5c7c5;
    }

    .flag-alert::before {
      background: #ef4444;
    }

    .toggle-btn {
      width: 100%;
      margin-top: 12px;
      border: 1px solid #d9e2ee;
      background: #ffffff;
      color: #1f2a44;
      border-radius: 12px;
      padding: 9px 14px;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .toggle-btn:hover {
      background: #f8fbff;
      border-color: #bfd0e5;
    }

    @media (max-width: 900px) {
      body {
        padding: 8px;
      }

      .viewer-shell {
        height: calc(100vh - 16px);
      }

      .toolbar {
        top: 10px;
        right: 10px;
      }

      .company-card {
        width: 360px;
        max-width: 360px;
      }

      .name-row {
        flex-direction: column;
        align-items: flex-start;
      }

      .compact-grid,
      .compact-pair-grid,
      .legend-row,
      .detail-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ---- additions for the Account Plan group hierarchy ---- */
    .hier-head {
      position: absolute;
      top: 14px;
      left: 14px;
      z-index: 30;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      flex-wrap: wrap;
      max-width: calc(100% - 320px);
      padding: 10px 14px;
      background: rgba(255,255,255,0.95);
      border: 1px solid #e7edf5;
      border-radius: 16px;
      box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
      backdrop-filter: blur(10px);
    }
    .hier-title { font-size: 13px; font-weight: 800; color: #0f172a; letter-spacing: .01em; }
    .hier-sub { margin-top: 2px; font-size: 11px; font-weight: 600; color: #64748b; }
    .hier-metrics { display: flex; gap: 14px; flex-wrap: wrap; }
    .hier-metric { min-width: 78px; }
    .hier-metric .m-label {
      font-size: 9px; font-weight: 800; letter-spacing: .09em;
      text-transform: uppercase; color: #94a3b8;
    }
    .hier-metric .m-value { font-size: 14px; font-weight: 800; color: #0f172a; margin-top: 1px; }
    .hier-legend { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .legend-chip {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 10px; font-weight: 700; color: #334155;
    }
    .legend-swatch {
      width: 12px; height: 12px; border-radius: 4px; border: 2px solid #dfe7f0; background: #fff;
    }
    .swatch-parent { border-color: #1e3a8a; background: #eef2ff; }
    .swatch-sub { border-color: #0e7490; background: #ecfeff; }
    .swatch-related { border-color: #b45309; background: #fffbeb; }
    .swatch-ubo { border-color: #7c3aed; background: #f5f3ff; }
    .swatch-fab { border-color: #16a34a; background: #f0fdf4; }
    .swatch-nonfab { border-color: #94a3b8; background: #f8fafc; border-style: dashed; }

    /* kind-driven card accents, layered on top of the original card styling */
    .company-card.kind-parent { border-color: #1e3a8a; }
    .company-card.kind-subsidiary { border-color: #0e7490; }
    .company-card.kind-related { border-color: #b45309; }
    .company-card.kind-ubo { border-color: #7c3aed; }
    .company-card.non-client { border-style: dashed; border-color: #94a3b8; background: #fcfdfe; }

    .kind-badge {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 3px 9px; border-radius: 999px;
      font-size: 10px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase;
    }
    .kind-badge.kb-parent { background: #eef2ff; color: #1e3a8a; }
    .kind-badge.kb-subsidiary { background: #ecfeff; color: #0e7490; }
    .kind-badge.kb-related { background: #fffbeb; color: #b45309; }
    .kind-badge.kb-ubo { background: #f5f3ff; color: #7c3aed; }
    .client-badge {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 3px 9px; border-radius: 999px;
      font-size: 10px; font-weight: 800;
    }
    .client-badge.is-client { background: #f0fdf4; color: #15803d; }
    .client-badge.not-client { background: #f1f5f9; color: #64748b; }

    .branch-toggle {
      margin-top: 10px;
      padding: 5px 14px;
      border: 1px solid #cbd5e1;
      border-radius: 999px;
      background: #ffffff;
      color: #334155;
      font: 700 11px/1 "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0.2px;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
      transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    }
    .branch-toggle:hover { background: #1e3a8a; border-color: #1e3a8a; color: #ffffff; }
    .tree li.is-collapsed > ul { display: none; }

    .detail-panel {
      position: absolute;
      top: 14px; right: 14px; bottom: 14px;
      width: 340px;
      z-index: 40;
      background: #ffffff;
      border: 1px solid #e7edf5;
      border-radius: 20px;
      box-shadow: -12px 0 40px rgba(15, 23, 42, 0.12);
      padding: 18px;
      overflow-y: auto;
      transform: translateX(calc(100% + 24px));
      transition: transform .26s ease;
    }
    .detail-panel.open { transform: translateX(0); }
    .dp-close {
      position: absolute; top: 12px; right: 12px;
      border: 1px solid #d9e2ee; background: #fff; color: #1f2a44;
      width: 28px; height: 28px; border-radius: 9px; cursor: pointer; font-weight: 800;
    }
    .dp-name { font-size: 16px; font-weight: 800; color: #0f172a; padding-right: 34px; }
    .dp-role { font-size: 11px; font-weight: 600; color: #64748b; margin-top: 2px; }
    .dp-badges { display: flex; gap: 6px; flex-wrap: wrap; margin: 12px 0 4px; }
    .dp-section {
      margin-top: 16px; font-size: 9px; font-weight: 800; letter-spacing: .1em;
      text-transform: uppercase; color: #94a3b8;
    }
    .dp-row {
      display: flex; justify-content: space-between; gap: 10px;
      padding: 7px 0; border-bottom: 1px solid #f1f5f9;
      font-size: 12px;
    }
    .dp-row span:first-child { color: #64748b; font-weight: 600; }
    .dp-row span:last-child { color: #0f172a; font-weight: 800; text-align: right; }
    .dp-note { font-size: 11.5px; color: #475569; line-height: 1.5; margin-top: 6px; }
    .dp-link {
      display: inline-block; margin-top: 14px; padding: 9px 14px;
      background: #1e3a8a; color: #fff; border: 0; border-radius: 10px;
      font-size: 12px; font-weight: 800; cursor: pointer;
    }
    .dp-link[disabled] { background: #cbd5e1; cursor: default; }

    .hier-state {
      position: absolute; inset: 0; z-index: 25;
      display: flex; align-items: center; justify-content: center;
      background: rgba(255,255,255,0.92);
      font-size: 13px; font-weight: 700; color: #475569;
      text-align: center; padding: 40px;
    }
    .hier-state.hidden { display: none; }

    @media (max-width: 900px) {
      .hier-head { max-width: calc(100% - 28px); }
      .detail-panel { width: calc(100% - 28px); }
    }

  </style>
</head>
<body>
  <div class="viewer-shell">
    <div class="hier-head">
      <div>
        <div class="hier-title" id="hierTitle">Group Hierarchy &amp; UBO</div>
        <div class="hier-sub" id="hierSub">Loading…</div>
      </div>
      <div class="hier-metrics">
