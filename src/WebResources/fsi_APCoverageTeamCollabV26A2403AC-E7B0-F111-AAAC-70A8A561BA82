<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Coverage Team Collaboration</title>
  <style>
/* Shared chrome for the new Account Plan tabs.
 * Tokens mirror webresources/account-plan-summary-live/styles.css so the new screens
 * read as part of the same application. */
:root {
  color-scheme: light;
  --cp-bg: #ffffff;
  --cp-bg-elevated: #f6f9fd;
  --cp-surface: #ffffff;
  --cp-surface-soft: #f2f7fc;
  --cp-border: #dbe5f0;
  --cp-border-strong: #8ba3bf;
  --cp-text: #172033;
  --cp-text-muted: #55657d;
  --cp-text-soft: #6c7d95;
  --cp-accent: #1e3a8a;
  --cp-accent-soft: rgba(30, 58, 138, 0.07);
  --cp-success: #16a34a;
  --cp-danger: #dc2626;
  --cp-warning: #d97706;
  --cp-link: #1d4ed8;
  --cp-series-1: #1e3a8a;
  --cp-series-2: #2f6fb5;
  --cp-series-3: #5aa0dd;
  --cp-series-4: #0e7490;
  --cp-series-5: #7c3aed;
  --cp-series-6: #64748b;
  --cp-shadow: 0 10px 30px rgba(23, 32, 51, 0.08);
}
html[data-theme="dark"] {
  color-scheme: dark;
  --cp-bg: #0f172a;
  --cp-bg-elevated: #131f38;
  --cp-surface: #16233d;
  --cp-surface-soft: #1c2b47;
  --cp-border: #2b3b58;
  --cp-border-strong: #44577a;
  --cp-text: #e2e8f0;
  --cp-text-muted: #94a3b8;
  --cp-text-soft: #b0bccd;
  --cp-accent: #7ea6e0;
  --cp-accent-soft: rgba(126, 166, 224, 0.15);
  --cp-success: #4ade80;
  --cp-danger: #f87171;
  --cp-warning: #fbbf24;
  --cp-link: #93c5fd;
  --cp-series-1: #7ea6e0;
  --cp-series-2: #4f9bd8;
  --cp-series-3: #93c5fd;
  --cp-series-4: #5eead4;
  --cp-series-5: #c4a2f0;
  --cp-series-6: #a5b4c8;
  --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
}

*, *::before, *::after { box-sizing: border-box; }
[hidden] { display: none !important; }

body {
  margin: 0;
  background: var(--cp-bg);
  color: var(--cp-text);
  font: 13px/1.45 "Segoe UI", Aptos, Calibri, -apple-system, BlinkMacSystemFont, sans-serif;
  -webkit-font-smoothing: antialiased;
}
main { max-width: 1440px; margin: 0 auto; padding: 14px 18px 28px; }

/* ---- page header --------------------------------------------------------- */
.page-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 18px; flex-wrap: wrap; margin-bottom: 14px;
}
.page-title { font-size: 17px; font-weight: 700; letter-spacing: -0.01em; }
.page-sub { margin-top: 3px; font-size: 12px; color: var(--cp-text-muted); }
.source-note {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 6px 11px; border-radius: 999px;
  background: var(--cp-surface); border: 1px solid var(--cp-border);
  font-size: 11px; font-weight: 600; color: var(--cp-text-muted);
}
.source-note .dot {
  width: 7px; height: 7px; border-radius: 50%; background: var(--cp-success);
}
.demo-note {
  margin-bottom: 12px; padding: 8px 12px; border-radius: 10px;
  background: var(--cp-accent-soft); border: 1px solid var(--cp-border);
  font-size: 11px; font-weight: 600; color: var(--cp-text-muted);
}

/* ---- layout primitives --------------------------------------------------- */
.grid { display: grid; gap: 12px; }
.grid.k2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.grid.k3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.grid.k4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.grid.k5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.grid.k6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.span2 { grid-column: span 2; }
.stack { display: flex; flex-direction: column; gap: 12px; }
.row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.spacer { flex: 1; }

.card {
  background: var(--cp-surface);
  border: 1px solid var(--cp-border);
  border-radius: 14px;
  padding: 14px 16px;
  box-shadow: 0 1px 2px rgba(0,0,0,0.03);
}
.card-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 10px; margin-bottom: 10px;
}
.card-title { font-size: 13px; font-weight: 700; }
.card-sub { font-size: 11px; color: var(--cp-text-muted); font-weight: 600; }

/* ---- KPI ----------------------------------------------------------------- */
.kpi { position: relative; overflow: hidden; }
.kpi::after {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: var(--cp-accent); opacity: .85;
}
.kpi-label {
  font-size: 10px; font-weight: 700; letter-spacing: .07em;
  text-transform: uppercase; color: var(--cp-text-soft);
}
.kpi-value { font-size: 22px; font-weight: 700; margin-top: 5px; letter-spacing: -0.02em; }
.kpi-value.sm { font-size: 17px; }
.kpi-meta { margin-top: 5px; font-size: 11px; color: var(--cp-text-muted); font-weight: 600; }
.kpi.good::after { background: var(--cp-success); }
.kpi.warn::after { background: var(--cp-warning); }
.kpi.bad::after { background: var(--cp-danger); }

.delta { font-weight: 700; }
.delta.up { color: var(--cp-success); }
.delta.down { color: var(--cp-danger); }
.delta.flat { color: var(--cp-text-muted); }

/* ---- pills --------------------------------------------------------------- */
.pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 9px; border-radius: 999px;
  font-size: 10.5px; font-weight: 700; white-space: nowrap;
  border: 1px solid transparent;
}
.pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.pill.ok { background: rgba(22,163,74,.10); color: var(--cp-success); border-color: rgba(22,163,74,.22); }
.pill.warn { background: rgba(245,158,11,.12); color: #b45309; border-color: rgba(245,158,11,.28); }
.pill.bad { background: rgba(220,38,38,.10); color: var(--cp-danger); border-color: rgba(220,38,38,.22); }
.pill.info { background: rgba(29,78,216,.10); color: var(--cp-link); border-color: rgba(29,78,216,.22); }
.pill.mute { background: var(--cp-surface-soft); color: var(--cp-text-muted); border-color: var(--cp-border); }
.pill.plain::before { display: none; }

/* ---- tables -------------------------------------------------------------- */
.table-wrap { overflow-x: auto; }
table.data { width: 100%; border-collapse: collapse; font-size: 12px; }
table.data th {
  text-align: left; padding: 8px 10px;
  font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
  color: var(--cp-text-soft); border-bottom: 1px solid var(--cp-border); white-space: nowrap;
}
table.data td {
  padding: 9px 10px; border-bottom: 1px solid var(--cp-border);
  vertical-align: middle;
}
table.data tbody tr:hover { background: var(--cp-surface-soft); }
table.data td.num, table.data th.num { text-align: right; font-variant-numeric: tabular-nums; }
table.data td.strong { font-weight: 700; }
table.data tr.total td { font-weight: 700; border-top: 2px solid var(--cp-border-strong); }

/* ---- bars ---------------------------------------------------------------- */
.bar {
  position: relative; height: 7px; border-radius: 999px;
  background: var(--cp-surface-soft); overflow: hidden; min-width: 70px;
}
.bar > span { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 999px; background: var(--cp-accent); }
.bar.ok > span { background: var(--cp-success); }
.bar.warn > span { background: var(--cp-warning); }
.bar.bad > span { background: var(--cp-danger); }
.bar-cell { display: flex; align-items: center; gap: 9px; min-width: 150px; }
.bar-cell .val { font-variant-numeric: tabular-nums; font-weight: 700; min-width: 46px; text-align: right; }

/* ---- charts -------------------------------------------------------------- */
.chart { width: 100%; height: 132px; display: block; }
.chart-legend { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 8px; }
.legend-key { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: var(--cp-text-muted); }
.legend-key i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

/* ---- collapsible --------------------------------------------------------- */
details.section { border: 1px solid var(--cp-border); border-radius: 14px; background: var(--cp-surface); }
details.section > summary {
  list-style: none; cursor: pointer; padding: 12px 16px;
  font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 10px;
}
details.section > summary::-webkit-details-marker { display: none; }
details.section > summary::after {
  content: "\25BE"; margin-left: auto; color: var(--cp-text-soft); transition: transform .18s ease;
}
details.section[open] > summary::after { transform: rotate(180deg); }
details.section > .section-body { padding: 0 16px 16px; }

/* ---- misc ---------------------------------------------------------------- */
.muted { color: var(--cp-text-muted); }
.tiny { font-size: 11px; }
.nowrap { white-space: nowrap; }
.tip { cursor: help; border-bottom: 1px dotted var(--cp-border-strong); }
.state {
  padding: 34px; text-align: center; color: var(--cp-text-muted);
  font-size: 13px; font-weight: 600;
}
.empty {
  padding: 22px; text-align: center; color: var(--cp-text-muted);
  font-size: 12px; font-weight: 600; border: 1px dashed var(--cp-border); border-radius: 12px;
}

@media (max-width: 1100px) {
  .grid.k5, .grid.k6 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grid.k4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 760px) {
  main { padding: 12px 12px 22px; }
  .grid.k2, .grid.k3, .grid.k4, .grid.k5, .grid.k6 { grid-template-columns: 1fr; }
  .span2 { grid-column: span 1; }
}

/* Compact label/value list used to fill tall cards beside a chart. */
.stat-list { margin-top: 16px; border-top: 1px solid var(--cp-border); }
.stat-list .stat-row {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 12px; padding: 9px 2px; border-bottom: 1px solid var(--cp-border);
  font-size: 12px;
}
.stat-list .stat-row:last-child { border-bottom: 0; }
.stat-list .stat-row span:first-child { color: var(--cp-text-soft); }
.stat-list .stat-row span:last-child { font-weight: 700; color: var(--cp-text); }

/* ---- buttons -------------------------------------------------------------- */
.btn {
  font: inherit;
  font-size: 12px;
  font-weight: 600;
  color: #fff;
  background: var(--cp-accent);
  border: 1px solid var(--cp-accent);
  border-radius: 6px;
  padding: 6px 12px;
  cursor: pointer;
  white-space: nowrap;
}
.btn:hover { filter: brightness(1.12); }
.btn.ghost {
  color: var(--cp-accent);
  background: transparent;
  border-color: var(--cp-border-strong);
}
.btn.ghost:hover { background: var(--cp-accent-soft); filter: none; }
.btn.tiny-btn { font-size: 11px; padding: 3px 9px; }

/* ---- departmental readiness ---------------------------------------------- */
.dept-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(178px, 1fr));
  gap: 10px;
}
.dept {
  border: 1px solid var(--cp-border);
  border-radius: 8px;
  padding: 11px 12px;
  background: var(--cp-bg-elevated);
  position: relative;
  overflow: hidden;
}
.dept::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: var(--cp-border-strong);
}
.dept.ok::before { background: var(--cp-success); }
.dept.warn::before { background: var(--cp-warning); }
.dept.bad::before { background: var(--cp-danger); }
.dept.idle { background: transparent; border-style: dashed; }
.dept.idle::before { background: transparent; }
.dept-name {
  font-size: 12px;
  font-weight: 700;
  color: var(--cp-text);
  margin-bottom: 6px;
}
.dept-meta {
  font-size: 11px;
  color: var(--cp-text-soft);
  margin-top: 7px;
  line-height: 1.5;
}

/* ---- ask list ------------------------------------------------------------- */
.ask {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 10px 2px;
  border-bottom: 1px solid var(--cp-border);
  cursor: pointer;
}
.ask:last-child { border-bottom: 0; }
.ask:hover { background: var(--cp-accent-soft); }
.ask-main { flex: 1; min-width: 0; }
.ask-title {
  font-size: 12.5px;
  font-weight: 650;
  color: var(--cp-text);
  margin-bottom: 3px;
}
.ask-meta {
  font-size: 11px;
  color: var(--cp-text-soft);
  display: flex;
  flex-wrap: wrap;
  gap: 4px 10px;
}
.ask-note {
  font-size: 11.5px;
  color: var(--cp-text-muted);
  margin-top: 5px;
  line-height: 1.55;
}

/* ---- people --------------------------------------------------------------- */
.person {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 2px;
  border-bottom: 1px solid var(--cp-border);
}
.person:last-child { border-bottom: 0; }
.avatar {
  width: 30px; height: 30px;
  flex: 0 0 30px;
  border-radius: 50%;
  background: var(--cp-accent-soft);
  color: var(--cp-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11.5px;
  font-weight: 700;
}
.person-main { flex: 1; min-width: 0; }
.person-name { font-size: 12.5px; font-weight: 650; color: var(--cp-text); }
.person-role { font-size: 11px; color: var(--cp-text-soft); }
.person a { color: var(--cp-link); text-decoration: none; font-size: 11px; }
.person a:hover { text-decoration: underline; }

/* ---- drawer --------------------------------------------------------------- */
.drawer-scrim {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.32);
  z-index: 40;
}
.drawer {
  position: fixed;
  top: 0; right: 0; bottom: 0;
  width: min(470px, 92vw);
  background: var(--cp-bg);
  border-left: 1px solid var(--cp-border);
  box-shadow: -10px 0 30px rgba(15, 23, 42, 0.16);
  z-index: 41;
  display: flex;
  flex-direction: column;
}
.drawer-head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 15px 16px;
  border-bottom: 1px solid var(--cp-border);
}
.drawer-title { font-size: 14px; font-weight: 700; color: var(--cp-text); }
.drawer-sub { font-size: 11.5px; color: var(--cp-text-soft); margin-top: 3px; }
.drawer-close {
  font: inherit;
  font-size: 15px;
  line-height: 1;
  color: var(--cp-text-soft);
  background: transparent;
  border: 0;
  cursor: pointer;
  padding: 2px 4px;
}
.drawer-close:hover { color: var(--cp-text); }
.drawer-body { padding: 14px 16px 22px; overflow: auto; flex: 1; }
.drawer-body h4 {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--cp-text-soft);
  margin: 16px 0 7px;
  font-weight: 700;
}
.drawer-body h4:first-child { margin-top: 0; }
.drawer-body p { font-size: 12.5px; line-height: 1.6; color: var(--cp-text-muted); margin: 0 0 8px; }

/* ---- vetting strip -------------------------------------------------------- */
.vet { display: flex; gap: 6px; flex-wrap: wrap; }
.vet-item {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 10.5px;
  font-weight: 600;
  color: var(--cp-text-soft);
  border: 1px solid var(--cp-border);
  border-radius: 999px;
  padding: 2px 8px;
  background: var(--cp-bg-elevated);
}
.vet-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--cp-border-strong);
}
.vet-dot.ok { background: var(--cp-success); }
.vet-dot.warn { background: var(--cp-warning); }
.vet-sel {
  font: inherit;
  font-size: 11px;
  color: var(--cp-text);
  background: var(--cp-bg);
  border: 1px solid var(--cp-border);
  border-radius: 5px;
  padding: 3px 5px;
}

  </style>
</head>
<body>
<main id="root">
<div class="page-head">
  <div>
    <div class="page-title">Coverage Team Collaboration</div>
    <div class="page-sub">Who owes us what before this plan goes to committee?</div>
  </div>
  <span class="source-note"><span class="dot"></span>Source: Global Team Information Requests</span>
</div>

<div id="state" class="state">Loading coverage collaboration…</div>

<div id="content" hidden>
  <div class="grid k4" id="kpiRow"></div>

  <div class="card" style="margin-top:12px;">
    <div class="card-head">
      <div>
        <div class="card-title">Departmental readiness</div>
        <div class="card-sub">Derived from the status of information requests raised on this plan</div>
      </div>
      <button class="btn" id="btnNew" type="button">Request input</button>
    </div>
    <div class="dept-grid" id="deptGrid"></div>
  </div>

  <div class="grid k2" style="margin-top:12px;">
    <div class="card">
      <div class="card-head">
        <div>
          <div class="card-title">Outstanding asks</div>
          <div class="card-sub" id="openSub"></div>
        </div>
      </div>
      <div id="openBody"></div>
    </div>

    <div class="card">
      <div class="card-head">
        <div>
          <div class="card-title">Received input</div>
          <div class="card-sub">Submitted responses available to the plan</div>
        </div>
      </div>
      <div id="doneBody"></div>
    </div>
  </div>

  <div class="grid k2" style="margin-top:12px;">
    <div class="card">
      <div class="card-head">
        <div>
          <div class="card-title">Coverage team</div>
          <div class="card-sub" id="rosterSub"></div>
        </div>
      </div>
      <div id="rosterBody"></div>
    </div>

    <div class="card">
      <div class="card-head">
        <div>
          <div class="card-title">Strategic objective</div>
          <div class="card-sub">Plan strategy and relationship return</div>
        </div>
      </div>
      <div id="objectiveBody"></div>
    </div>
  </div>
</div>

<div class="drawer-scrim" id="scrim" hidden></div>
<aside class="drawer" id="drawer" hidden>
  <div class="drawer-head">
    <div>
      <div class="drawer-title" id="drawerTitle"></div>
      <div class="drawer-sub" id="drawerSub"></div>
    </div>
    <button class="drawer-close" id="drawerClose" type="button" aria-label="Close">&#10005;</button>
  </div>
  <div class="drawer-body" id="drawerBody"></div>
</aside>

</main>
<script>
/* Shared Account Plan tab runtime.
 * Resolves the current fsi_accountplanning record and its fsi_customer account dynamically
 * from the hosting form, then exposes small Web API + formatting helpers.
 * No record GUIDs are hardcoded anywhere.
 * Mirrors the pattern already used by fsi_LimitUtilizationLive and fsi_shareofwallet.
 */
var APCtx = (function () {
  "use strict";

  var API = "/api/data/v9.2/";

  function getXrm() {
    try {
      if (window.parent && window.parent !== window && window.parent.Xrm) return window.parent.Xrm;
    } catch (e) { /* cross-origin during navigation */ }
    if (window.Xrm) return window.Xrm;
    return null;
  }

  function clientUrl() {
    var xrm = getXrm();
    if (!xrm) return "";
    try { return xrm.Utility.getGlobalContext().getClientUrl(); } catch (e) { return ""; }
  }

  function normaliseGuid(value) {
    return String(value || "").replace(/[{}]/g, "").toLowerCase();
  }

  /* Resolve { planId, accountId, accountName, planTitle, clientUrl }.
   * Works whether the web resource sits on the account plan form or (as a fallback)
   * directly on an account form. */
  function resolve() {
    var xrm = getXrm();
    if (!xrm) {
      return Promise.reject(new Error(
        "Xrm context not found. Host this page as a web resource inside the model-driven app."));
    }
    var url = clientUrl();
    var form = xrm.Page;
    var entityName = "";
    var recordId = "";
    try {
      entityName = form.data.entity.getEntityName();
      recordId = normaliseGuid(form.data.entity.getId());
    } catch (e) { /* form not ready */ }

    if (entityName === "account") {
      var accountName = "";
      try { accountName = form.getAttribute("name").getValue() || ""; } catch (e) { }
      return Promise.resolve({
        clientUrl: url, planId: null, planTitle: "", accountId: recordId, accountName: accountName
      });
    }

    var lookup = null;
    try {
      var attribute = form.getAttribute("fsi_customer");
      lookup = attribute && attribute.getValue();
    } catch (e) { }

    var planTitle = "";
    try {
      var title = form.getAttribute("fsi_title");
      planTitle = (title && title.getValue()) || "";
    } catch (e) { }

    if (lookup && lookup[0] && String(lookup[0].entityType).toLowerCase() === "account") {
      return Promise.resolve({
        clientUrl: url, planId: recordId, planTitle: planTitle,
        accountId: normaliseGuid(lookup[0].id), accountName: lookup[0].name || ""
      });
    }

    // The lookup may not be loaded onto the form yet - read it back from the plan record.
    if (!recordId) {
      return Promise.reject(new Error("The account plan record has not been saved yet."));
    }
    return fetchJson(url + API + "fsi_accountplannings(" + recordId + ")" +
      "?$select=fsi_title,_fsi_customer_value").then(function (plan) {
        var id = plan["_fsi_customer_value"];
        if (!id) throw new Error("This account plan has no Customer set, so there is nothing to show yet.");
        return {
          clientUrl: url,
          planId: recordId,
          planTitle: plan.fsi_title || planTitle,
          accountId: normaliseGuid(id),
          accountName: plan["_fsi_customer_value@OData.Community.Display.V1.FormattedValue"] || ""
        };
      });
  }

  function fetchJson(url) {
    return fetch(url, {
      headers: {
        "Accept": "application/json",
        "OData-MaxVersion": "4.0",
        "OData-Version": "4.0",
        "Prefer": 'odata.include-annotations="OData.Community.Display.V1.FormattedValue"'
      },
      credentials: "same-origin"
    }).then(function (response) {
      if (!response.ok) {
        return response.text().then(function (text) {
          throw new Error("Dataverse " + response.status + ": " + text.slice(0, 300));
        });
      }
      return response.json();
    });
  }

  /* Read a table, tolerating tables/columns that are absent in a given environment. */
  function query(scope, entitySet, options) {
    var url = scope.clientUrl + API + entitySet + (options ? "?" + options : "");
    return fetchJson(url).then(function (result) {
      return result.value || [];
    }).catch(function (error) {
      console.warn("[AccountPlan] " + entitySet + " unavailable:", error.message);
      return [];
    });
  }

  function record(scope, entitySet, id, options) {
    var url = scope.clientUrl + API + entitySet + "(" + id + ")" + (options ? "?" + options : "");
    return fetchJson(url).catch(function (error) {
      console.warn("[AccountPlan] " + entitySet + "(" + id + ") unavailable:", error.message);
      return null;
    });
  }

  function openRecord(entityName, id) {
    var xrm = getXrm();
    if (!xrm || !id) return;
    try { xrm.Navigation.openForm({ entityName: entityName, entityId: id }); } catch (e) { }
  }

  // ---- formatting -----------------------------------------------------------
  function number(value) {
    return typeof value === "number" && isFinite(value) ? value : null;
  }

  function compact(value, currency) {
    var n = number(value);
    if (n === null) return "–";
    var prefix = currency ? currency + " " : "";
    var sign = n < 0 ? "-" : "";
    var abs = Math.abs(n);
    if (abs >= 1e9) return sign + prefix + (abs / 1e9).toFixed(abs / 1e9 >= 100 ? 0 : 1) + "bn";
    if (abs >= 1e6) return sign + prefix + (abs / 1e6).toFixed(abs / 1e6 >= 100 ? 0 : 1) + "m";
    if (abs >= 1e3) return sign + prefix + (abs / 1e3).toFixed(0) + "k";
    return sign + prefix + abs.toFixed(0);
  }

  function pct(value, digits) {
    var n = number(value);
    return n === null ? "–" : n.toFixed(typeof digits === "number" ? digits : 1) + "%";
  }

  function ratio(value, digits) {
    var n = number(value);
    return n === null ? "–" : n.toFixed(typeof digits === "number" ? digits : 2) + "x";
  }

  function dateText(value) {
    if (!value) return "–";
    var d = new Date(value);
    if (isNaN(d.getTime())) return "–";
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
  }

  function daysBetween(from, to) {
    var a = new Date(from), b = to ? new Date(to) : new Date();
    if (isNaN(a.getTime()) || isNaN(b.getTime())) return null;
    return Math.round((b - a) / 86400000);
  }

  function escapeHtml(value) {
    return String(value == null ? "" : value)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function initials(name) {
    var parts = String(name || "?").trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return "?";
    return parts[0].charAt(0).toUpperCase();
  }

  function sum(rows, field) {
    return rows.reduce(function (total, row) {
      var n = number(row[field]);
      return total + (n === null ? 0 : n);
    }, 0);
  }

  return {
    API: API, resolve: resolve, query: query, record: record, fetchJson: fetchJson,
    openRecord: openRecord, getXrm: getXrm,
    compact: compact, pct: pct, ratio: ratio, dateText: dateText, daysBetween: daysBetween,
    escapeHtml: escapeHtml, initials: initials, num: number, sum: sum
  };
}());

</script>
<script>
/* Lightweight inline-SVG chart helpers shared by the new Account Plan tabs.
 * Deliberately dependency-free: no chart library is loaded into the model-driven app. */
var APChart = (function () {
  "use strict";

  var NS = "http://www.w3.org/2000/svg";

  function css(name, fallback) {
    try {
      var value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return value || fallback;
    } catch (e) { return fallback; }
  }

  function el(tag, attrs) {
    var node = document.createElementNS(NS, tag);
    Object.keys(attrs || {}).forEach(function (key) { node.setAttribute(key, attrs[key]); });
    return node;
  }

  function svg(width, height) {
    var node = el("svg", {
      viewBox: "0 0 " + width + " " + height,
      preserveAspectRatio: "none",
      class: "chart"
    });
    node.setAttribute("role", "img");
    return node;
  }

  function extent(series, zeroBaseline) {
    var values = [];
    series.forEach(function (s) {
      s.values.forEach(function (v) { if (typeof v === "number" && isFinite(v)) values.push(v); });
    });
    if (!values.length) return { min: 0, max: 1 };
    var min = Math.min.apply(null, values);
    var max = Math.max.apply(null, values);
    if (min === max) { max = min + Math.abs(min || 1); }
    if (zeroBaseline === false) {
      // Trend charts read better when the axis hugs the data instead of anchoring at zero.
      var spread = max - min;
      return { min: min - spread * 0.35, max: max + spread * 0.25 };
    }
    min = Math.min(min, 0);
    var pad = (max - min) * 0.12;
    return { min: min, max: max + pad };
  }

  /* Category labels are centred, except the outer two which would otherwise clip. */
  function axisLabel(node, text, x, y, index, count, color) {
    var anchor = "middle";
    if (count > 1 && index === 0) anchor = "start";
    if (count > 1 && index === count - 1) anchor = "end";
    var label = el("text", {
      x: x, y: y, "text-anchor": anchor, "font-size": 10, "font-weight": 600, fill: color
    });
    label.textContent = text;
    node.appendChild(label);
  }

  /* Grouped bar chart. series = [{label, values:[], color}], labels = category names.
     options.refLine = {value, label, color} draws a horizontal threshold across the plot. */
  function bars(target, labels, series, options) {
    options = options || {};
    var host = typeof target === "string" ? document.getElementById(target) : target;
    if (!host) return;
    host.innerHTML = "";

    var W = 480, H = 140, padL = 6, padR = 6, padT = 12, padB = 20;
    var node = svg(W, H);
    var ref = options.refLine;
    /* The threshold has to be inside the domain or the line would sit off-canvas. */
    var domain = ref && typeof ref.value === "number"
      ? series.concat([{ values: [ref.value] }]) : series;
    var range = extent(domain);
    var plotH = H - padT - padB;
    var plotW = W - padL - padR;
    var groups = labels.length || 1;
    var groupW = plotW / groups;
    var barCount = series.length || 1;
    var barW = Math.max(4, (groupW * 0.62) / barCount);

    var y = function (value) {
      return padT + plotH - (value - range.min) / (range.max - range.min) * plotH;
    };

    // baseline
    node.appendChild(el("line", {
      x1: padL, x2: W - padR, y1: y(0), y2: y(0),
      stroke: css("--cp-border", "#dbe5f0"), "stroke-width": 1
    }));

    labels.forEach(function (label, gi) {
      var groupX = padL + groupW * gi + (groupW - barW * barCount) / 2;
      series.forEach(function (s, si) {
        var value = s.values[gi];
        if (typeof value !== "number" || !isFinite(value)) return;
        var top = Math.min(y(value), y(0));
        var height = Math.max(1.5, Math.abs(y(value) - y(0)));
        var rect = el("rect", {
          x: groupX + barW * si, y: top, width: barW, height: height,
          rx: Math.min(3, barW / 2), fill: s.color || css("--cp-accent", "#1e3a8a")
        });
        rect.appendChild(el("title", {})).textContent =
          s.label + " \u00b7 " + label + ": " + (options.format ? options.format(value) : value);
        node.appendChild(rect);
      });

      /* Long category names collide once there are more than a handful of groups, so
         clip each label to the width its group can actually afford and keep the full
         text available as a tooltip. */
      var budget = Math.max(3, Math.floor(groupW / 5.6));
      var shown = label.length > budget ? label.slice(0, budget - 1).replace(/[\s\-–]+$/, "") + "\u2026" : label;

      var text = el("text", {
        x: padL + groupW * gi + groupW / 2, y: H - 6,
        "text-anchor": "middle", "font-size": 10, "font-weight": 600,
        fill: css("--cp-text-soft", "#6c7d95")
      });
      text.textContent = shown;
      if (shown !== label) text.appendChild(el("title", {})).textContent = label;
      node.appendChild(text);    });

    if (ref && typeof ref.value === "number" && isFinite(ref.value)) {
      var refY = y(ref.value);
      node.appendChild(el("line", {
        x1: padL, x2: W - padR, y1: refY, y2: refY,
        stroke: ref.color || css("--cp-danger", "#dc2626"),
        "stroke-width": 1.5, "stroke-dasharray": "5 3"
      }));
      if (ref.label) {
        var refText = el("text", {
          x: W - padR, y: Math.max(9, refY - 4), "text-anchor": "end",
          "font-size": 9.5, "font-weight": 700,
          fill: ref.color || css("--cp-danger", "#dc2626")
        });
        refText.textContent = ref.label;
        node.appendChild(refText);
      }
    }

    host.appendChild(node);
  }

  /* Line / area chart for a single trend series. */
  function line(target, labels, values, options) {
    options = options || {};
    var host = typeof target === "string" ? document.getElementById(target) : target;
    if (!host) return;
    host.innerHTML = "";

    var W = 480, H = 140, padL = 8, padR = 8, padT = 14, padB = 20;
    var node = svg(W, H);
    var range = extent([{ values: values }], options.zeroBaseline === true);
    var plotH = H - padT - padB;
    var plotW = W - padL - padR;
    var step = values.length > 1 ? plotW / (values.length - 1) : 0;
    var color = options.color || css("--cp-accent", "#1e3a8a");

    var points = values.map(function (value, i) {
      return {
        x: padL + step * i,
        y: padT + plotH - (value - range.min) / (range.max - range.min) * plotH,
        v: value
      };
    }).filter(function (p) { return isFinite(p.y); });

    if (!points.length) { host.appendChild(node); return; }

    var path = points.map(function (p, i) { return (i ? "L" : "M") + p.x + " " + p.y; }).join(" ");
    var area = path + " L " + points[points.length - 1].x + " " + (padT + plotH) +
      " L " + points[0].x + " " + (padT + plotH) + " Z";

    node.appendChild(el("path", { d: area, fill: color, opacity: 0.12 }));
    node.appendChild(el("path", {
      d: path, fill: "none", stroke: color, "stroke-width": 2.4,
      "stroke-linecap": "round", "stroke-linejoin": "round"
    }));

    points.forEach(function (p, i) {
      var dot = el("circle", { cx: p.x, cy: p.y, r: 3.4, fill: color });
      dot.appendChild(el("title", {})).textContent =
        (labels[i] || "") + ": " + (options.format ? options.format(p.v) : p.v);
      node.appendChild(dot);
      axisLabel(node, labels[i] || "", p.x, H - 6, i, points.length,
        css("--cp-text-soft", "#6c7d95"));
    });

    host.appendChild(node);
  }

  /* Horizontal stacked bar for composition (e.g. income mix). */
  function stacked(target, segments, options) {
    options = options || {};
    var host = typeof target === "string" ? document.getElementById(target) : target;
    if (!host) return;
    host.innerHTML = "";
    var total = segments.reduce(function (sum, s) { return sum + Math.max(0, s.value || 0); }, 0);
    if (!total) { host.innerHTML = '<div class="empty">No data to chart.</div>'; return; }

    var W = 480, H = 34;
    var node = svg(W, H);
    node.style.height = "34px";
    var x = 0;
    segments.forEach(function (s) {
      var width = Math.max(0, s.value || 0) / total * W;
      if (width <= 0) return;
      var rect = el("rect", { x: x, y: 6, width: width, height: 22, fill: s.color, rx: 3 });
      rect.appendChild(el("title", {})).textContent =
        s.label + ": " + (options.format ? options.format(s.value) : s.value) +
        " (" + (s.value / total * 100).toFixed(1) + "%)";
      node.appendChild(rect);
      x += width;
    });
    host.appendChild(node);
  }

  /* Semi-circular gauge used for RAROC vs hurdle and service health. */
  function gauge(target, value, max, options) {
    options = options || {};
    var host = typeof target === "string" ? document.getElementById(target) : target;
    if (!host) return;
    host.innerHTML = "";

    var W = 240, H = 132, cx = 120, cy = 112, r = 92;
    var node = svg(W, H);
    node.style.height = "132px";

    function arc(fromPct, toPct, color, width) {
      var a0 = Math.PI * (1 + Math.min(1, Math.max(0, fromPct)));
      var a1 = Math.PI * (1 + Math.min(1, Math.max(0, toPct)));
      var large = (a1 - a0) > Math.PI ? 1 : 0;
      var d = "M " + (cx + r * Math.cos(a0)) + " " + (cy + r * Math.sin(a0)) +
        " A " + r + " " + r + " 0 " + large + " 1 " +
        (cx + r * Math.cos(a1)) + " " + (cy + r * Math.sin(a1));
      node.appendChild(el("path", {
        d: d, fill: "none", stroke: color, "stroke-width": width || 14, "stroke-linecap": "round"
      }));
    }

    var fraction = max ? Math.min(1, Math.max(0, value / max)) : 0;
    arc(0, 1, css("--cp-surface-soft", "#f2f7fc"), 14);
    if (fraction > 0.012) {
      arc(0, fraction, options.color || css("--cp-accent", "#1e3a8a"), 14);
    }

    if (typeof options.marker === "number" && max) {
      var mf = Math.min(1, Math.max(0, options.marker / max));
      var angle = Math.PI * (1 + mf);
      node.appendChild(el("line", {
        x1: cx + (r - 12) * Math.cos(angle), y1: cy + (r - 12) * Math.sin(angle),
        x2: cx + (r + 12) * Math.cos(angle), y2: cy + (r + 12) * Math.sin(angle),
        stroke: css("--cp-text", "#172033"), "stroke-width": 2.4, "stroke-linecap": "round"
      }));
      if (options.markerLabel) {
        var ml = el("text", {
          x: cx + (r + 18) * Math.cos(angle), y: cy + (r + 18) * Math.sin(angle) + 3,
          "text-anchor": mf > 0.5 ? "start" : "end", "font-size": 9, "font-weight": 700,
          fill: css("--cp-text-soft", "#6c7d95")
        });
        ml.textContent = options.markerLabel;
        node.appendChild(ml);
      }
    }

    if (options.scale !== false) {
      [[cx - r, "start", options.minLabel || "0"],
       [cx + r, "end", options.maxLabel || String(Math.round(max * 10) / 10)]].forEach(function (item) {
        var tick = el("text", {
          x: item[0], y: cy + 14, "text-anchor": item[1], "font-size": 9, "font-weight": 600,
          fill: css("--cp-text-soft", "#6c7d95")
        });
        tick.textContent = item[2];
        node.appendChild(tick);
      });
    }

    var main = el("text", {
      x: cx, y: cy - 16, "text-anchor": "middle", "font-size": 30, "font-weight": 700,
      fill: css("--cp-text", "#172033")
    });
    main.textContent = options.label || String(value);
    node.appendChild(main);

    if (options.caption) {
      var caption = el("text", {
        x: cx, y: cy + 6, "text-anchor": "middle", "font-size": 11, "font-weight": 600,
        fill: css("--cp-text-soft", "#6c7d95")
      });
      caption.textContent = options.caption;
      node.appendChild(caption);
    }
    host.appendChild(node);
  }

  var SERIES = ["#1e3a8a", "#2f6fb5", "#5aa0dd", "#0e7490", "#7c3aed", "#64748b"];

  /* Categorical colour for chart series i, resolved from the shared theme tokens. */
  function series(index) {
    var i = ((index % SERIES.length) + SERIES.length) % SERIES.length;
    return css("--cp-series-" + (i + 1), SERIES[i]);
  }

  return { bars: bars, line: line, stacked: stacked, gauge: gauge, css: css, series: series };
}());

</script>
<script>
/* Coverage Team Collaboration tab.
 *
 * This is a READ / AGGREGATE layer over the existing Global Team Information Requests
 * engine. It creates no parallel workflow:
 *
 *   raise a request  -> delegates to the existing fsi_RequestInformation dialog
 *   answer a request -> delegates to the existing fsi_InformationRequestForm
 *
 * The only write this tab performs is the internal vetting strip, which is stored as a
 * "__collab" sidecar key inside the existing fsi_responsejson memo. No schema was added:
 * the responder reads only its own field ids and ignores the sidecar.
 *
 * Departmental readiness is DERIVED from request status rather than manually set, so it
 * can never drift out of step with the underlying requests.
 */
(function () {
  "use strict";

  var DRAFT = 10200, SENT = 10201, PROGRESS = 10202, SUBMITTED = 10203, CLOSED = 10204;

  var STATUS = {};
  STATUS[DRAFT] = { text: "Draft", tone: "mute" };
  STATUS[SENT] = { text: "Sent", tone: "info" };
  STATUS[PROGRESS] = { text: "In progress", tone: "warn" };
  STATUS[SUBMITTED] = { text: "Submitted", tone: "ok" };
  STATUS[CLOSED] = { text: "Closed", tone: "mute" };

  /* fsi_requesttype option set - the departments the bank actually asks. */
  var DEPARTMENTS = [
    { value: 10000, name: "Country Coverage" },
    { value: 10001, name: "Sector Coverage" },
    { value: 10002, name: "Global Markets" },
    { value: 10003, name: "Transaction Banking" },
    { value: 10004, name: "Lending" },
    { value: 10005, name: "Credit / Risk" },
    { value: 10006, name: "Trade Finance" },
    { value: 10007, name: "DCM / ECM" }
  ];

  var VET_LANES = [
    { key: "coverage", label: "Coverage" },
    { key: "product", label: "Product" },
    { key: "risk", label: "Risk" }
  ];
  var VET_STATES = [
    { value: "", label: "Not vetted", tone: "" },
    { value: "ok", label: "Accepted", tone: "ok" },
    { value: "warn", label: "Needs work", tone: "warn" }
  ];

  var scope = null;
  var requests = [];
  var roster = [];
  var plan = null;
  var economics = [];

  function show(message) {
    var el = document.getElementById("state");
    if (message === null) {
      el.hidden = true;
      document.getElementById("content").hidden = false;
      return;
    }
    el.hidden = false;
    el.textContent = message;
    document.getElementById("content").hidden = true;
  }

  function esc(v) { return APCtx.escapeHtml(v); }

  function pill(text, tone) {
    return '<span class="pill ' + (tone || "plain") + '">' + esc(text) + "</span>";
  }

  function statusPill(value) {
    var s = STATUS[value] || STATUS[DRAFT];
    return pill(s.text, s.tone);
  }

  function isOpen(row) {
    return row.fsi_status !== SUBMITTED && row.fsi_status !== CLOSED;
  }

  /* APCtx.daysBetween treats a null "from" as the epoch, so always measure from the
   * due date and read the sign: positive = days past due, negative = days remaining. */
  function dueDelta(row) {
    if (!row.fsi_duedate) return null;
    return APCtx.daysBetween(row.fsi_duedate, null);
  }

  function daysLate(row) {
    if (!isOpen(row)) return 0;
    var delta = dueDelta(row);
    return delta !== null && delta > 0 ? delta : 0;
  }

  function dueText(row) {
    var delta = dueDelta(row);
    if (delta === null) return "No due date";
    if (!isOpen(row)) return "Due " + APCtx.dateText(row.fsi_duedate);
    if (delta > 0) return "Overdue by " + delta + (delta === 1 ? " day" : " days");
    if (delta === 0) return "Due today";
    var left = -delta;
    return "Due in " + left + (left === 1 ? " day" : " days");
  }

  function ownerOf(row) {
    return row["_fsi_requestedfromuser_value@OData.Community.Display.V1.FormattedValue"] ||
      row["_fsi_requestedfromteam_value@OData.Community.Display.V1.FormattedValue"] ||
      "Unassigned";
  }

  function departmentOf(row) {
    return row["fsi_requesttype@OData.Community.Display.V1.FormattedValue"] || "Other";
  }

  /* The seeder marks demo rows in the description; strip the marker for display. */
  function cleanText(value) {
    return String(value || "").replace(/^\s*\[ILLUSTRATIVE DEMO DATA\]\s*/i, "").trim();
  }

  // ---- vetting sidecar ------------------------------------------------------
  function parseResponse(row) {
    if (!row.fsi_responsejson) return {};
    try { return JSON.parse(row.fsi_responsejson) || {}; } catch (e) { return {}; }
  }

  function vettingOf(row) {
    var sidecar = parseResponse(row).__collab;
    return (sidecar && sidecar.vetting) || {};
  }

  // Re-reads the memo immediately before writing so a response saved by the
  // existing responder between page load and vetting is never clobbered.
  function saveVetting(row, lane, value) {
    var url = scope.clientUrl + APCtx.API + "fsi_informationrequests(" +
      row.fsi_informationrequestid + ")";
    var headers = {
      "Accept": "application/json",
      "Content-Type": "application/json; charset=utf-8",
      "OData-MaxVersion": "4.0",
      "OData-Version": "4.0"
    };

    return fetch(url + "?$select=fsi_responsejson", {
      headers: headers, credentials: "same-origin"
    }).then(function (response) {
      if (!response.ok) throw new Error("Dataverse " + response.status);
      return response.json();
    }).then(function (fresh) {
      row.fsi_responsejson = fresh.fsi_responsejson;
      var payload = parseResponse(row);
      var sidecar = payload.__collab || (payload.__collab = {});
      var vetting = sidecar.vetting || (sidecar.vetting = {});
      vetting[lane] = value;
      sidecar.vettedOn = new Date().toISOString();
      var body = JSON.stringify(payload);

      return fetch(url, {
        method: "PATCH",
        headers: headers,
        credentials: "same-origin",
        body: JSON.stringify({ fsi_responsejson: body })
      }).then(function (patched) {
        if (!patched.ok) throw new Error("Dataverse " + patched.status);
        row.fsi_responsejson = body;
      });
    });
  }

  // ---- delegation to the existing engine ------------------------------------
  function openRequest(row) {
    APCtx.openRecord("fsi_informationrequest", row.fsi_informationrequestid);
  }

  function openRequestDialog(department) {
    var xrm = APCtx.getXrm();
    if (!xrm || !xrm.Navigation || !xrm.Navigation.navigateTo) return;
    var data = { planId: scope.planId, accountId: scope.accountId };
    if (department) data.requestType = department;
    try {
      xrm.Navigation.navigateTo(
        { pageType: "webresource", webresourceName: "fsi_RequestInformation", data: JSON.stringify(data) },
        { target: 2, position: 1, width: { value: 960, unit: "px" }, height: { value: 780, unit: "px" } }
      ).then(load, function () { });
    } catch (e) { /* dialog unavailable in this context */ }
  }

  // ---- KPIs -----------------------------------------------------------------
  function renderKpis() {
    var total = requests.length;
    var answered = requests.filter(function (r) { return !isOpen(r); }).length;
    var overdue = requests.filter(function (r) { return daysLate(r) > 0; }).length;
    var engaged = {};
    requests.forEach(function (r) { engaged[r.fsi_requesttype] = true; });
    var covered = DEPARTMENTS.filter(function (d) { return engaged[d.value]; }).length;
    var rate = total ? Math.round(answered / total * 100) : 0;

    var next = requests.filter(isOpen).filter(function (r) { return r.fsi_duedate; })
      .sort(function (a, b) { return new Date(a.fsi_duedate) - new Date(b.fsi_duedate); })[0];

    var cards = [
      {
        label: "Response rate", value: rate + "%",
        meta: answered + " of " + total + " requests answered",
        tone: rate >= 70 ? "" : rate >= 40 ? "warn" : "bad"
      },
      {
        label: "Outstanding", value: String(total - answered),
        meta: total - answered ? "Awaiting input from the business" : "Nothing outstanding",
        tone: total - answered ? "" : "good"
      },
      {
        label: "Overdue", value: String(overdue),
        meta: overdue ? "Past the agreed due date" : "All open asks within date",
        tone: overdue ? "bad" : "good"
      },
      {
        label: "Departments engaged", value: covered + " / " + DEPARTMENTS.length,
        meta: next ? "Next due " + APCtx.dateText(next.fsi_duedate) : "No dated asks open",
        tone: covered >= DEPARTMENTS.length - 2 ? "" : "warn"
      }
    ];

    document.getElementById("kpiRow").innerHTML = cards.map(function (c) {
      return '<div class="card kpi ' + c.tone + '">' +
        '<div class="kpi-label">' + esc(c.label) + "</div>" +
        '<div class="kpi-value">' + esc(c.value) + "</div>" +
        '<div class="kpi-meta">' + esc(c.meta) + "</div></div>";
    }).join("");
  }

  // ---- departmental readiness ----------------------------------------------
  function readiness(department) {
    var rows = requests.filter(function (r) { return r.fsi_requesttype === department.value; });
    if (!rows.length) {
      return { state: "idle", label: "Not engaged", tone: "mute", rows: rows,
               note: "No input requested from this team." };
    }
    var overdue = rows.filter(function (r) { return daysLate(r) > 0; });
    if (overdue.length) {
      return { state: "bad", label: "Overdue", tone: "bad", rows: rows,
               note: overdue.length + " of " + rows.length + " past due" };
    }
    var open = rows.filter(isOpen);
    if (!open.length) {
      return { state: "ok", label: "Input received", tone: "ok", rows: rows,
               note: rows.length + (rows.length === 1 ? " response" : " responses") + " received" };
    }
    return { state: "warn", label: "Awaiting input", tone: "warn", rows: rows,
             note: open.length + " of " + rows.length + " still open" };
  }

  function renderDepartments() {
    document.getElementById("deptGrid").innerHTML = DEPARTMENTS.map(function (d) {
      var r = readiness(d);
      var action = r.state === "idle"
        ? '<button class="btn ghost tiny-btn" data-request="' + d.value + '" type="button">Request input</button>'
        : '<div class="dept-meta">' + esc(r.note) + "</div>";
      return '<div class="dept ' + r.state + '">' +
        '<div class="dept-name">' + esc(d.name) + "</div>" +
        pill(r.label, r.tone) +
        action + "</div>";
    }).join("");

    Array.prototype.forEach.call(document.querySelectorAll("[data-request]"), function (btn) {
      btn.addEventListener("click", function () {
        openRequestDialog(Number(btn.getAttribute("data-request")));
      });
    });
  }

  // ---- ask lists ------------------------------------------------------------
  function askHtml(row, showVetting) {
    var late = daysLate(row);
    var summary = row.fsi_aisummary
      ? '<div class="ask-note">' + esc(row.fsi_aisummary.slice(0, 190)) +
        (row.fsi_aisummary.length > 190 ? "…" : "") + "</div>"
      : "";
    var vet = "";
    if (showVetting) {
      var v = vettingOf(row);
      vet = '<div class="vet" style="margin-top:7px;">' + VET_LANES.map(function (lane) {
        var state = VET_STATES.filter(function (s) { return s.value === (v[lane.key] || ""); })[0] || VET_STATES[0];
        return '<span class="vet-item"><span class="vet-dot ' + state.tone + '"></span>' +
          esc(lane.label) + "</span>";
      }).join("") + "</div>";
    }
    var department = departmentOf(row);
    var owner = ownerOf(row);
    /* Requests routed to a team of the same name would otherwise print it twice. */
    var who = owner && owner !== department ? "<span>" + esc(owner) + "</span>" : "";

    return '<div class="ask" data-id="' + esc(row.fsi_informationrequestid) + '">' +
      '<div class="ask-main">' +
      '<div class="ask-title">' + esc(row.fsi_name) + "</div>" +
      '<div class="ask-meta">' +
      "<span>" + esc(department) + "</span>" + who +
      "<span" + (late ? ' style="color:var(--cp-danger);font-weight:650;"' : "") + ">" +
      esc(dueText(row)) + "</span></div>" +
      summary + vet + "</div>" +
      "<div>" + statusPill(row.fsi_status) + "</div></div>";
  }

  function bindAsks(container) {
    Array.prototype.forEach.call(container.querySelectorAll(".ask"), function (el) {
      el.addEventListener("click", function () {
        var row = requests.filter(function (r) {
          return r.fsi_informationrequestid === el.getAttribute("data-id");
        })[0];
        if (row) openDrawer(row);
      });
    });
  }

  function renderAsks() {
    var open = requests.filter(isOpen).sort(function (a, b) {
      return daysLate(b) - daysLate(a) ||
        new Date(a.fsi_duedate || "2099-01-01") - new Date(b.fsi_duedate || "2099-01-01");
    });
    var done = requests.filter(function (r) { return !isOpen(r); }).sort(function (a, b) {
      return new Date(b.fsi_submittedon || 0) - new Date(a.fsi_submittedon || 0);
    });

    var openBody = document.getElementById("openBody");
    openBody.innerHTML = open.length
      ? open.map(function (r) { return askHtml(r, false); }).join("")
      : '<div class="empty">Every request on this plan has been answered.</div>';
    bindAsks(openBody);

    var overdue = open.filter(function (r) { return daysLate(r) > 0; }).length;
    document.getElementById("openSub").textContent = open.length
      ? open.length + " awaiting response" + (overdue ? " · " + overdue + " overdue" : "")
      : "Nothing outstanding";

    var doneBody = document.getElementById("doneBody");
    doneBody.innerHTML = done.length
      ? done.map(function (r) { return askHtml(r, true); }).join("")
      : '<div class="empty">No responses have been submitted yet.</div>';
    bindAsks(doneBody);
  }

  // ---- drawer ---------------------------------------------------------------
  function formatAnswer(field, value) {
    if (Array.isArray(value)) return value.join(", ");
    if (typeof value === "boolean") return value ? "Yes" : "No";

    var type = String(field.type || "").toLowerCase();
    if (type === "currency") {
      var money = APCtx.num(typeof value === "number" ? value : parseFloat(value));
      if (money !== null) return APCtx.compact(money, "AED");
    }
    if (type === "number") {
      var n = APCtx.num(typeof value === "number" ? value : parseFloat(value));
      if (n !== null) return n.toLocaleString("en-GB");
    }
    if (type === "date") {
      var d = APCtx.dateText(value);
      if (d !== "–") return d;
    }
    return String(value);
  }

  function answerRows(row) {
    var payload = parseResponse(row);
    var form = null;
    try { form = row.fsi_generatedformjson ? JSON.parse(row.fsi_generatedformjson) : null; } catch (e) { }
    if (!form || !form.sections) return "";

    var html = "";
    form.sections.forEach(function (section) {
      (section.fields || []).forEach(function (field) {
        var value = payload[field.id];
        if (value === undefined || value === null || value === "") return;
        html += '<div class="stat-row"><span>' + esc(field.label) + "</span><span>" +
          esc(formatAnswer(field, value).slice(0, 120)) + "</span></div>";
      });
    });
    return html ? '<div class="stat-list">' + html + "</div>" : "";
  }

  function vettingControls(row) {
    var current = vettingOf(row);
    return '<div class="vet">' + VET_LANES.map(function (lane) {
      var value = current[lane.key] || "";
      return '<label class="vet-item" style="gap:7px;">' + esc(lane.label) +
        '<select class="vet-sel" data-lane="' + lane.key + '">' +
        VET_STATES.map(function (s) {
          return '<option value="' + s.value + '"' + (s.value === value ? " selected" : "") + ">" +
            esc(s.label) + "</option>";
        }).join("") + "</select></label>";
    }).join("") + "</div>" +
      '<div class="tiny muted" id="vetNote" style="margin-top:6px;">' +
      "Internal sign-off before this input is relied on in committee." + "</div>";
  }

  function openDrawer(row) {
    var department = departmentOf(row);
    var owner = ownerOf(row);
    document.getElementById("drawerTitle").textContent = row.fsi_name;
    document.getElementById("drawerSub").textContent =
      [department, owner !== department ? owner : null, dueText(row)]
        .filter(Boolean).join(" · ");

    var html = "<h4>Status</h4><p>" + statusPill(row.fsi_status) +
      (row.fsi_submittedon ? " <span class=\"tiny muted\">Submitted " +
        esc(APCtx.dateText(row.fsi_submittedon)) + "</span>" : "") + "</p>";

    if (row.fsi_requestdescription) {
      html += "<h4>What we asked for</h4><p>" + esc(cleanText(row.fsi_requestdescription)) + "</p>";
    }
    if (row.fsi_aisummary) {
      html += "<h4>Summary of the response</h4><p>" + esc(row.fsi_aisummary) + "</p>";
    }

    var answers = answerRows(row);
    if (answers) html += "<h4>Response detail</h4>" + answers;

    if (!isOpen(row)) html += "<h4>Internal vetting</h4>" + vettingControls(row);

    html += '<h4>Actions</h4><p><button class="btn" id="btnOpenRec" type="button">' +
      (isOpen(row) ? "Open request" : "Open full response") + "</button></p>";

    document.getElementById("drawerBody").innerHTML = html;
    document.getElementById("drawer").hidden = false;
    document.getElementById("scrim").hidden = false;

    var openBtn = document.getElementById("btnOpenRec");
    if (openBtn) openBtn.addEventListener("click", function () { openRequest(row); });

    Array.prototype.forEach.call(document.querySelectorAll(".vet-sel"), function (sel) {
      sel.addEventListener("change", function () {
        var note = document.getElementById("vetNote");
        if (note) note.textContent = "Saving…";
        saveVetting(row, sel.getAttribute("data-lane"), sel.value).then(function () {
          if (note) note.textContent = "Vetting saved to the request record.";
          renderAsks();
        }).catch(function (error) {
          console.warn("[CoverageCollab] vetting save failed:", error.message);
          if (note) note.textContent = "Could not save — you may not have write access.";
        });
      });
    });
  }

  function closeDrawer() {
    document.getElementById("drawer").hidden = true;
    document.getElementById("scrim").hidden = true;
  }

  // ---- roster ---------------------------------------------------------------
  function renderRoster() {
    var body = document.getElementById("rosterBody");
    if (!roster.length) {
      body.innerHTML = '<div class="empty">No coverage team members are recorded for this account.</div>';
      document.getElementById("rosterSub").textContent = "";
      return;
    }
    var leads = roster.filter(function (r) { return r.fsi_is_lead; }).length;
    document.getElementById("rosterSub").textContent =
      roster.length + " named" + (leads ? " · " + leads + " lead" : "");

    body.innerHTML = roster.sort(function (a, b) {
      return (b.fsi_is_lead ? 1 : 0) - (a.fsi_is_lead ? 1 : 0);
    }).map(function (m) {
      var contact = m.fsi_email
        ? '<a href="mailto:' + esc(m.fsi_email) + '">' + esc(m.fsi_email) + "</a>"
        : (m.fsi_phone ? '<span class="tiny muted">' + esc(m.fsi_phone) + "</span>" : "");
      return '<div class="person">' +
        '<div class="avatar">' + esc(APCtx.initials(m.fsi_name)) + "</div>" +
        '<div class="person-main">' +
        '<div class="person-name">' + esc(m.fsi_name) +
        (m.fsi_is_lead ? " " + pill("Lead", "info") : "") + "</div>" +
        '<div class="person-role">' + esc(m.fsi_role_title || "Coverage team") + "</div>" +
        contact + "</div></div>";
    }).join("");
  }

  // ---- strategic objective --------------------------------------------------
  /* RAROC is derived from the same stored components, using the same formula as the
   * Relationship Economics tab, so the two tabs can never quote different numbers. */
  function rarocSummary() {
    if (!economics.length) return null;
    var periods = {};
    economics.forEach(function (row) {
      var key = row.fsi_period || "";
      (periods[key] = periods[key] || []).push(row);
    });
    var latestKey = Object.keys(periods).sort().pop();
    var rows = periods[latestKey] || [];

    var net = 0, capital = 0, hurdle = null;
    rows.forEach(function (row) {
      var revenue = APCtx.num(row.fsi_netinterestincome) + APCtx.num(row.fsi_feeincome) +
        APCtx.num(row.fsi_fxtreasuryincome) + APCtx.num(row.fsi_tradeincome);
      net += revenue - APCtx.num(row.fsi_costoffunds) - APCtx.num(row.fsi_costtoserve) -
        APCtx.num(row.fsi_expectedcreditloss);
      capital += APCtx.num(row.fsi_capitalconsumed);
      if (hurdle === null) hurdle = APCtx.num(row.fsi_hurdlerate);
    });

    return {
      period: latestKey,
      raroc: capital ? net / capital * 100 : null,
      hurdle: hurdle
    };
  }

  function renderObjective() {
    var text = plan && (plan.fsi_currentcustomerstrategy || plan.fsi_groupstrategy);
    var strategy = plan && plan["fsi_strategy@OData.Community.Display.V1.FormattedValue"];

    var html = "";
    if (strategy) html += "<p>" + pill("Strategy: " + strategy, "info") + "</p>";
    html += '<p style="font-size:12.5px;line-height:1.6;">' +
      (text ? esc(text) : '<span class="muted">No strategy statement has been captured on this plan.</span>') +
      "</p>";

    var summary = rarocSummary();
    if (summary && summary.raroc !== null) {
      var rows = '<div class="stat-row"><span>Current RAROC' +
        (summary.period ? " (" + esc(summary.period) + ")" : "") +
        "</span><span>" + APCtx.pct(summary.raroc) + "</span></div>";
      if (summary.hurdle !== null) {
        rows += '<div class="stat-row"><span>Hurdle rate</span><span>' +
          APCtx.pct(summary.hurdle) + "</span></div>" +
          '<div class="stat-row"><span>Versus hurdle</span><span style="color:' +
          (summary.raroc >= summary.hurdle ? "var(--cp-success)" : "var(--cp-danger)") + ';">' +
          (summary.raroc >= summary.hurdle ? "+" : "") +
          (summary.raroc - summary.hurdle).toFixed(1) + " pts</span></div>";
      }
      html += '<div class="stat-list" style="margin-top:10px;">' + rows + "</div>" +
        '<div class="tiny muted" style="margin-top:7px;">' +
        "Derived from the same stored components as Relationship Economics, so both tabs always agree.</div>";
    }
    document.getElementById("objectiveBody").innerHTML = html;
  }

  // ---- load -----------------------------------------------------------------
  function load() {
    return APCtx.resolve().then(function (resolved) {
      scope = resolved;
      if (!scope.planId) {
        show("Open this tab from an Account Plan record to see coverage collaboration.");
        return null;
      }

      var requestQuery = "$select=fsi_name,fsi_requestdescription,fsi_requesttype,fsi_status," +
        "fsi_duedate,fsi_submittedon,fsi_aisummary,fsi_responsejson,fsi_generatedformjson," +
        "fsi_requestingteam,createdon,_fsi_requestedfromuser_value,_fsi_requestedfromteam_value" +
        "&$filter=_fsi_accountplan_value eq " + scope.planId +
        "&$orderby=createdon desc";

      return Promise.all([
        APCtx.query(scope, "fsi_informationrequests", requestQuery),
        scope.accountId
          ? APCtx.query(scope, "fsi_coverageteammembers",
            "$select=fsi_name,fsi_role_title,fsi_email,fsi_phone,fsi_is_lead" +
            "&$filter=_fsi_account_value eq " + scope.accountId)
          : Promise.resolve([]),
        APCtx.record(scope, "fsi_accountplannings", scope.planId,
          "$select=fsi_title,fsi_strategy,fsi_currentcustomerstrategy,fsi_groupstrategy"),
        scope.accountId
          ? APCtx.query(scope, "fsi_relationshipeconomicses",
            "$select=fsi_period,fsi_netinterestincome,fsi_feeincome,fsi_fxtreasuryincome," +
            "fsi_tradeincome,fsi_costoffunds,fsi_costtoserve,fsi_expectedcreditloss," +
            "fsi_capitalconsumed,fsi_hurdlerate&$filter=_fsi_account_value eq " + scope.accountId)
          : Promise.resolve([])
      ]).then(function (results) {
        requests = results[0] || [];
        roster = results[1] || [];
        plan = results[2];
        economics = results[3] || [];

        renderKpis();
        renderDepartments();
        renderAsks();
        renderRoster();
        renderObjective();
        show(null);
      });
    }).catch(function (error) {
      console.error("[CoverageCollab]", error);
      show(error && error.message ? error.message : "Unable to load coverage collaboration.");
    });
  }

  document.getElementById("drawerClose").addEventListener("click", closeDrawer);
  document.getElementById("scrim").addEventListener("click", closeDrawer);
  document.getElementById("btnNew").addEventListener("click", function () { openRequestDialog(null); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeDrawer(); });

  load();
}());

</script>
</body>
</html>
